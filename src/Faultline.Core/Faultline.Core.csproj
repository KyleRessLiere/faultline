<Project Sdk="Microsoft.NET.Sdk">

  <!-- Brief §1: netstandard2.1 is Unity's ceiling. Do not raise this TFM. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Fights are authored as text and compiled into the DLL, so Core carries its own content and
       still does no file IO. Reading them back is Assembly.GetManifestResourceStream, not disk. -->
  <ItemGroup>
    <EmbeddedResource Include="Fights\Data\*.fight" />
  </ItemGroup>

</Project>

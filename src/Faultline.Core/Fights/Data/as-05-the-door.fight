# Asymmetry 5 — lopsided numbers. One unit each, eight Husks.
# Both players deploy inside the same walled room; that is the point, and it is a lint.
# The doorway is high ground: anything shoved off it takes fall damage on the way out.
#   .  open        #  wall        O  pit        ^  spikes      H  high ground
#   A  Player A deploy slot       B  Player B deploy slot
#   any other letter = an enemy declared by a 'spawn' line below

id: as-05-the-door
number: 405
name: The Door
description: Two units, eight Husks, one raised doorway flanked by spikes. Numbers stop mattering the moment only one of them can reach you.

spawn h = Husk

roster a: Vanguard
roster b: Threadcaster

# The tide, not the headcount: hold the doorway to the end of round 8 and you have won,
# so killing the last Husk stops being the point. Arrivals land on the two north corners
# the starting Husks came from — 0,0 and 6,0 — which are the far side of the room from
# the door.
objective: survive 8

wave 3 = h@0,0 h@6,0
wave 6 = h@0,0 h@6,0

board:
  hh...hh
  .h...h.
  .......
  .......
  ..h.h..
  ##^H^##
  AA...BB

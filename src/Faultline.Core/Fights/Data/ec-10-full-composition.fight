# Enemy composition 10 — one of each, arranged so every one of them covers another's weakness.
# Terrain and placement share one grid, so the board is what it looks like.
#   .  open        #  wall        O  pit        ^  spikes      H  high ground
#   A  Player A deploy slot       B  Player B deploy slot
#   any other letter = an enemy declared by a 'spawn' line below

id: ec-10-full-composition
number: 310
name: Full Composition
description: Anchor in the gate, Lobber behind it, Husks on the flanks, a Grappler west and a Stalker east. Every archetype in the game, each one covering the next one's weakness.

spawn h = Husk
spawn l = Lobber
spawn n = Anchor
spawn g = Grappler
spawn s = Stalker

roster a: Vanguard, Archer
roster b: Threadcaster, Wardbearer

board:
  ..h.l.hBB
  .O.#n#.OB
  .........
  gH.....Hs
  .........
  A..^.^...
  AA.......

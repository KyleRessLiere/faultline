# Terrain and placement share one grid, so the board is what it looks like.
#   .  open        #  wall        O  pit        ^  spikes      H  high ground
#   A  Player A deploy slot       B  Player B deploy slot
#   any other letter = an enemy declared by a 'spawn' line below

id: the-maw
number: 7
name: The Maw
pool: Hard
description: A pit the size of a room takes the whole centre, so every displacement anywhere near the rim is potentially lethal.
design: The hole. Authored as the fifth of the original five boards; it is a trial now, and the-shrine holds campaign slot 5.

spawn h = Husk
spawn l = Lobber
spawn g = Grappler
spawn s = Stalker

roster a: Vanguard, Archer
roster b: Threadcaster, Wardbearer

board:
  h.....B
  ..g..BB
  ..OOO..
  ..OOO..
  ..^.^..
  A..s...
  AA.h.l.

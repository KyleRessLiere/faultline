# Combat Manoeuvre 6 — the nook.
# No pits, no spikes. Four wall tiles make a two-deep slot with one mouth.
#   .  open        #  wall        O  pit        ^  spikes      H  high ground
#   A  Player A deploy slot       B  Player B deploy slot
#   any other letter = an enemy declared by a 'spawn' line below

id: cb-06-bait-and-break
number: 506
name: Bait and Break
description: Six Husks all walk at whoever is nearest. Put something tough in the slot and they queue up in a single file you can break one shove at a time.

spawn h = Husk

roster a: Vanguard, Archer
roster b: Wardbearer, Threadcaster

board:
  .h...h.BB
  .......BB
  .h.....h.
  .........
  .....h...
  AA.#.#...
  AA.#.#..h

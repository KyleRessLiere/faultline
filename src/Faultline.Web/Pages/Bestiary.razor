@page "/bestiary"
@layout MainLayout

<PageTitle>Faultline — bestiary</PageTitle>

<div class="bestiary">
    <header class="bestiary-head">
        <div>
            <h1>Faultline <span class="sub">bestiary</span></h1>
            <p class="note">
                Every unit in the game: stat block, and for each enemy the ordered priority list its
                planner actually runs. All of it is read out of Core — <code>UnitTemplate</code>,
                <code>EnemyBehaviour</code>, <code>AbilityDescriptor</code> — so this page cannot
                describe behaviour the rules do not have.
            </p>
        </div>

        <div class="head-tools">
            <a class="action secondary link-button" href="battles">← Battles</a>
            <a class="action secondary link-button" href="play">Board</a>
        </div>
    </header>

    <nav class="jump">
        <span class="jump-label">Jump to</span>
        @foreach (var kind in EnemyBehaviour.EnemyKinds)
        {
            <a class="jump-link enemy" href="bestiary#unit-@kind">@UnitTemplate.For(kind).Name</a>
        }
        @foreach (var ability in AbilityDescriptor.All())
        {
            <a class="jump-link player" href="bestiary#unit-@ability.Kind">@UnitTemplate.For(ability.Kind).Name</a>
        }
    </nav>

    <section class="group">
        <h2>Enemies</h2>
        <p class="note">
            Enemy decisions are a pure function of the board — there is no randomness anywhere in the
            planner. Every tie breaks on a fixed ladder, so the same board always produces the same
            plan, and every enemy declares its whole round before you commit to yours.
        </p>

        <div class="beast-grid">
            @foreach (var behaviour in EnemyBehaviour.All())
            {
                var template = behaviour.Template;

                <article class="beast enemy" id="unit-@behaviour.Kind">
                    <header>
                        <span class="beast-art team-e"><UnitArt Kind="behaviour.Kind" Label="@behaviour.Name" /></span>
                        <span class="beast-title">
                            <span class="beast-name">@behaviour.Name</span>
                            <span class="beast-role">@behaviour.Role</span>
                        </span>
                    </header>

                    <p class="beast-summary">@behaviour.Summary</p>

                    @Stats(template)

                    <div class="block">
                        <h3>Priority list</h3>
                        <ol class="priority">
                            @foreach (var step in behaviour.Priorities)
                            {
                                <li>
                                    <span class="step-label">@step.Label</span>
                                    <span class="step-detail">@step.Detail</span>
                                </li>
                            }
                        </ol>
                    </div>

                    <div class="block">
                        <h3>Quirks</h3>
                        <ul class="quirks">
                            @foreach (var quirk in behaviour.Quirks)
                            {
                                <li>@quirk</li>
                            }
                        </ul>
                    </div>

                    <div class="block counter">
                        <h3>Counterplay</h3>
                        <ul class="quirks">
                            @foreach (var line in behaviour.Counterplay)
                            {
                                <li>@line</li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="group">
        <h2>Player classes</h2>
        <p class="note">
            Move 3 for every class, and every class starts on zero Footing — a token is granted by the
            scenario, never by the archetype.
        </p>

        <div class="beast-grid players">
            @foreach (var ability in AbilityDescriptor.All())
            {
                var template = UnitTemplate.For(ability.Kind);

                <article class="beast player" id="unit-@ability.Kind">
                    <header>
                        <span class="beast-art team-a"><UnitArt Kind="ability.Kind" Label="@template.Name" /></span>
                        <span class="beast-title">
                            <span class="beast-name">@template.Name</span>
                            <span class="beast-role">@EnemyBehaviour.RoleFor(ability.Kind)</span>
                        </span>
                    </header>

                    @Stats(template)

                    <div class="block">
                        <h3>Ability</h3>
                        <p class="ability-head">
                            @ability.Name
                            <span class="tag effect">@ability.Effect</span>
                            @if (ability.Targeting == AbilityTargeting.Passive)
                            {
                                <span class="tag passive">passive</span>
                            }
                        </p>
                        <p class="ability-text">@ability.Summary</p>
                        @if (ability.Targeting == AbilityTargeting.Passive)
                        {
                            <p class="ability-note">
                                Always on. There is nothing to aim and it never costs an action.
                            </p>
                        }
                    </div>
                </article>
            }
        </div>
    </section>
</div>

@code {
    private RenderFragment Stats(UnitTemplate template) => __builder =>
    {
        <ul class="stats">
            <li><span>HP</span>@template.MaxHp</li>
            <li><span>Move</span>@template.Move MP</li>
            <li><span>Footing</span>@template.Footing</li>
            <li><span>Reach</span>@(template.BasicReach == 0 ? "—" : template.BasicReach.ToString())</li>
            <li class="wide"><span>Basic action</span>@EnemyBehaviour.Describe(template)</li>
            @if (template.FreeClimb)
            {
                <li class="wide"><span>Climb</span>free — HighGround costs no extra movement</li>
            }
        </ul>
    };
}

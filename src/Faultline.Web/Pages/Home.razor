@page "/play"
@layout MainLayout
@inject GameSession Session
@inject FightFiles Files
@inject PlaytestNotes Notes
@implements IDisposable

<PageTitle>Faultline</PageTitle>

<div class="shell">
    <div class="board-pane">
        <h1>Faultline <span class="sub">M3 — enemy AI</span></h1>

        <div class="status">
            <a class="chip link" href="battles">← Battles</a>
            <a class="chip link" href="notes" title="Every playtest note, across every battle">
                Notes @NoteCountLabel
            </a>
            <span class="chip fight-chip" title="@Session.Fight.Id">
                #@Session.Fight.Number @Session.Fight.Name
            </span>
            <span class="chip">@PhaseLabel</span>
            <span class="chip">Round @State.Round</span>
            <span class="chip team-@TeamClass(State.ActiveTeam)">@ActiveLabel</span>
            <span class="chip">Momentum @State.Momentum / 6</span>
            <span class="chip">Seed @Session.Seed</span>
        </div>

        <div class="grid"
             style="grid-template-columns: repeat(@State.Board.Width, var(--cell));"
             @onmouseleave="() => Session.Hover(null)">
            @foreach (var coord in State.Board.AllCoords())
            {
                var cell = coord;
                var unit = State.UnitAt(cell);
                <button type="button"
                        class="@CellClass(cell, unit)"
                        disabled="@(!IsClickable(cell, unit))"
                        title="@Tooltip(cell, unit)"
                        @onmouseover="() => Session.Hover(cell)"
                        @onfocus="() => Session.Hover(cell)"
                        @onclick="() => OnCellClick(cell, unit)">
                    @if (unit is not null)
                    {
                        <span class="art team-@TeamClass(unit.Team)">
                            <UnitArt Kind="unit.Kind" Label="@unit.Name" />
                        </span>
                        <span class="hp">@unit.Hp/@unit.MaxHp</span>
                        @if (unit.Clinging || unit.Staggered || unit.Footing == 0)
                        {
                            <span class="pips">
                                @if (unit.Clinging)
                                {
                                    <i class="pip cling" title="Clinging"></i>
                                }
                                @if (unit.Staggered)
                                {
                                    <i class="pip stagger" title="Staggered — next shove goes 1 further"></i>
                                }
                                @if (unit.Footing == 0)
                                {
                                    <i class="pip nofooting" title="No Footing left"></i>
                                }
                            </span>
                        }
                    }
                    else if (IsDeployTarget(cell))
                    {
                        <span class="marker">+</span>
                    }
                    else if (Session.Targets.ContainsKey(cell))
                    {
                        <span class="marker">•</span>
                    }
                </button>
            }
        </div>

        <div class="legend">
            <span><i class="sw open"></i>open</span>
            <span><i class="sw wall"></i>wall</span>
            <span><i class="sw pit"></i>pit</span>
            <span><i class="sw spikes"></i>spikes</span>
            <span><i class="sw high"></i>high ground</span>
        </div>
    </div>

    <div class="side-pane">
        <div class="panel">
            <h2>Turn</h2>

            @if (State.Outcome != FightOutcome.InProgress)
            {
                <p class="outcome @(State.Outcome == FightOutcome.Won ? "won" : "lost")">
                    @(State.Outcome == FightOutcome.Won ? "Fight won." : "Fight lost.")
                </p>
            }
            else if (State.Phase == Phase.Deployment)
            {
                <p>
                    <strong>@ActiveLabel</strong> places <strong>@PendingDeployName</strong>.
                    Click a highlighted tile in your corner.
                </p>
            }
            else if (Session.AwaitingEnemy)
            {
                <p>Enemy activating…</p>
                <p class="note">Resolving the declared intent from Core's priority-list planner.</p>
            }
            else if (Selected is not null)
            {
                <p class="unit-head">
                    <span class="art inline team-@TeamClass(Selected.Team)">
                        <UnitArt Kind="Selected.Kind" Label="@Selected.Name" />
                    </span>
                    <strong>@Selected.Name</strong> [@EventText.Side(Selected.Team)] —
                    @Selected.Hp/@Selected.MaxHp HP, Move @Selected.Move, Footing @Selected.Footing
                </p>

                <ul class="halves">
                    <li class="@(Selected.HasMoved ? "spent" : string.Empty)">Move</li>
                    <li class="@(Selected.HasActed ? "spent" : string.Empty)">Action</li>
                </ul>

                <div class="actions">
                    @foreach (var option in ActionOptions())
                    {
                        <button type="button"
                                class="mode @(Session.Mode == option.Mode ? "on" : string.Empty)"
                                disabled="@(!option.Available)"
                                @onclick="() => Session.SetMode(option.Mode)">
                            <span class="mode-name">@option.Name</span>
                            <span class="mode-effect">@option.Effect</span>
                        </button>
                    }
                </div>

                @if (Session.Mode == ActionMode.Ability && Session.SelectedAbility is not null)
                {
                    <p class="rules">@Session.SelectedAbility.Summary</p>
                }

                <p class="preview @(Session.PreviewText is null ? "idle" : string.Empty)">
                    @(Session.PreviewText ?? "Hover a highlighted tile to see what it does.")
                </p>

                @if (Session.EndCommand is not null)
                {
                    <button class="action" @onclick="EndActivation">End activation</button>
                }
            }
            else
            {
                <p>Select one of @ActiveLabel's units to activate.</p>
            }

            <button class="action secondary" @onclick="Restart">New run</button>
            <a class="action secondary link-button" href="battles">Choose battle</a>
        </div>

        @if (State.Intents.Count > 0)
        {
            <div class="panel">
                <h2>Enemy intents</h2>
                <ul class="intents">
                    @foreach (var intent in State.Intents)
                    {
                        <li>
                            <span class="art inline team-e">
                                <UnitArt Kind="intent.Kind" Label="@intent.Kind.ToString()" />
                            </span>
                            <strong>@State.UnitById(intent.UnitId).Name</strong>
                            <span class="tag">@EventText.Intent(State, intent)</span>
                        </li>
                    }
                </ul>
                <p class="note">Locked for the round. An enemy only re-plans if its target dies.</p>
            </div>
        }

        <div class="panel">
            <h2>Units</h2>
            <table class="units">
                <tbody>
                    @foreach (var unit in State.Units)
                    {
                        <tr class="@UnitRowClass(unit)">
                            <td class="team-@TeamClass(unit.Team)">@EventText.Side(unit.Team)</td>
                            <td>@unit.Name</td>
                            <td>@UnitHpText(unit)</td>
                            <td>@(unit.IsOnBoard ? unit.Position.ToString() : unit.IsAlive ? "—" : string.Empty)</td>
                            <td class="flags">@UnitFlags(unit)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel">
            <h2>Abilities</h2>
            <dl class="ability-list">
                @foreach (var descriptor in AbilityDescriptor.All())
                {
                    <dt>
                        <span class="art inline">
                            <UnitArt Kind="descriptor.Kind" Label="@descriptor.Name" />
                        </span>
                        @descriptor.Name
                        <span class="tag">@descriptor.Kind</span>
                        <span class="tag effect">@descriptor.Effect</span>
                    </dt>
                    <dd>@descriptor.Summary</dd>
                }
            </dl>
        </div>

        <div class="panel log-panel">
            <h2>Log</h2>

            <div class="log-tools">
                <label class="record-toggle" title="Records every event, tab-separated, for analysis after the fight. Off by default because it costs memory that grows with the fight.">
                    <input type="checkbox" checked="@Session.Recording" @onchange="ToggleRecording" />
                    Record combat log
                </label>

                @if (Session.Recording)
                {
                    <span class="log-count">@Session.RecordedLineCount lines</span>
                }
            </div>

            @if (Session.Recording)
            {
                <div class="log-actions">
                    <button type="button"
                            class="log-button"
                            disabled="@(!_canSaveToDirectory || Session.RecordedLineCount == 0)"
                            title="@(_canSaveToDirectory ? "Write the .log into a folder you pick." : "This browser has no File System Access API. Use Download.")"
                            @onclick="SaveLogToFolder">
                        Save to folder
                    </button>
                    <button type="button"
                            class="log-button"
                            disabled="@(Session.RecordedLineCount == 0)"
                            @onclick="DownloadLog">
                        Download
                    </button>
                    <button type="button"
                            class="log-button"
                            disabled="@(Session.RecordedLineCount == 0)"
                            @onclick="CopyLog">
                        Copy
                    </button>
                </div>

                @if (!Session.RecordingIsComplete)
                {
                    <p class="note">
                        Recording started mid-fight — the event log is from here on and the command
                        log will not replay from the seed. Start a new run to record the whole fight.
                    </p>
                }

                @if (_logStatus is not null)
                {
                    <p class="status-line">@_logStatus</p>
                }
            }

            <ol class="log">
                @foreach (var line in RecentLog())
                {
                    <li>@line</li>
                }
            </ol>
        </div>

        <div class="panel notes-panel">
            <h2>Playtest notes</h2>

            @* No <form> anywhere here: a form would make Enter submit, and a stray Enter on the
               board screen must never do anything. The keystroke handlers below stop the events
               travelling further for the same reason. *@
            <textarea class="note-box"
                      rows="3"
                      placeholder="What just happened? Ctrl+Enter adds it."
                      value="@_noteText"
                      @oninput="OnNoteInput"
                      @onkeydown="OnNoteKeyDown"
                      @onkeydown:stopPropagation="true"
                      @onkeypress:stopPropagation="true"
                      @onkeyup:stopPropagation="true"></textarea>

            <div class="note-tags">
                @foreach (var tag in PlaytestNotes.KnownTags)
                {
                    var name = tag;
                    <button type="button"
                            class="tag-toggle @(_noteTags.Contains(name) ? "on" : string.Empty)"
                            @onclick="() => ToggleTag(name)">@name</button>
                }
            </div>

            <div class="log-actions">
                <button type="button"
                        class="log-button"
                        disabled="@(_noteText.Trim().Length == 0)"
                        @onclick="AddNote">
                    Add note
                </button>
                <a class="log-button link-button" href="notes">Review all @NoteCountLabel</a>
            </div>

            <p class="note">
                Captured with the note: @Session.Fight.Name (@Session.Fight.Id), seed @Session.Seed,
                round @State.Round, @PhaseLabel, @ActiveLabel active@(Session.Recording
                    ? $", log line {Session.RecordedLineCount}"
                    : string.Empty).
            </p>

            <p class="note">
                Notes live in this browser's localStorage. Clearing site data deletes them and nothing
                is stored on a server — <a href="notes">export them</a> to keep them.
            </p>

            @if (_noteStatus is not null)
            {
                <p class="status-line">@_noteStatus</p>
            }

            @if (!Notes.Loaded)
            {
                <p class="note">Reading browser storage…</p>
            }
            else if (NotesForThisFight.Count == 0)
            {
                <p class="note">No notes on this battle yet.</p>
            }
            else
            {
                <ol class="note-list">
                    @foreach (var note in NotesForThisFight)
                    {
                        var id = note.Id;
                        <li>
                            <div class="note-head">
                                <span class="note-context">@PlaytestNotes.Context(note)</span>
                                @foreach (var tag in note.Tags)
                                {
                                    <span class="tag tag-@tag">@tag</span>
                                }
                                <button type="button"
                                        class="note-delete"
                                        title="Delete this note"
                                        @onclick="() => DeleteNote(id)">×</button>
                            </div>
                            <p class="note-text">@note.Text</p>
                        </li>
                    }
                </ol>
            }
        </div>
    </div>
</div>

@code {
    private bool _resolvingEnemy;
    private bool _disposed;

    // The board screen asks once whether this browser can write into a folder, so the button is
    // never offered when it could only fail. docs/COMBAT_LOG.md: the UI has to be honest about which
    // of the three ways out is which.
    private bool _canSaveToDirectory;
    private bool _askedAboutDirectories;
    private string? _logStatus;

    // The note being typed, and the tags ticked for it. Both live on the page rather than in the
    // store: nothing is written until the playtester says so.
    private string _noteText = string.Empty;
    private readonly List<string> _noteTags = new();
    private string? _noteStatus;

    private GameState State => Session.State;

    private IReadOnlyList<PlaytestNote> NotesForThisFight => Notes.For(Session.Fight.Id);

    private string NoteCountLabel => Notes.All.Count == 0
        ? string.Empty
        : "(" + Notes.All.Count.ToString(System.Globalization.CultureInfo.InvariantCulture) + ")";

    private Unit? Selected => Session.SelectedUnit;

    private sealed record ActionOption(ActionMode Mode, string Name, string Effect, bool Available);

    private string PhaseLabel => State.Phase switch
    {
        Phase.Deployment => "Deployment",
        Phase.Battle => "Battle",
        _ => "Complete",
    };

    private string ActiveLabel => State.ActiveTeam switch
    {
        Team.PlayerA => "Player A",
        Team.PlayerB => "Player B",
        _ => "Enemy",
    };

    private string PendingDeployName =>
        Session.PendingDeployUnit is null
            ? "—"
            : State.UnitById(Session.PendingDeployUnit.Value).Name;

    private IEnumerable<ActionOption> ActionOptions()
    {
        var unit = Selected;
        if (unit is null)
        {
            yield break;
        }

        yield return new ActionOption(
            ActionMode.Move, "Move", $"up to {unit.Move} MP", Session.IsAvailable(ActionMode.Move));

        var template = unit.Template;
        if (template.Attack != AttackKind.None)
        {
            string reach = template.Attack == AttackKind.Melee ? "melee" : $"range {template.Range}";
            string effect = $"{reach} · {template.Damage} dmg";
            if (template.AttackPush > 0)
            {
                effect += $" · push {template.AttackPush}";
            }

            yield return new ActionOption(
                ActionMode.Attack, "Attack", effect, Session.IsAvailable(ActionMode.Attack));
        }

        if (template.CanPullWithBasic)
        {
            yield return new ActionOption(
                ActionMode.Pull,
                "Pull",
                $"range {template.Range} · pull {template.BasicPull}",
                Session.IsAvailable(ActionMode.Pull));
        }

        var ability = Session.SelectedAbility;
        if (ability is not null && ability.Targeting != AbilityTargeting.Passive)
        {
            yield return new ActionOption(
                ActionMode.Ability, ability.Name, ability.Effect, Session.IsAvailable(ActionMode.Ability));
        }
        else if (ability is not null)
        {
            yield return new ActionOption(ActionMode.Ability, ability.Name, ability.Effect, false);
        }

        if (Session.IsAvailable(ActionMode.Rescue))
        {
            yield return new ActionOption(ActionMode.Rescue, "Rescue", "whole activation", true);
        }

        if (Session.IsAvailable(ActionMode.Finish))
        {
            yield return new ActionOption(ActionMode.Finish, "Finish", "free action", true);
        }
    }

    protected override async Task OnInitializedAsync() => await Notes.LoadAsync();

    private void OnNoteInput(ChangeEventArgs args)
    {
        _noteText = args.Value?.ToString() ?? string.Empty;
        _noteStatus = null;
    }

    private async Task OnNoteKeyDown(KeyboardEventArgs args)
    {
        // Ctrl+Enter files the note; a bare Enter keeps writing, because a playtester mid-thought
        // types in paragraphs.
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            await AddNote();
        }
    }

    private void ToggleTag(string tag)
    {
        if (!_noteTags.Remove(tag))
        {
            _noteTags.Add(tag);
        }
    }

    private async Task AddNote()
    {
        var note = await Notes.AddAsync(Session, _noteText, _noteTags);
        if (note is null)
        {
            return;
        }

        _noteText = string.Empty;
        _noteTags.Clear();
        _noteStatus = $"Saved with round {note.Round} of {note.FightName}.";
    }

    private async Task DeleteNote(string id)
    {
        await Notes.DeleteAsync(id);
        _noteStatus = null;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_askedAboutDirectories)
        {
            _askedAboutDirectories = true;
            _ = DetectDirectorySupportAsync();
        }

        // Enemy slots resolve on a short delay so the hotseat players can watch them tick past.
        if (!_resolvingEnemy && Session.AwaitingEnemy)
        {
            _resolvingEnemy = true;
            _ = ResolveEnemyAsync();
        }
    }

    private async Task DetectDirectorySupportAsync()
    {
        bool supported = await Files.CanSaveToDirectoryAsync();

        if (!_disposed && supported != _canSaveToDirectory)
        {
            _canSaveToDirectory = supported;
            StateHasChanged();
        }
    }

    private void ToggleRecording(ChangeEventArgs args)
    {
        Session.SetRecording(args.Value is bool on && on);
        _logStatus = null;
    }

    private async Task SaveLogToFolder()
    {
        var outcome = await Files.SaveToDirectoryAsync(
            Session.LogFileName, Session.RenderCombatLog(), ".log", "Faultline combat log");

        // A cancelled picker is a normal outcome, not a failure: say nothing and change nothing.
        _logStatus = outcome switch
        {
            "cancelled" => null,
            "unsupported" => "This browser cannot open a save dialog. Use Download instead.",
            _ when outcome.StartsWith("saved:", StringComparison.Ordinal) =>
                $"Saved {outcome.Substring(6)} — {Session.RecordedLineCount} event lines.",
            _ => "Save failed: " + outcome,
        };
    }

    private async Task DownloadLog()
    {
        var outcome = await Files.DownloadAsync(Session.LogFileName, Session.RenderCombatLog());

        _logStatus = outcome.StartsWith("downloaded:", StringComparison.Ordinal)
            ? $"Downloaded {outcome.Substring(11)} — {Session.RecordedLineCount} event lines."
            : "Download failed: " + outcome;
    }

    private async Task CopyLog()
    {
        var outcome = await Files.CopyAsync(Session.RenderCombatLog());

        _logStatus = outcome == "copied"
            ? $"Copied {Session.RecordedLineCount} event lines to the clipboard."
            : "Copy failed: " + outcome;
    }

    private async Task ResolveEnemyAsync()
    {
        await Task.Delay(400);

        if (!_disposed && Session.AwaitingEnemy)
        {
            Session.ResolveEnemyActivation();
        }

        _resolvingEnemy = false;

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private void OnCellClick(Coord coord, Unit? unit)
    {
        if (IsDeployTarget(coord))
        {
            Session.Submit(Session.DeployTargets[coord]);
            return;
        }

        if (Session.Targets.TryGetValue(coord, out var command))
        {
            Session.Submit(command);
            return;
        }

        if (unit is not null && Session.Selectable.Contains(unit.Id))
        {
            Session.Select(unit.Id);
        }
    }

    private void EndActivation()
    {
        if (Session.EndCommand is not null)
        {
            Session.Submit(Session.EndCommand);
        }
    }

    private void Restart() => Session.NewRun(Session.Seed + 1);

    private bool IsDeployTarget(Coord coord) => Session.DeployTargets.ContainsKey(coord);

    private bool IsClickable(Coord coord, Unit? unit) =>
        IsDeployTarget(coord)
        || Session.Targets.ContainsKey(coord)
        || (unit is not null && Session.Selectable.Contains(unit.Id));

    private string CellClass(Coord coord, Unit? unit)
    {
        var classes = new List<string> { "cell", EventText.TileClass(State.Board.At(coord)) };

        if (Session.RangeTiles.Contains(coord))
        {
            classes.Add("in-range");
        }

        if (Session.ProjectedPath.Contains(coord))
        {
            classes.Add("projected");
        }

        bool targetable = Session.Targets.ContainsKey(coord);

        if (unit is not null)
        {
            classes.Add("occupied");
            classes.Add("team-" + TeamClass(unit.Team));

            if (unit.Clinging)
            {
                classes.Add("clinging");
            }

            if (Session.Selected == unit.Id)
            {
                classes.Add("selected");
            }

            if (targetable)
            {
                classes.Add("targetable");
            }
        }
        else if (IsDeployTarget(coord))
        {
            classes.Add("deploy");
        }
        else if (targetable)
        {
            classes.Add("movable");
        }

        return string.Join(" ", classes);
    }

    private static string TeamClass(Team team) => team switch
    {
        Team.PlayerA => "a",
        Team.PlayerB => "b",
        _ => "e",
    };

    private static string UnitRowClass(Unit unit)
    {
        var classes = new List<string>();
        if (!unit.IsAlive)
        {
            classes.Add("down");
        }

        if (unit.Clinging)
        {
            classes.Add("cling-row");
        }

        return string.Join(" ", classes);
    }

    private static string UnitHpText(Unit unit)
    {
        if (unit.Voided)
        {
            return "voided";
        }

        return unit.IsAlive ? $"{unit.Hp}/{unit.MaxHp}" : "down";
    }

    private static string UnitFlags(Unit unit)
    {
        var flags = new List<string>();
        if (unit.Clinging)
        {
            flags.Add("clinging");
        }

        if (unit.Staggered)
        {
            flags.Add("staggered");
        }

        if (unit.HasActivated && unit.IsOnBoard)
        {
            flags.Add("done");
        }

        return string.Join(", ", flags);
    }

    private IEnumerable<string> RecentLog()
    {
        var log = Session.Log;
        int take = log.Count < 60 ? log.Count : 60;
        for (int i = log.Count - 1; i >= log.Count - take; i--)
        {
            yield return log[i];
        }
    }

    private string Tooltip(Coord coord, Unit? unit)
    {
        var terrain = State.Board.At(coord).ToString();

        if (unit is not null)
        {
            string extra = unit.Clinging ? ", clinging" : unit.Staggered ? ", staggered" : string.Empty;
            return $"{unit.Name} [{EventText.Side(unit.Team)}] {unit.Hp}/{unit.MaxHp}{extra} — {terrain} {coord}";
        }

        return $"{terrain} {coord}";
    }

    public void Dispose() => _disposed = true;
}

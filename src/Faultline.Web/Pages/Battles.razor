@page "/battles"
@layout MainLayout
@inject GameSession Session
@inject CustomFightStore Store
@inject LoadoutStore Loadouts
@inject RunSession Runs
@inject NavigationManager Nav

<PageTitle>PLUCK — battles</PageTitle>

<div class="picker">
    <header class="picker-head">
        <div>
            <h1>PLUCK <span class="sub">choose a battle</span></h1>
            <p class="note">
                Currently loaded: <strong>@Session.Fight.Name</strong> (@Session.Fight.Id), seed @Session.Seed.
            </p>
        </div>

        <div class="picker-tools">
            <label class="seed">
                Seed
                <input type="number" value="@_seed" @onchange="OnSeedChanged" />
            </label>
            <a class="action secondary" href="play">Back to board</a>
            <a class="action secondary" href="acts">Build an act</a>
            <a class="action secondary" href="bestiary">Bestiary</a>
            <a class="action" href="create">Create a scenario</a>
        </div>
    </header>

    <section class="run-banner">
        <div>
            <strong>The campaign</strong> — the ten fights of CURATED_SET §1 in order, with two rests
            among them. There is no healing between fights, and anything voided along the way is gone
            for good.
            @if (Runs.State is { } run && Runs.InProgress)
            {
                <span class="run-progress">
                    In progress: node @(run.NodeIndex + 1) / @run.Campaign.Length, @run.FightsWon fights
                    won, seed @run.Seed.
                </span>
            }
        </div>
        <a class="action" href="@(Runs.InProgress ? RunScreens.RouteFor(Runs) : RunScreens.Home)">@(Runs.InProgress ? "Continue the run" : "Start a run")</a>
    </section>

    @* Search and act filters. Both narrow every section at once rather than only one, because
       "which boards are in this act" and "where is that board" are the same question asked from two
       ends and answering them in different places would mean looking twice. *@
    <div class="picker-filters">
        <input type="search" class="board-search" placeholder="Search boards — name, id or description"
               value="@_search" @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />

        <select class="act-pick" @onchange="e => _act = e.Value?.ToString() ?? string.Empty">
            @foreach (var act in Acts)
            {
                <option value="@act.Key" selected="@(_act == act.Key)">@act.Label</option>
            }
        </select>

        @if (_search.Length > 0 || _act.Length > 0)
        {
            <button type="button" class="action secondary" @onclick="ClearFilters">Clear</button>
            <span class="filter-count">@Showing() of @Total() boards</span>
        }
    </div>

    @if (ActNote() is { Length: > 0 } actNote)
    {
        <p class="section-note act-note">@actNote</p>
    }

    @foreach (var section in Sections())
    {
        var shown = Filter(section.Fights);

        @* Collapsible, and the count is on the summary so a shut section still answers "how many".
           Bands start shut: the band cut is the same library a second time. *@
        <details class="section" open="@(section.OpenByDefault && shown.Count > 0)">
            <summary>
                <span class="section-heading">@section.Heading</span>
                <span class="section-count">@shown.Count</span>
            </summary>

            <p class="section-note">@section.Blurb</p>

            @if (shown.Count == 0)
            {
                <p class="note empty">
                    @(section.Fights.Count == 0 ? "Nothing here yet." : "Nothing here matches the filters.")
                </p>
            }
            else
            {
                <div class="fight-grid">
                    @foreach (var result in shown)
                    {
                        @RenderFight(result, null)
                    }
                </div>
            }
        </details>
    }

    @* EVENTS. Every one the game ships, with its prices, and the whole pool of boards tagged for
       event use. Both listed in full rather than sampled, because the point is to see all of them.

       Read the note on the pool before wondering why nothing draws from it. *@
    <h2>Events — every one, and what each costs</h2>
    <p class="section-note">
        @EventLibrary.All().Count event(s) ship today. An event is a run node, not a board: it is
        entered from the map and its price is paid by a duck you name.
    </p>

    <div class="fight-grid">
        @foreach (var scene in EventLibrary.All())
        {
            <article class="fight-card event-card">
                <header>
                    <span class="fight-name">@scene.Name</span>
                    <span class="tag">@scene.Id</span>
                    <span class="tag">@(scene.Shape == EventShape.Offer ? "offer — walkable" : "strait — every exit priced")</span>
                </header>

                <div class="card-body">
                    <div class="meta">
                        <p class="desc">@scene.Prompt</p>
                        <p class="facts">
                            <span>Costs @scene.HpCost HP</span>
                            <span>Gains +@scene.MaxHpGain max</span>
                        </p>
                        @if (scene.WalkAwayLine.Length > 0)
                        {
                            <p class="facts"><span>Walking away: @scene.WalkAwayLine</span></p>
                        }

                        @* The loadout meets the event here. An Offer is paid by ONE duck out of its
                           own hit points, so which ducks could afford it is the thing a build
                           changes — and a duck that cannot pay is the case worth setting up. *@
                        @if (DevBuild.ShowDevTools)
                        {
                            <p class="facts event-afford">
                                <span>
                                    With the stock squad: @Affordable(scene) of 4 ducks could pay,
                                    and the rest are blocked at lethal.
                                </span>
                            </p>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    <h2>The event fight pool — @EventFightPool.All().Count board(s) tagged</h2>
    <p class="section-note">
        Which boards an event may field, and why each was judged fit. <strong>Nothing draws from this
        yet</strong> — Core says so in as many words: the two events that will (§8.6's Nesting Thief
        and Duckling Lost) need systems v1 does not have. The pairings are tagged now so the content
        question is already answered when they land.
    </p>

    <div class="fight-grid">
        @foreach (var entry in EventFightPool.All())
        {
            var board = FightLibrary.ById(entry.FightId);

            <article class="fight-card pool-card">
                <header>
                    <span class="fight-name">@(board?.Name ?? entry.FightId)</span>
                    <span class="tag">@entry.FightId</span>
                    <span class="tag slot">@entry.Fitness</span>
                </header>

                <div class="card-body">
                    @if (board is not null)
                    {
                        <BoardThumb Fight="board" Cell="16" />
                    }

                    <div class="meta">
                        <p class="desc">@entry.Note</p>
                        @if (board is not null)
                        {
                            <p class="facts">
                                <span>@board.Board.Width×@board.Board.Height</span>
                                <span>Enemies: @Composition(board)</span>
                            </p>
                        }
                        else
                        {
                            <p class="desc">This board is tagged for the pool but is not in the library.</p>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    @if (Retired.Count > 0)
    {
        <details class="retired-note">
            <summary>
                @Retired.Count retired board(s), out of the picker (CURATED_SET §4) — reasons below
            </summary>
            <p class="note">
                Retired is not deleted: the files are still embedded and still parse. Core decides which
                these are, through the <code>retired:</code> key; the picker only shows what
                <code>FightLibrary.All()</code> hands back.
            </p>
            <ul>
                @foreach (var fight in Retired)
                {
                    <li><span class="tag">@fight.Id</span> @fight.RetiredReason</li>
                }
            </ul>
        </details>
    }

    @if (Unreadable.Count > 0)
    {
        <h2>Unreadable files</h2>
        <p class="section-note">
            These <code>.fight</code> files failed to parse, so they cannot be played. They are listed
            rather than hidden, because a file that vanishes silently is worse than one that shouts.
        </p>
        <div class="fight-grid">
            @foreach (var result in Unreadable)
            {
                @RenderFight(result, null)
            }
        </div>
    }

    <h2>Your scenarios</h2>
    @if (!Store.Loaded)
    {
        <p class="note">Reading browser storage…</p>
    }
    else if (Store.Items.Count == 0)
    {
        <p class="note">
            None yet. Anything you save in the creator is kept in this browser's localStorage and shows
            up here immediately — no rebuild needed.
        </p>
    }
    else
    {
        <div class="fight-grid">
            @foreach (var custom in Store.Items)
            {
                @RenderFight(custom.Result, custom.Id)
            }
        </div>
    }

    @* One editor for the page, pointed at whichever board's bench is open. A modal per card would
       be sixty-six modals in the DOM. *@
    <LoadoutEditor Fight="_benchFight" Bench="_benchLoadout" Open="_benchFight is not null"
                   OnClose="CloseBench" />
</div>

@code {
    private int _seed = GameSession.DefaultSeed;

    /// <summary>Free-text filter over a board's name, id and description.</summary>
    private string _search = string.Empty;

    /// <summary>Which act's boards to show, or empty for the whole library.</summary>
    private string _act = string.Empty;

    /// <summary>The board whose bench is open, or null while none is.</summary>
    private FightDefinition? _benchFight;

    private TestLoadout? _benchLoadout;

    private void OpenBench(string id)
    {
        _benchFight = FightLibrary.ById(id) ?? GameSession.Library
            .Select(r => r.Fight)
            .FirstOrDefault(f => f is not null && f.Id == id);
        _benchLoadout = _benchFight is null ? null : Bench(_benchFight.Id);
    }

    private void CloseBench()
    {
        _benchFight = null;
        _benchLoadout = null;
    }

    /// <summary>One heading's worth of the picker.</summary>
    /// <param name="Heading">What the section is called.</param>
    /// <param name="Blurb">One line on what belongs in it.</param>
    /// <param name="Fights">Its boards, already ordered.</param>
    /// <param name="OpenByDefault">
    /// Whether it starts expanded. The curated groups do; the band cut does not, because it is the
    /// same library a second time and a page that shows every board twice at full height is a page
    /// nobody scrolls.
    /// </param>
    private sealed record Section(
        string Heading,
        string Blurb,
        IReadOnlyList<FightParseResult> Fights,
        bool OpenByDefault = true);

    private readonly List<Section> _sections = new();
    private readonly List<FightParseResult> _unreadable = new();
    private IReadOnlyList<FightDefinition> _retired = Array.Empty<FightDefinition>();

    private IReadOnlyList<Section> Sections() => _sections;

    // ---- Filters ---------------------------------------------------------------------------------

    private sealed record ActFilter(string Key, string Label);

    /// <summary>
    /// The acts a board can belong to.
    /// </summary>
    /// <remarks>
    /// <b>Membership is asked of the act, never stored here.</b> Act 1's is its authored map's own
    /// fight list; Warrens v2's is every board carrying a band the generator draws — so a board
    /// authored tomorrow with a <c>pool:</c> mark appears under v2 the same day, and a board removed
    /// from the authored map disappears from Act 1's without anything here being edited.
    /// </remarks>
    private static readonly ActFilter[] Acts =
    {
        new ActFilter(string.Empty, "Every board"),
        new ActFilter("act1", "Act 1 — The Warrens, as authored"),
        new ActFilter("v2", "Warrens v2 — everything it can field"),
        new ActFilter("unused", "In no act — nothing draws these"),
    };

    /// <summary>The bands a generated act draws from. Anything else is not act content.</summary>
    private static readonly FightPool[] DrawnBands =
    {
        FightPool.Opener, FightPool.Ordinary, FightPool.Hard,
        FightPool.Elite, FightPool.Endurance, FightPool.Boss,
    };

    private void ClearFilters()
    {
        _search = string.Empty;
        _act = string.Empty;
    }

    /// <summary>Narrows a section's boards by the search text and the act filter.</summary>
    private IReadOnlyList<FightParseResult> Filter(IReadOnlyList<FightParseResult> fights) =>
        fights.Where(r => r.Fight is { } f && Matches(f) && InAct(f)).ToList();

    /// <summary>Substring over the three things a person actually remembers a board by.</summary>
    private bool Matches(FightDefinition fight)
    {
        if (_search.Length == 0)
        {
            return true;
        }

        var needle = _search.Trim();

        return fight.Name.Contains(needle, StringComparison.OrdinalIgnoreCase)
            || fight.Id.Contains(needle, StringComparison.OrdinalIgnoreCase)
            || fight.Description.Contains(needle, StringComparison.OrdinalIgnoreCase)
            || fight.Pool.ToString().Contains(needle, StringComparison.OrdinalIgnoreCase);
    }

    private bool InAct(FightDefinition fight) => _act switch
    {
        "act1" => ActMapLibrary.Act1.FightIds().Contains(fight.Id, StringComparer.Ordinal),
        "v2" => DrawnBands.Contains(fight.Pool),
        "unused" => !ActMapLibrary.Act1.FightIds().Contains(fight.Id, StringComparer.Ordinal)
            && !DrawnBands.Contains(fight.Pool),
        _ => true,
    };

    /// <summary>How many distinct boards survive the filters, across every section.</summary>
    private int Showing() =>
        GameSession.Library
            .Where(r => r.Fight is { } f && !f.IsRetired && Matches(f) && InAct(f))
            .Select(r => r.Fight!.Id)
            .Distinct(StringComparer.Ordinal)
            .Count();

    private static int Total() => FightLibrary.All().Count;

    /// <summary>What the chosen act is, in one line, when one is chosen.</summary>
    private string ActNote() => _act switch
    {
        "act1" => "The " + ActMapLibrary.Act1.FightIds().Count
            + " boards the authored Warrens fields, read off its own map — not a list kept here.",
        "v2" => "Every board carrying a band a generated act draws from. This is the pool Warrens v2 "
            + "chooses from, not one act's worth: a single act fields about 25 of them.",
        "unused" => "Active, authored, and drawn by nothing — no act fields them and no band claims "
            + "them. If this is not empty, something is content nobody can reach.",
        _ => string.Empty,
    };

    private IReadOnlyList<FightParseResult> Unreadable => _unreadable;

    private IReadOnlyList<FightDefinition> Retired => _retired;

    protected override async Task OnInitializedAsync()
    {
        await Runs.LoadAsync();
        Group();
        await Store.LoadAsync();

        // The picker offers saved builds on every card, so it needs them read before it draws.
        await Loadouts.LoadAsync();
    }

    /// <summary>
    /// Sorts the library into the curated set's sections. The campaign section's membership and
    /// order come from <see cref="CampaignLibrary.Faultline"/> through <see cref="CuratedSet"/>, so
    /// there is one spine in the codebase; whether a battle is active at all comes from Core —
    /// <c>FightLibrary.All()</c> is the only thing that decides, so a <c>retired:</c> key drops a
    /// board out of here without the shell knowing its name.
    /// </summary>
    private void Group()
    {
        var active = CuratedSet.Active();

        var campaign = new List<FightParseResult>();
        var trials = new List<FightParseResult>();
        var gauntlet = new List<FightParseResult>();
        var other = new List<FightParseResult>();

        _unreadable.Clear();
        _retired = FightLibrary.Retired();

        foreach (var result in GameSession.Library)
        {
            var fight = result.Fight;

            if (fight is null)
            {
                _unreadable.Add(result);
                continue;
            }

            if (!active.ContainsKey(fight.Id))
            {
                continue;
            }

            switch (CuratedSet.GroupOf(fight.Id))
            {
                case FightGroup.Campaign: campaign.Add(result); break;
                case FightGroup.Trials: trials.Add(result); break;
                case FightGroup.Gauntlet: gauntlet.Add(result); break;
                default: other.Add(result); break;
            }
        }

        // The campaign is the one group with a real order, and it is the spine's order, not the
        // library's — cb-06 is authoring number 506 and campaign slot 2.
        campaign.Sort((a, b) => CuratedSet.SlotOf(a.Fight!.Id).CompareTo(CuratedSet.SlotOf(b.Fight!.Id)));
        ByNumber(trials);
        ByNumber(gauntlet);
        ByNumber(other);

        _sections.Clear();
        _sections.Add(new Section(
            "Campaign — the ordered ten",
            "Fixed order, each fight building on the last. Playable one-off from here; the run itself lives on the campaign screen.",
            campaign));
        _sections.Add(new Section(
            "Trials — one question each",
            "A pick-any menu of self-contained boards. No assumed order, nothing carried between them.",
            trials));
        _sections.Add(new Section(
            "Co-op gauntlet — the partnership",
            "Four boards about the two players rather than the terrain.",
            gauntlet));
        _sections.Add(new Section(
            "Other battles",
            "Authored and active, but outside the curated groups — variant proofs, annexes and boards waiting on a re-judge.",
            other));

        AddBandSections();
    }

    /// <summary>
    /// The same library cut a second way: by the <c>pool:</c> band each board declares.
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>These are the boards a Warrens v2 act can field</b>, which is the thing you want in front of
    /// you when you are testing one. The curated sections above are the authored groups (CURATED_SET);
    /// this is what the generator sees, and a board appears in both because it IS in both — the cut is
    /// different, not the library.
    /// </para>
    /// <para>
    /// Read off <see cref="FightDefinition.Pool"/> rather than off a list here, so a board authored
    /// tomorrow with a mark lands in its band the same day.
    /// </para>
    /// </remarks>
    private void AddBandSections()
    {
        var bands = new (FightPool Pool, string Heading, string Blurb)[]
        {
            (FightPool.Opener, "Opener", "Column 1, and the gentlest of an act's early third. A control group: nothing here can hurt you before you have had a turn."),
            (FightPool.Ordinary, "Ordinary", "The bulk of an act — its early and middle columns. The band Warrens v2 draws most heavily from."),
            (FightPool.Hard, "Hard", "The late third: the fights a squad arrives at already spent."),
            (FightPool.Elite, "Elite", "A gilt node's fight. Costs more, and the map says so before you take it."),
            (FightPool.Endurance, "Endurance", "Objective-shaped rather than harder — survive, hold. One per generated act, in the late third."),
            (FightPool.Boss, "Boss", "Terminals."),
        };

        foreach (var (pool, heading, blurb) in bands)
        {
            var inBand = GameSession.Library
                .Where(r => r.Fight is { } f && f.Pool == pool && !f.IsRetired)
                .ToList();

            ByNumber(inBand);

            _sections.Add(new Section(
                "Warrens v2 · " + heading,
                blurb,
                inBand,
                OpenByDefault: false));
        }
    }

    private static void ByNumber(List<FightParseResult> results) =>
        results.Sort((a, b) => a.Fight!.Number != b.Fight!.Number
            ? a.Fight!.Number.CompareTo(b.Fight!.Number)
            : string.CompareOrdinal(a.Fight!.Id, b.Fight!.Id));

    private RenderFragment RenderFight(FightParseResult result, string? customId) => __builder =>
    {
        var fight = result.Fight;

        // This board's own bench. Never shared across cards: a loadout is positional, so one bench
        // would apply a Vanguard's hit points to whatever another board happens to roster first.
        var bench = fight is null ? new TestLoadout() : Bench(fight.Id);

        <article class="fight-card @(result.Ok ? string.Empty : "broken")">
            <header>
                <span class="num">@(fight is null ? "—" : "#" + fight.Number)</span>
                <span class="fight-name">@(fight?.Name ?? customId ?? "Unreadable fight")</span>
                @if (fight is not null)
                {
                    <span class="tag">@fight.Id</span>
                    @if (CuratedSet.SlotOf(fight.Id) >= 0)
                    {
                        <span class="tag slot">campaign @(CuratedSet.SlotOf(fight.Id) + 1) of @CuratedSet.SpineLength</span>
                    }
                }
                @if (customId is not null)
                {
                    <span class="tag custom">custom</span>
                }
            </header>

            <div class="card-body">
                @if (fight is not null)
                {
                    <BoardThumb Fight="fight" Cell="18" />
                }

                <div class="meta">
                    @if (fight is not null)
                    {
                        <p class="desc">@(string.IsNullOrWhiteSpace(fight.Description) ? "No description." : fight.Description)</p>
                        <p class="facts">
                            <span>@fight.Board.Width×@fight.Board.Height</span>
                            <span>Enemies: @Composition(fight)</span>
                        </p>
                        <p class="facts">
                            <span class="team-a">A: @Roster(fight.RosterA)</span>
                            <span class="team-b">B: @Roster(fight.RosterB)</span>
                        </p>
                    }
                    else
                    {
                        <p class="desc">This file has parse errors, so it cannot be played.</p>
                    }

                    @if (result.Errors.Count > 0)
                    {
                        <ul class="issues errors">
                            @foreach (var issue in result.Errors)
                            {
                                <li><span class="code">@issue.Code</span> @issue.Message</li>
                            }
                        </ul>
                    }

                    @if (result.Lints.Count > 0)
                    {
                        <details class="issues lints">
                            <summary>@result.Lints.Count deliberate deviation(s) — playable, not errors</summary>
                            <ul>
                                @foreach (var issue in result.Lints)
                                {
                                    <li><span class="code">@issue.Code</span> @issue.Message</li>
                                }
                            </ul>
                        </details>
                    }
                    else if (result.Ok)
                    {
                        <p class="issues clean">No lints — matches the brief's layout guidelines.</p>
                    }
                </div>
            </div>

            @if (customId is null && fight is not null)
            {
                <p class="shipped-note">
                    Compiled into the app, so nothing running in the browser can change it. Edit opens it
                    in the creator as a <em>new</em> scenario; the original stays as shipped.
                </p>
            }

            @* The bench opens in its own view: one duck at a time, with every card that duck's
               class can actually hold. Internal builds only, gated on the same flag the dev panel
               is, so there is no arrangement of switches that ships an arbitrary-loadout editor
               with the game (§7.5). *@
            @if (DevBuild.ShowDevTools && fight is not null)
            {
                <div class="bench-bar">
                    @* Pick a saved build and play it, without opening the editor at all. The editor
                       is for BUILDING one; this is for USING one, and needing four clicks and a
                       modal to reach a build you already made was the friction worth removing. *@
                    <label class="bench-pick">
                        Loadout
                        <select @onchange="e => PickLoadout(fight, e)">
                            <option value="" selected="@(Chosen(fight.Id) is null)">
                                @(bench.IsCustom ? "— edited on this board —" : "— the board's own —")
                            </option>
                            @foreach (var saved in Loadouts.Items)
                            {
                                var fits = saved.Preset.MatchingSlots(fight);

                                <option value="@saved.Id"
                                        selected="@(Chosen(fight.Id) == saved.Id)"
                                        disabled="@(fits == 0)">
                                    @(saved.Preset.Name.Length > 0 ? saved.Preset.Name : saved.Id)
                                    @(fits == 0 ? " — fits nothing here" : $" — {fits} duck(s)")
                                </option>
                            }
                        </select>
                    </label>

                    <button type="button" class="action secondary bench-open"
                            @onclick="() => OpenBench(fight.Id)">
                        Edit loadout
                        @if (bench.IsCustom)
                        {
                            <span class="tag custom">edited</span>
                        }
                    </button>
                </div>
            }

            <footer>
                <button class="action" disabled="@(fight is null)" @onclick="() => Play(fight)">Play</button>

                @{
                    var lookupId = customId ?? fight?.Id;
                }
                @if (lookupId is not null)
                {
                    <a class="action secondary link-button"
                       href="@Editor(lookupId, customId, copy: false)"
                       title="@(customId is null
                           ? "Open this campaign battle in the creator as a new scenario"
                           : "Open this saved scenario in the creator")">Edit</a>
                }

                @if (lookupId is not null && fight is not null)
                {
                    <a class="action secondary link-button"
                       href="@Editor(lookupId, customId, copy: true)"
                       title="Start a new scenario from this board">Duplicate</a>
                }

                @if (customId is not null)
                {
                    <button class="action secondary" @onclick="() => Delete(customId)">Delete</button>
                }
            </footer>
        </article>
    };

    /// <summary>Link into the creator for one battle, wherever it lives.</summary>
    private static string Editor(string id, string? customId, bool copy)
    {
        var source = customId is null ? "campaign" : "browser";
        return $"create?edit={Uri.EscapeDataString(id)}&from={source}" + (copy ? "&copy=1" : string.Empty);
    }

    private static string Composition(FightDefinition fight)
    {
        if (fight.Enemies.Count == 0)
        {
            return "none";
        }

        var order = new List<UnitKind>();
        var counts = new Dictionary<UnitKind, int>();
        foreach (var spawn in fight.Enemies)
        {
            if (!counts.ContainsKey(spawn.Kind))
            {
                counts[spawn.Kind] = 0;
                order.Add(spawn.Kind);
            }

            counts[spawn.Kind]++;
        }

        return string.Join(", ", order.Select(kind => $"{counts[kind]}x {kind}"));
    }

    private static string Roster(IReadOnlyList<UnitKind> roster) =>
        roster.Count == 0 ? "—" : string.Join(", ", roster);

    private void OnSeedChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int seed))
        {
            _seed = seed;
        }
    }

    private void Play(FightDefinition? fight)
    {
        if (fight is null)
        {
            return;
        }

        // Null unless a tester actually changed something, so an untouched picker plays the board
        // exactly as it ships.
        Session.StartFight(fight, _seed, Bench(fight.Id).Build(fight));
        Nav.NavigateTo("play");
    }

    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        StateHasChanged();
    }

    // ---- The test bench --------------------------------------------------------------------------

    /// <summary>
    /// What each duck starts holding, <b>per board</b>. Shell-side and per-visit: a bench setup is
    /// scratch work, not something to persist and later wonder about.
    /// </summary>
    /// <remarks>
    /// Keyed by fight id rather than shared across the picker, because a loadout is positional —
    /// slot 0 of one board is a Vanguard and of another is a Fisher, so one shared bench would apply
    /// a Vanguard's hit points to whatever happened to be rostered first somewhere else. It also
    /// kept every card's "edited" tag lit as soon as any one of them was touched.
    /// </remarks>
    private readonly Dictionary<string, TestLoadout> _benches = new();

    /// <summary>Which saved build each board is set to, by fight id.</summary>
    /// <remarks>
    /// Tracked so the dropdown can show what is selected. It is not the source of truth — the BENCH
    /// is, because the editor may have been opened and tweaked afterwards. Picking a build applies
    /// it to the bench and Play reads the bench, so there is one path into a fight whichever way a
    /// build got there.
    /// </remarks>
    private readonly Dictionary<string, string> _chosen = new();

    private string? Chosen(string id) => _chosen.TryGetValue(id, out var pick) ? pick : null;

    /// <summary>
    /// Applies a saved build to a board, or puts the board back to its own when none is picked.
    /// </summary>
    private void PickLoadout(FightDefinition fight, ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        var bench = Bench(fight.Id);

        if (string.IsNullOrEmpty(id))
        {
            _chosen.Remove(fight.Id);
            bench.Reset();
            return;
        }

        var saved = Loadouts.Items.FirstOrDefault(i => i.Id == id);
        if (saved is null)
        {
            return;
        }

        _chosen[fight.Id] = id!;
        saved.Preset.ApplyTo(bench, fight);
    }

    /// <summary>
    /// How many of the four base-kit ducks could pay an Offer's hit-point cost.
    /// </summary>
    /// <remarks>
    /// An Offer is paid by ONE duck out of its own hit points and is blocked at lethal, so the
    /// interesting question a loadout asks of an event is which ducks can afford it. Counted off the
    /// stock class ceilings rather than a bench, because an event is a run node and has no board of
    /// its own for a bench to hang on — see the handoff for why testing one directly is not wired up.
    /// </remarks>
    private static int Affordable(EventDefinition scene)
    {
        var squad = new[] { UnitKind.Vanguard, UnitKind.Threadcaster, UnitKind.Wardbearer, UnitKind.Archer };
        int able = 0;

        foreach (var kind in squad)
        {
            if (UnitTemplate.For(kind).MaxHp > scene.HpCost)
            {
                able++;
            }
        }

        return able;
    }

    /// <summary>That board's bench, created on first ask.</summary>
    private TestLoadout Bench(string id)
    {
        if (!_benches.TryGetValue(id, out var bench))
        {
            bench = new TestLoadout();
            _benches[id] = bench;
        }

        return bench;
    }

}

@page "/battles"
@layout MainLayout
@inject GameSession Session
@inject CustomFightStore Store
@inject RunSession Runs
@inject NavigationManager Nav

<PageTitle>PLUCK — battles</PageTitle>

<div class="picker">
    <header class="picker-head">
        <div>
            <h1>PLUCK <span class="sub">choose a battle</span></h1>
            <p class="note">
                Currently loaded: <strong>@Session.Fight.Name</strong> (@Session.Fight.Id), seed @Session.Seed.
            </p>
        </div>

        <div class="picker-tools">
            <label class="seed">
                Seed
                <input type="number" value="@_seed" @onchange="OnSeedChanged" />
            </label>
            <a class="action secondary" href="play">Back to board</a>
            <a class="action secondary" href="bestiary">Bestiary</a>
            <a class="action" href="create">Create a scenario</a>
        </div>
    </header>

    <section class="run-banner">
        <div>
            <strong>The campaign</strong> — the ten fights of CURATED_SET §1 in order, with two rests
            among them. There is no healing between fights, and anything voided along the way is gone
            for good.
            @if (Runs.State is { } run && Runs.InProgress)
            {
                <span class="run-progress">
                    In progress: node @(run.NodeIndex + 1) / @run.Campaign.Length, @run.FightsWon fights
                    won, seed @run.Seed.
                </span>
            }
        </div>
        <a class="action" href="@(Runs.InProgress ? RunScreens.RouteFor(Runs) : RunScreens.Home)">@(Runs.InProgress ? "Continue the run" : "Start a run")</a>
    </section>

    @foreach (var section in Sections())
    {
        <h2>@section.Heading</h2>
        <p class="section-note">@section.Blurb</p>

        @if (section.Fights.Count == 0)
        {
            <p class="note empty">Nothing here yet.</p>
        }
        else
        {
            <div class="fight-grid">
                @foreach (var result in section.Fights)
                {
                    @RenderFight(result, null)
                }
            </div>
        }
    }

    @if (Retired.Count > 0)
    {
        <details class="retired-note">
            <summary>
                @Retired.Count retired board(s), out of the picker (CURATED_SET §4) — reasons below
            </summary>
            <p class="note">
                Retired is not deleted: the files are still embedded and still parse. Core decides which
                these are, through the <code>retired:</code> key; the picker only shows what
                <code>FightLibrary.All()</code> hands back.
            </p>
            <ul>
                @foreach (var fight in Retired)
                {
                    <li><span class="tag">@fight.Id</span> @fight.RetiredReason</li>
                }
            </ul>
        </details>
    }

    @if (Unreadable.Count > 0)
    {
        <h2>Unreadable files</h2>
        <p class="section-note">
            These <code>.fight</code> files failed to parse, so they cannot be played. They are listed
            rather than hidden, because a file that vanishes silently is worse than one that shouts.
        </p>
        <div class="fight-grid">
            @foreach (var result in Unreadable)
            {
                @RenderFight(result, null)
            }
        </div>
    }

    <h2>Your scenarios</h2>
    @if (!Store.Loaded)
    {
        <p class="note">Reading browser storage…</p>
    }
    else if (Store.Items.Count == 0)
    {
        <p class="note">
            None yet. Anything you save in the creator is kept in this browser's localStorage and shows
            up here immediately — no rebuild needed.
        </p>
    }
    else
    {
        <div class="fight-grid">
            @foreach (var custom in Store.Items)
            {
                @RenderFight(custom.Result, custom.Id)
            }
        </div>
    }
</div>

@code {
    private int _seed = GameSession.DefaultSeed;

    /// <summary>One heading's worth of the picker.</summary>
    private sealed record Section(string Heading, string Blurb, IReadOnlyList<FightParseResult> Fights);

    private readonly List<Section> _sections = new();
    private readonly List<FightParseResult> _unreadable = new();
    private IReadOnlyList<FightDefinition> _retired = Array.Empty<FightDefinition>();

    private IReadOnlyList<Section> Sections() => _sections;

    private IReadOnlyList<FightParseResult> Unreadable => _unreadable;

    private IReadOnlyList<FightDefinition> Retired => _retired;

    protected override async Task OnInitializedAsync()
    {
        await Runs.LoadAsync();
        Group();
        await Store.LoadAsync();
    }

    /// <summary>
    /// Sorts the library into the curated set's sections. The campaign section's membership and
    /// order come from <see cref="CampaignLibrary.Faultline"/> through <see cref="CuratedSet"/>, so
    /// there is one spine in the codebase; whether a battle is active at all comes from Core —
    /// <c>FightLibrary.All()</c> is the only thing that decides, so a <c>retired:</c> key drops a
    /// board out of here without the shell knowing its name.
    /// </summary>
    private void Group()
    {
        var active = CuratedSet.Active();

        var campaign = new List<FightParseResult>();
        var trials = new List<FightParseResult>();
        var gauntlet = new List<FightParseResult>();
        var other = new List<FightParseResult>();

        _unreadable.Clear();
        _retired = FightLibrary.Retired();

        foreach (var result in GameSession.Library)
        {
            var fight = result.Fight;

            if (fight is null)
            {
                _unreadable.Add(result);
                continue;
            }

            if (!active.ContainsKey(fight.Id))
            {
                continue;
            }

            switch (CuratedSet.GroupOf(fight.Id))
            {
                case FightGroup.Campaign: campaign.Add(result); break;
                case FightGroup.Trials: trials.Add(result); break;
                case FightGroup.Gauntlet: gauntlet.Add(result); break;
                default: other.Add(result); break;
            }
        }

        // The campaign is the one group with a real order, and it is the spine's order, not the
        // library's — cb-06 is authoring number 506 and campaign slot 2.
        campaign.Sort((a, b) => CuratedSet.SlotOf(a.Fight!.Id).CompareTo(CuratedSet.SlotOf(b.Fight!.Id)));
        ByNumber(trials);
        ByNumber(gauntlet);
        ByNumber(other);

        _sections.Clear();
        _sections.Add(new Section(
            "Campaign — the ordered ten",
            "Fixed order, each fight building on the last. Playable one-off from here; the run itself lives on the campaign screen.",
            campaign));
        _sections.Add(new Section(
            "Trials — one question each",
            "A pick-any menu of self-contained boards. No assumed order, nothing carried between them.",
            trials));
        _sections.Add(new Section(
            "Co-op gauntlet — the partnership",
            "Four boards about the two players rather than the terrain.",
            gauntlet));
        _sections.Add(new Section(
            "Other battles",
            "Authored and active, but outside the curated groups — variant proofs, annexes and boards waiting on a re-judge.",
            other));
    }

    private static void ByNumber(List<FightParseResult> results) =>
        results.Sort((a, b) => a.Fight!.Number != b.Fight!.Number
            ? a.Fight!.Number.CompareTo(b.Fight!.Number)
            : string.CompareOrdinal(a.Fight!.Id, b.Fight!.Id));

    private RenderFragment RenderFight(FightParseResult result, string? customId) => __builder =>
    {
        var fight = result.Fight;

        <article class="fight-card @(result.Ok ? string.Empty : "broken")">
            <header>
                <span class="num">@(fight is null ? "—" : "#" + fight.Number)</span>
                <span class="fight-name">@(fight?.Name ?? customId ?? "Unreadable fight")</span>
                @if (fight is not null)
                {
                    <span class="tag">@fight.Id</span>
                    @if (CuratedSet.SlotOf(fight.Id) >= 0)
                    {
                        <span class="tag slot">campaign @(CuratedSet.SlotOf(fight.Id) + 1) of @CuratedSet.SpineLength</span>
                    }
                }
                @if (customId is not null)
                {
                    <span class="tag custom">custom</span>
                }
            </header>

            <div class="card-body">
                @if (fight is not null)
                {
                    <BoardThumb Fight="fight" Cell="18" />
                }

                <div class="meta">
                    @if (fight is not null)
                    {
                        <p class="desc">@(string.IsNullOrWhiteSpace(fight.Description) ? "No description." : fight.Description)</p>
                        <p class="facts">
                            <span>@fight.Board.Width×@fight.Board.Height</span>
                            <span>Enemies: @Composition(fight)</span>
                        </p>
                        <p class="facts">
                            <span class="team-a">A: @Roster(fight.RosterA)</span>
                            <span class="team-b">B: @Roster(fight.RosterB)</span>
                        </p>
                    }
                    else
                    {
                        <p class="desc">This file has parse errors, so it cannot be played.</p>
                    }

                    @if (result.Errors.Count > 0)
                    {
                        <ul class="issues errors">
                            @foreach (var issue in result.Errors)
                            {
                                <li><span class="code">@issue.Code</span> @issue.Message</li>
                            }
                        </ul>
                    }

                    @if (result.Lints.Count > 0)
                    {
                        <details class="issues lints">
                            <summary>@result.Lints.Count deliberate deviation(s) — playable, not errors</summary>
                            <ul>
                                @foreach (var issue in result.Lints)
                                {
                                    <li><span class="code">@issue.Code</span> @issue.Message</li>
                                }
                            </ul>
                        </details>
                    }
                    else if (result.Ok)
                    {
                        <p class="issues clean">No lints — matches the brief's layout guidelines.</p>
                    }
                </div>
            </div>

            @if (customId is null && fight is not null)
            {
                <p class="shipped-note">
                    Compiled into the app, so nothing running in the browser can change it. Edit opens it
                    in the creator as a <em>new</em> scenario; the original stays as shipped.
                </p>
            }

            <footer>
                <button class="action" disabled="@(fight is null)" @onclick="() => Play(fight)">Play</button>

                @{
                    var lookupId = customId ?? fight?.Id;
                }
                @if (lookupId is not null)
                {
                    <a class="action secondary link-button"
                       href="@Editor(lookupId, customId, copy: false)"
                       title="@(customId is null
                           ? "Open this campaign battle in the creator as a new scenario"
                           : "Open this saved scenario in the creator")">Edit</a>
                }

                @if (lookupId is not null && fight is not null)
                {
                    <a class="action secondary link-button"
                       href="@Editor(lookupId, customId, copy: true)"
                       title="Start a new scenario from this board">Duplicate</a>
                }

                @if (customId is not null)
                {
                    <button class="action secondary" @onclick="() => Delete(customId)">Delete</button>
                }
            </footer>
        </article>
    };

    /// <summary>Link into the creator for one battle, wherever it lives.</summary>
    private static string Editor(string id, string? customId, bool copy)
    {
        var source = customId is null ? "campaign" : "browser";
        return $"create?edit={Uri.EscapeDataString(id)}&from={source}" + (copy ? "&copy=1" : string.Empty);
    }

    private static string Composition(FightDefinition fight)
    {
        if (fight.Enemies.Count == 0)
        {
            return "none";
        }

        var order = new List<UnitKind>();
        var counts = new Dictionary<UnitKind, int>();
        foreach (var spawn in fight.Enemies)
        {
            if (!counts.ContainsKey(spawn.Kind))
            {
                counts[spawn.Kind] = 0;
                order.Add(spawn.Kind);
            }

            counts[spawn.Kind]++;
        }

        return string.Join(", ", order.Select(kind => $"{counts[kind]}x {kind}"));
    }

    private static string Roster(IReadOnlyList<UnitKind> roster) =>
        roster.Count == 0 ? "—" : string.Join(", ", roster);

    private void OnSeedChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int seed))
        {
            _seed = seed;
        }
    }

    private void Play(FightDefinition? fight)
    {
        if (fight is null)
        {
            return;
        }

        Session.StartFight(fight, _seed);
        Nav.NavigateTo("play");
    }

    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        StateHasChanged();
    }
}

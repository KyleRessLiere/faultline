@page "/notes"
@layout MainLayout
@inject PlaytestNotes Store
@inject FightFiles Files
@implements IDisposable

<PageTitle>Faultline — playtest notes</PageTitle>

<div class="notes-page">
    <header class="notes-head">
        <div>
            <h1>Faultline <span class="sub">playtest notes</span></h1>
            <p class="note">
                @Plural(Store.All.Count, "note") in this browser, across @Plural(BattleCount, "battle").
                Notes are kept in this browser's localStorage — clearing site data deletes them, and
                nothing is stored on a server. Export is how a note outlives this browser.
            </p>
        </div>

        <div class="notes-tools">
            @if (Log.Active)
            {
                <span class="chip logging" title="@Log.Status">— logging to @Log.Folder</span>
                <button type="button" class="action secondary" @onclick="StopLogging">Stop logging</button>
            }
            else if (Log.Supported)
            {
                <button type="button" class="action" title="Pick a folder once. Every note lands in it as you write it."
                        @onclick="ChooseFolder">Log notes to a folder—</button>
            }
            <a class="action secondary link-button" href="play">Back to board</a>
            <a class="action secondary link-button" href="battles">Battles</a>
        </div>
    </header>

    @if (!Store.Loaded)
    {
        <p class="note">Reading browser storage…</p>
    }
    else if (Store.All.Count == 0)
    {
        <p class="note">
            No notes yet. Play a battle and use the <strong>Playtest notes</strong> panel beside the
            log; every note records the battle, seed, round, phase and active side for you.
        </p>
    }
    else
    {
        <div class="panel filters">
            <div class="filter-row">
                <label class="filter-label" for="battle-filter">Battle</label>
                <select id="battle-filter" value="@_battleFilter" @onchange="OnBattleChanged">
                    <option value="">All battles (@Store.All.Count)</option>
                    @foreach (var battle in Battles())
                    {
                        <option value="@battle.Id">
                            #@battle.Number @battle.Name — @battle.Count
                        </option>
                    }
                </select>
            </div>

            <div class="filter-row">
                <span class="filter-label">Tag</span>
                <div class="tag-filters">
                    <button type="button"
                            class="tag-toggle @(_tagFilter is null ? "on" : string.Empty)"
                            @onclick="() => SetTag(null)">any</button>
                    @foreach (var tag in PlaytestNotes.KnownTags)
                    {
                        var name = tag;
                        <button type="button"
                                class="tag-toggle tag-@name @(_tagFilter == name ? "on" : string.Empty)"
                                @onclick="() => SetTag(name)">
                            @name <span class="tag-count">@CountWithTag(name)</span>
                        </button>
                    }
                    <button type="button"
                            class="tag-toggle @(_tagFilter == UntaggedFilter ? "on" : string.Empty)"
                            @onclick="() => SetTag(UntaggedFilter)">
                        untagged <span class="tag-count">@CountUntagged()</span>
                    </button>
                </div>
            </div>

            <p class="showing">
                Showing <strong>@Filtered.Count</strong> of @Plural(Store.All.Count, "note").
                @if (Filtered.Count != Store.All.Count)
                {
                    <button type="button" class="linkish" @onclick="ClearFilters">Clear filters</button>
                }
            </p>
        </div>

        <div class="panel exports">
            <h2>Export</h2>

            <div class="filter-row">
                <span class="filter-label">Format</span>
                <div class="tag-filters">
                    <button type="button"
                            class="tag-toggle @(_json ? string.Empty : "on")"
                            @onclick="() => SetFormat(false)">Markdown</button>
                    <button type="button"
                            class="tag-toggle @(_json ? "on" : string.Empty)"
                            @onclick="() => SetFormat(true)">JSON</button>
                </div>
            </div>

            <div class="log-actions">
                <button type="button"
                        class="log-button"
                        disabled="@(!_canSaveToDirectory || Filtered.Count == 0)"
                        title="@(_canSaveToDirectory
                            ? "Write the file into a folder you pick."
                            : "This browser has no File System Access API. Use Download.")"
                        @onclick="SaveToFolder">
                    Save to folder
                </button>
                <button type="button"
                        class="log-button"
                        disabled="@(Filtered.Count == 0)"
                        @onclick="Download">Download</button>
                <button type="button"
                        class="log-button"
                        disabled="@(Filtered.Count == 0)"
                        @onclick="Copy">Copy</button>
            </div>

            <p class="note">
                Exports the @Plural(Filtered.Count, "note") currently shown, as
                @(_json ? "JSON for a tool to read" : "Markdown for a person to read back").
            </p>

            @if (_status is not null)
            {
                <p class="status-line">@_status</p>
            }

            <div class="log-actions">
                @if (_confirmingClear)
                {
                    <button type="button" class="log-button danger" @onclick="ConfirmClear">
                        Really delete all @Plural(Store.All.Count, "note")?
                    </button>
                    <button type="button" class="log-button" @onclick="() => _confirmingClear = false">
                        Cancel
                    </button>
                }
                else
                {
                    <button type="button" class="log-button" @onclick="() => _confirmingClear = true">
                        Clear all notes
                    </button>
                }
            </div>

            @if (_confirmingClear)
            {
                <p class="note warn">
                    This cannot be undone and there is no server copy. Export first if you want them.
                </p>
            }
        </div>

        @if (Filtered.Count == 0)
        {
            <p class="note">Nothing matches that filter.</p>
        }

        @foreach (var group in Groups())
        {
            <section class="battle-group">
                <h2>
                    #@group.Number @group.Name
                    <span class="tag">@group.Id</span>
                    <span class="group-count">@Plural(group.Notes.Count, "note")</span>
                </h2>

                <ol class="note-list">
                    @foreach (var note in group.Notes)
                    {
                        var id = note.Id;
                        <li class="panel">
                            <div class="note-head">
                                <span class="note-when">@note.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</span>
                                @foreach (var tag in note.Tags)
                                {
                                    <span class="tag tag-@tag">@tag</span>
                                }
                                <button type="button"
                                        class="note-delete"
                                        title="Delete this note"
                                        @onclick="() => Delete(id)">×</button>
                            </div>
                            <p class="note-context">@PlaytestNotes.Context(note)</p>
                            <p class="note-text">@note.Text</p>
                        </li>
                    }
                </ol>
            </section>
        }
    }
</div>

@code {
    private const string UntaggedFilter = "␀untagged";

    private string _battleFilter = string.Empty;
    private string? _tagFilter;
    private bool _json;
    private bool _confirmingClear;
    private string? _status;
    private bool _canSaveToDirectory;
    private bool _asked;
    private bool _disposed;

    private static string Plural(int count, string word) =>
        count.ToString(System.Globalization.CultureInfo.InvariantCulture)
        + " " + word + (count == 1 ? string.Empty : "s");

    private sealed record BattleSummary(string Id, string Name, int Number, int Count);

    private sealed record BattleGroup(string Id, string Name, int Number, List<PlaytestNote> Notes);

    private SessionLog Log => Store.Log;

    protected override async Task OnInitializedAsync()
    {
        await Store.LoadAsync();
        await Log.ResumeAsync();
        Log.Changed += OnLogChanged;
    }

    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private Task ChooseFolder() => Log.ChooseAsync();

    private Task StopLogging() => Log.ForgetAsync();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_asked)
        {
            _asked = true;
            _ = DetectDirectorySupportAsync();
        }
    }

    private async Task DetectDirectorySupportAsync()
    {
        bool supported = await Files.CanSaveToDirectoryAsync();

        if (!_disposed && supported != _canSaveToDirectory)
        {
            _canSaveToDirectory = supported;
            StateHasChanged();
        }
    }

    private int BattleCount => Battles().Count;

    /// <summary>Notes matching both filters, newest first.</summary>
    private IReadOnlyList<PlaytestNote> Filtered
    {
        get
        {
            var matches = new List<PlaytestNote>();
            foreach (var note in Store.All)
            {
                if (_battleFilter.Length > 0 && !string.Equals(note.FightId, _battleFilter, StringComparison.Ordinal))
                {
                    continue;
                }

                if (_tagFilter == UntaggedFilter && note.Tags.Count > 0)
                {
                    continue;
                }

                if (_tagFilter is not null && _tagFilter != UntaggedFilter && !note.Tags.Contains(_tagFilter))
                {
                    continue;
                }

                matches.Add(note);
            }

            return matches;
        }
    }

    private List<BattleSummary> Battles()
    {
        var order = new List<string>();
        var counts = new Dictionary<string, int>(StringComparer.Ordinal);
        var names = new Dictionary<string, PlaytestNote>(StringComparer.Ordinal);

        // Notes arrive newest first, so first-seen order puts the most recently played battle top.
        foreach (var note in Store.All)
        {
            if (!counts.ContainsKey(note.FightId))
            {
                counts[note.FightId] = 0;
                names[note.FightId] = note;
                order.Add(note.FightId);
            }

            counts[note.FightId]++;
        }

        var summaries = new List<BattleSummary>();
        foreach (var id in order)
        {
            summaries.Add(new BattleSummary(id, names[id].FightName, names[id].FightNumber, counts[id]));
        }

        return summaries;
    }

    private List<BattleGroup> Groups()
    {
        var groups = new List<BattleGroup>();
        var byId = new Dictionary<string, BattleGroup>(StringComparer.Ordinal);

        foreach (var note in Filtered)
        {
            if (!byId.TryGetValue(note.FightId, out var group))
            {
                group = new BattleGroup(note.FightId, note.FightName, note.FightNumber, new List<PlaytestNote>());
                byId[note.FightId] = group;
                groups.Add(group);
            }

            group.Notes.Add(note);
        }

        return groups;
    }

    private int CountWithTag(string tag)
    {
        int count = 0;
        foreach (var note in Store.All)
        {
            if (note.Tags.Contains(tag))
            {
                count++;
            }
        }

        return count;
    }

    private int CountUntagged()
    {
        int count = 0;
        foreach (var note in Store.All)
        {
            if (note.Tags.Count == 0)
            {
                count++;
            }
        }

        return count;
    }

    private void OnBattleChanged(ChangeEventArgs args)
    {
        _battleFilter = args.Value?.ToString() ?? string.Empty;
        _status = null;
    }

    private void SetTag(string? tag)
    {
        _tagFilter = _tagFilter == tag ? null : tag;
        _status = null;
    }

    private void ClearFilters()
    {
        _battleFilter = string.Empty;
        _tagFilter = null;
    }

    private void SetFormat(bool json)
    {
        _json = json;
        _status = null;
    }

    private string Render() => _json
        ? PlaytestNotes.RenderJson(Filtered)
        : PlaytestNotes.RenderMarkdown(Filtered);

    private string FileName() => PlaytestNotes.FileName(_json ? ".json" : ".md");

    private async Task SaveToFolder()
    {
        int count = Filtered.Count;
        var outcome = await Files.SaveToDirectoryAsync(
            FileName(),
            Render(),
            _json ? ".json" : ".md",
            _json ? "Faultline notes (JSON)" : "Faultline notes (Markdown)");

        // A cancelled picker is a normal outcome, not a failure: say nothing and change nothing.
        _status = outcome switch
        {
            "cancelled" => null,
            "unsupported" => "This browser cannot open a save dialog. Use Download instead.",
            _ when outcome.StartsWith("saved:", StringComparison.Ordinal) =>
                $"Saved {outcome.Substring(6)} — {Plural(count, "note")}.",
            _ => "Save failed: " + outcome,
        };
    }

    private async Task Download()
    {
        int count = Filtered.Count;
        var outcome = await Files.DownloadAsync(FileName(), Render());

        _status = outcome.StartsWith("downloaded:", StringComparison.Ordinal)
            ? $"Downloaded {outcome.Substring(11)} — {Plural(count, "note")}."
            : "Download failed: " + outcome;
    }

    private async Task Copy()
    {
        int count = Filtered.Count;
        var outcome = await Files.CopyAsync(Render());

        _status = outcome == "copied"
            ? $"Copied {Plural(count, "note")} to the clipboard."
            : "Copy failed: " + outcome;
    }

    private async Task Delete(string id)
    {
        await Store.DeleteAsync(id);
        _status = null;
    }

    private async Task ConfirmClear()
    {
        await Store.ClearAsync();
        _confirmingClear = false;
        _status = "All notes deleted from this browser.";
        ClearFilters();
    }

    public void Dispose()
    {
        Log.Changed -= OnLogChanged;
        _disposed = true;
    }
}

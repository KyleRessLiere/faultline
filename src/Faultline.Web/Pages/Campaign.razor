@page "/campaign"
@layout MainLayout
@inject RunSession Runs
@inject NavigationManager Nav

<PageTitle>Faultline — campaign</PageTitle>

<div class="run">
    <header class="run-head">
        <div>
            <h1>Faultline <span class="sub">the campaign</span></h1>
            <p class="note">
                Twelve nodes in a fixed order — ten fights and two rests. There is no healing between
                fights: a unit that finishes on 3 of 14 starts the next one on 3 of 14. A unit knocked
                down comes back <strong>bedraggled</strong> — a quarter of its maximum, and no
                activation slot in round 1; a unit swept down a drain is gone for the run.
            </p>
        </div>

        <div class="run-tools">
            <a class="action secondary" href="battles">All battles</a>
            <a class="action secondary" href="play">Board</a>
            <a class="action secondary" href="notes">Playtest notes</a>
        </div>
    </header>

    @if (!Runs.Loaded)
    {
        <p class="note">Reading browser storage…</p>
    }
    else
    {
        <div class="run-panels">
            <section class="panel run-status">
                <h2>This run</h2>

                @if (Runs.Problem is not null)
                {
                    <p class="warn">@Runs.Problem</p>
                }

                @if (Run is null)
                {
                    <p>No run yet. Pick a seed and start one.</p>
                }
                else
                {
                    <p class="run-line">
                        <span class="chip">Seed @Run.Seed</span>
                        <span class="chip">Node @(NodeNumber) / @Nodes.Count</span>
                        <span class="chip">@Run.FightsWon / @FightCount fights won</span>
                        <span class="chip status-@StatusClass">@StatusLabel</span>
                    </p>

                    @if (Runs.RestartedByReload)
                    {
                        <p class="warn">
                            The reload found this run inside a fight. The run came back — seed, node and
                            everything the squad is carrying — but the half-played board did not, so the
                            fight starts again from deployment.
                        </p>
                    }

                    <h3>Squad</h3>
                    <ul class="squad">
                        @foreach (var unit in Run.Squad)
                        {
                            <li class="@SquadClass(unit)">
                                <span class="art inline">
                                    <UnitArt Kind="unit.Kind" Label="@unit.Kind.ToString()" />
                                </span>
                                <span class="squad-name">@unit.Kind</span>
                                <span class="squad-hp">@HpText(unit)</span>
                                @if (unit.Status == RunUnitStatus.Downed)
                                {
                                    <span class="tag downed"
                                          title="Bedraggled: quarter health, and no activation slot in round 1. Everything else about it is normal, and its @Naming.Meter and abilities are intact.">
                                        downed — returns bedraggled on @unit.FieldingHp/@unit.MaxHp, no round-1 slot
                                    </span>
                                }
                                else if (unit.Status == RunUnitStatus.Voided)
                                {
                                    <span class="tag voided">voided — gone for the run</span>
                                }
                            </li>
                        }
                    </ul>

                    @if (Run.Outcome == RunOutcome.InProgress && CurrentNode is not null)
                    {
                        <h3>Next</h3>

                        @if (CurrentNode is FightNode fight)
                        {
                            var definition = Fight(fight.FightId);
                            <p>
                                <strong>Fight @(FightSlot(fight.FightId) + 1) — @(definition?.Name ?? fight.FightId)</strong>
                                <span class="tag">@fight.FightId</span>
                            </p>
                            @if (definition is not null)
                            {
                                <p class="note">@definition.Description</p>
                            }
                            <button class="action" @onclick="EnterNode">
                                @(Runs.InFight ? "Back to the fight" : "Begin the fight")
                            </button>
                        }
                        else
                        {
                            <p><strong>Rest</strong> — a checkpoint.</p>
                            <p class="note">
                                Restores every unit that can still be fielded to full and clears the downed
                                mark. It does not bring back anything voided.
                            </p>
                            <button class="action" @onclick="EnterNode">Take the rest</button>
                        }
                    }
                    else if (Run.Outcome == RunOutcome.Won)
                    {
                        <p class="outcome won">Run complete — every node cleared.</p>
                    }
                    else if (Run.Outcome == RunOutcome.Lost)
                    {
                        <p class="outcome lost">Run over. @LossReason</p>
                    }
                }
            </section>

            <section class="panel run-new">
                <h2>New run</h2>

                <label class="seed">
                    Seed
                    <input type="number" value="@_seed" @onchange="OnSeedChanged" />
                </label>

                @if (_confirming)
                {
                    <p class="warn">
                        A run is in progress — node @NodeNumber of @Nodes.Count on seed @Run!.Seed.
                        Starting a new one throws it away, damage, dead and all.
                    </p>
                    <button class="action danger" @onclick="StartConfirmed">Discard it and start over</button>
                    <button class="action secondary" @onclick="() => _confirming = false">Keep playing</button>
                }
                else
                {
                    <button class="action" @onclick="StartRequested">
                        @(Runs.InProgress ? "Start a new run…" : "Start a run")
                    </button>
                }

                @if (Run is not null)
                {
                    <button class="action secondary" @onclick="Abandon">Abandon this run</button>
                }

                <p class="note">
                    The run lives in this browser's localStorage — the seed, which node you are on and
                    what every squad member is carrying. A reload keeps all three and restarts the
                    current fight from deployment; it does not restore a half-played board.
                </p>
            </section>
        </div>

        @if (Runs.LastEvents.Count > 0)
        {
            <section class="panel latest">
                <h2>Just now</h2>
                <ul class="run-events">
                    @foreach (var e in Runs.LastEvents)
                    {
                        <li class="@EventClass(e)">@RunEventText.Describe(e)</li>
                    }
                </ul>
            </section>
        }

        <h2>The road</h2>
        <ol class="spine">
            @for (int i = 0; i < Nodes.Count; i++)
            {
                var index = i;
                var node = Nodes[index];
                var view = SlotState(index);

                <li class="slot @view.Css @(node is RestNode ? "rest" : "fight")">
                    <span class="slot-num">@(index + 1)</span>

                    <span class="slot-body">
                        @if (node is FightNode fightNode)
                        {
                            var definition = Fight(fightNode.FightId);
                            <span class="slot-kind">fight</span>
                            <span class="slot-name">@(definition?.Name ?? Title(fightNode.FightId))</span>
                            <span class="tag">@fightNode.FightId</span>
                            <span class="slot-mark">@view.Label</span>
                            @if (definition is not null)
                            {
                                <span class="slot-desc">@definition.Description</span>
                            }
                            else
                            {
                                <span class="slot-desc missing">
                                    No <code>@(fightNode.FightId + ".fight")</code> file is loaded, so this node
                                    cannot be played.
                                </span>
                            }
                        }
                        else
                        {
                            <span class="slot-kind rest-kind">rest</span>
                            <span class="slot-name">Checkpoint</span>
                            <span class="slot-mark">@view.Label</span>
                            <span class="slot-desc">
                                Every unit that can still be fielded goes back to full, and the downed mark
                                clears with it. Nothing brings back the voided.
                            </span>
                        }
                    </span>

                    @if (Run is not null && Run.Outcome == RunOutcome.InProgress && index == Run.NodeIndex)
                    {
                        <button class="action" @onclick="EnterNode">
                            @(node is RestNode ? "Rest" : "Play")
                        </button>
                    }
                </li>
            }
        </ol>

        @if (Runs.Journal.Count > 0)
        {
            <details class="journal">
                <summary>Run log — @Runs.Journal.Count events this session</summary>
                <ol>
                    @foreach (var line in Runs.Journal)
                    {
                        <li>@line</li>
                    }
                </ol>
            </details>
        }
    }
</div>

@code {
    private int _seed = GameSession.DefaultSeed;
    private bool _confirming;

    private RunState? Run => Runs.State;

    private IReadOnlyList<CampaignNode> Nodes => Runs.Definition.Nodes;

    private CampaignNode? CurrentNode => Runs.CurrentNode;

    /// <summary>How many of the nodes are fights, for the "n of ten" line.</summary>
    private int FightCount => Runs.Definition.FightIds().Count;

    private int NodeNumber => Run is null ? 0 : (Run.NodeIndex < Nodes.Count ? Run.NodeIndex + 1 : Nodes.Count);

    private string StatusLabel => Run?.Outcome switch
    {
        RunOutcome.Won => "complete",
        RunOutcome.Lost => "run over",
        _ => Runs.InFight ? "in a fight" : "in progress",
    };

    private string StatusClass => Run?.Outcome switch
    {
        RunOutcome.Won => "won",
        RunOutcome.Lost => "lost",
        _ => "playing",
    };

    /// <summary>Core's own one-line reason, read off the event rather than guessed at.</summary>
    private string LossReason
    {
        get
        {
            foreach (var e in Runs.LastEvents)
            {
                if (e is RunLost lost)
                {
                    return lost.Reason;
                }
            }

            return "A campaign ends on its first defeat.";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Runs.LoadAsync();
        if (Run is not null)
        {
            _seed = Run.Seed;
        }
    }

    private static FightDefinition? Fight(string id) =>
        CuratedSet.Active().TryGetValue(id, out var fight) ? fight : null;

    private static int FightSlot(string id) => CuratedSet.SlotOf(id);

    private static string HpText(RunUnit unit) => unit.Status switch
    {
        RunUnitStatus.Voided => "—",
        RunUnitStatus.Downed => "0/" + unit.MaxHp,
        _ => unit.Hp + "/" + unit.MaxHp,
    };

    private static string SquadClass(RunUnit unit) => unit.Status switch
    {
        RunUnitStatus.Voided => "lost",
        RunUnitStatus.Downed => "hurt",
        _ => unit.Hp < unit.MaxHp ? "hurt" : string.Empty,
    };

    private static string EventClass(RunEvent e) => e switch
    {
        UnitRested => "good",
        RunWon => "good",
        RunLost => "bad",
        UnitCarried carried when carried.Status == RunUnitStatus.Voided => "bad",
        _ => string.Empty,
    };

    private sealed record SlotView(string Css, string Label);

    private SlotView SlotState(int index)
    {
        if (Run is null)
        {
            return new SlotView("idle", "not started");
        }

        if (index < Run.NodeIndex)
        {
            return new SlotView("cleared", "cleared");
        }

        if (index > Run.NodeIndex)
        {
            return new SlotView("idle", "ahead");
        }

        return Run.Outcome switch
        {
            RunOutcome.Lost => new SlotView("failed", "run ended here"),
            RunOutcome.Won => new SlotView("cleared", "cleared"),
            _ => new SlotView("current", Runs.InFight ? "fighting now" : "you are here"),
        };
    }

    /// <summary>A readable name for a fight with no loaded file to read one from.</summary>
    private static string Title(string id) => id.Replace('-', ' ');

    private void OnSeedChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out int seed))
        {
            _seed = seed;
        }
    }

    private async Task StartRequested()
    {
        if (Runs.InProgress)
        {
            _confirming = true;
            return;
        }

        // Awaited rather than fired and forgotten: Blazor re-renders when the handler's task
        // completes, and a run that appears only on the next unrelated click is a bug.
        await StartConfirmed();
    }

    private async Task StartConfirmed()
    {
        _confirming = false;
        await Runs.StartAsync(_seed);
    }

    private async Task Abandon()
    {
        _confirming = false;
        await Runs.AbandonAsync();
    }

    /// <summary>
    /// Enters the node the run is standing on. A rest resolves on the spot and the events say what it
    /// restored; a fight goes to the board.
    /// </summary>
    private void EnterNode()
    {
        if (Runs.InFight)
        {
            // The board may have been taken by a one-off battle since; put the run's fight back.
            Runs.ResumeBoard();
            Nav.NavigateTo("play");
            return;
        }

        Runs.Enter();

        if (Runs.InFight)
        {
            Nav.NavigateTo("play");
        }
    }
}

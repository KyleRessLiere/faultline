@implements IDisposable
@inject RunSession Runs

@* The camp (MASTER_DESIGN §8.6, the offer director): after every combat node, two cards on one
   table and one pick. The two cards may belong to different players' ducks, and that is the whole
   decision — taking the Archer's card is choosing not to take the Vanguard's. It used to be two
   tables and two picks; §8.6's rows cannot be said about that shape (D-154).

   Everything drawn here comes off Camp.Draw and the catalogue behind it. The name and the rule text
   are CampOffer.Name and CampOffer.Summary verbatim: no number on a card is typed in this file, and
   no sentence on one is a paraphrase (D-112).

   THE OFFER IS ALREADY BOUND. CampCatalogue.EligibleFor draws per duck, so the seed picked the duck
   at the same moment it picked the card — "Sure-Footed for the Vanguard" and "Sure-Footed for the
   Fisher" are two different cards. The card therefore NAMES its duck and offers no way to move it: a
   selector here would be a way to hand the squad a card the run never dealt (D-132).

   THERE IS NO SKIP. Camps are the reward and declining one is not a decision worth a button (§8.5).
   A camp that dealt nothing at all is confirmed by the flow rather than asked, because there is no
   table in front of anybody to decline. *@

@if (Runs.AtCamp && Runs.Camp is { } table)
{
    var cards = CampCards.For(Run, table);

<section class="panel camp">
    <header class="camp-head">
        <h2>Camp</h2>
        <p class="note">
            @Won Two cards, one pick — gameplay only, and there are no stat lines in here. The two
            may be for different ducks on different sides, and choosing between them is the decision.
        </p>
    </header>

    @if (Runs.Problem is not null)
    {
        <p class="warn">@Runs.Problem</p>
    }

    <div class="tables">
        <div class="table @(Flow.Confirmed ? "locked" : "open")">
            @if (cards.Count == 0)
            {
                @* Not a decline, and it does not read as one: the squad is carrying everything the
                   camp could offer, so there was nothing to deal. *@
                <p class="empty">
                    Nothing was dealt — every pool the squad could draw from is exhausted. There is
                    nothing here to take and nothing to turn down.
                </p>
            }
            else
            {
                <ol class="offers">
                    @foreach (var card in cards)
                    {
                        var offer = card;
                        <li data-side="@SideClass(offer.Player)">
                            @* The shared surface. A mod names the spender it bolts onto; a technique
                               names the ability that hosts it; an unlock names the duck it changes. *@
                            <OfferCard Index="offer.Index"
                                       Name="@offer.Name"
                                       Rule="@offer.Summary"
                                       Category="@offer.CategoryName"
                                       Tone="@CampCards.Class(offer.Category)"
                                       Glyph="@offer.Glyph"
                                       Bound="@(Label(offer.Player) + " · " + offer.Bound)"
                                       Kind="offer.Kind"
                                       Picked="Flow.Selected == offer.Index"
                                       Disabled="Flow.Confirmed"
                                       OnPick="() => Select(offer.Index)" />
                        </li>
                    }
                </ol>

                @* One confirm, and no third button beside it. *@
                @if (Flow.Confirmed)
                {
                    <p class="confirmed" role="status">Locked in — @NameOfPick(cards).</p>
                    <button type="button" class="action secondary" @onclick="Reopen">Change it</button>
                }
                else
                {
                    <button type="button"
                            class="action confirm"
                            disabled="@(Flow.Selected is null)"
                            @onclick="Confirm">
                        @(Flow.Selected is null ? "Pick a card" : "Take " + NameOfPick(cards))
                    </button>
                }
            }

            @* Why a duck has nothing on this table, said rather than left as a mystery. Both figures
               are read off the loadout — a full spender offers no mods, a full pocket offers no
               one-shots — and neither is worked out here. *@
            @foreach (var player in Players)
            {
                <ul class="ducks side-@SideClass(player)">
                    @foreach (var duck in CampCards.DucksFor(Run, player))
                    {
                        <li class="@(duck.Offers == 0 ? "spent" : string.Empty)">
                            <span class="duck-name">@duck.Name</span>
                            @if (duck.Reason.Length > 0)
                            {
                                <span class="duck-reason">@duck.Reason</span>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>
}

@code {
    private readonly CampFlow _own = new();

    /// <summary>
    /// The picking ceremony, when the host wants to own it. Left unset the panel keeps its own —
    /// which is what the app does. A parameter for the same reason the vote's is: a harness has to
    /// be able to take a pick without a mouse.
    /// </summary>
    [Parameter]
    public CampFlow? Ceremony { get; set; }

    private CampFlow Flow => Ceremony ?? _own;

    private RunState? Run => Runs.State;

    private static readonly Team[] Sides = { Team.PlayerA, Team.PlayerB };

    private static IReadOnlyList<Team> Players => Sides;

    /// <summary>The fight this camp follows, when the session still remembers it.</summary>
    private string Won =>
        Runs.LastResolution is { Outcome: FightOutcome.Won } resolved
            ? "Cleared " + resolved.FightId + "."
            : "The fight is cleared.";

    protected override void OnInitialized()
    {
        Runs.Changed += OnRunChanged;
        Sync();
    }

    protected override void OnParametersSet() => Sync();

    public void Dispose() => Runs.Changed -= OnRunChanged;

    private void OnRunChanged()
    {
        Sync();
        StateHasChanged();
    }

    /// <summary>
    /// Opens the ceremony exactly while Core says there is a camp, and shuts it the moment Core says
    /// there is not. That is the whole of "a camp is picked at once": the surface exists only while
    /// <see cref="RunPhase.AtCamp"/> does, and Core never returns to that phase for the same node.
    /// </summary>
    private void Sync()
    {
        if (Runs.AtCamp && Runs.Camp is { } table)
        {
            Flow.Begin(table);
        }
        else
        {
            Flow.Close();
        }
    }

    private void Select(int index)
    {
        Flow.Select(index);
        StateHasChanged();
    }

    private void Reopen()
    {
        Flow.Reopen();
        StateHasChanged();
    }

    /// <summary>
    /// Takes the confirmation and sends the camp — one <see cref="CampPickCommand"/> carrying the
    /// pick and the table it was picked from.
    /// </summary>
    private void Confirm()
    {
        Flow.Confirm();

        if (Flow.Ready)
        {
            Runs.PickCamp(Flow.Pick);
            return;
        }

        StateHasChanged();
    }

    private static string SideClass(Team player) => player == Team.PlayerA ? "a" : "b";

    private static string Label(Team player) => player == Team.PlayerA ? "Player A" : "Player B";

    private string NameOfPick(IReadOnlyList<CampCard> cards)
    {
        if (Flow.Selected is not { } index || index >= cards.Count)
        {
            return string.Empty;
        }

        return cards[index].Name;
    }
}

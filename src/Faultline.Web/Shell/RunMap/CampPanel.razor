@implements IDisposable
@inject RunSession Runs

@* The camp (MASTER_DESIGN §8.6, the offer director): after every combat node, TWO tables of two and
   ONE PICK EACH. Each table's cards are addressed to that player's own ducks, and both players pick
   at every camp — a camp that advanced having given one player nothing is the defect D-247 removes.

   THE SUBTITLE WAS ALREADY TRUE AND THE BODY WAS NOT. The frame above this panel has read "One pick
   each, then back to the map" since the camp got its own screen, while this body said pick 1 of 2 for
   the flock. One fact, two homes, disagreeing (§7.5). The subtitle is the one that stayed.

   Everything drawn here comes off Camp.Draw and the catalogue behind it. The name and the rule text
   are CampOffer.Name and CampOffer.Summary verbatim: no number on a card is typed in this file, and
   no sentence on one is a paraphrase (D-112).

   THE OFFER IS ALREADY BOUND. CampCatalogue.EligibleFor draws per duck, so the seed picked the duck
   at the same moment it picked the card — "Sure-Footed for the Vanguard" and "Sure-Footed for the
   Fisher" are two different cards. The card therefore NAMES its duck and offers no way to move it: a
   selector here would be a way to hand the squad a card the run never dealt (D-132).

   A SPENT TABLE READS AS RESOLVED, NEVER AS ABSENT — the same honesty §7.5 requires of the
   turn-order strip, where a skipped Bedraggled slot renders as a visible "recovering" gap and never
   as silence. The table stays on screen, labelled with its owner and with what was taken off it.

   THERE IS NO SKIP. Camps are the reward and declining one is not a decision worth a button (§8.5).
   A camp that dealt nothing at all is confirmed by the flow rather than asked, because there is no
   table in front of anybody to decline. *@

@if (Runs.AtCamp && Runs.Camp is { } table)
{
<section class="panel camp">
    <header class="camp-head">
        <h2>Camp</h2>
        <p class="note">
            @Won One pick each — gameplay only, and there are no stat lines in here. Each table's
            cards are for that player's own ducks, and neither player waits on the other.
        </p>
    </header>

    @if (Runs.Problem is not null)
    {
        <p class="warn">@Runs.Problem</p>
    }

    @if (table.Seats.Count == 0)
    {
        @* Not a decline, and it does not read as one: the squad is carrying everything the camp
           could offer, so there was nothing to deal to anybody. *@
        <div class="tables">
            <div class="table open">
                <p class="empty">
                    Nothing was dealt — every pool the squad could draw from is exhausted. There is
                    nothing here to take and nothing to turn down.
                </p>
                <button type="button" class="action confirm" @onclick="() => Send(Team.PlayerA, CampPickCommand.NoPick)">
                    Move on
                </button>
            </div>
        </div>
    }
    else
    {
    <div class="tables">
        @foreach (var player in Players)
        {
            var seat = table.SeatFor(player);
            var cards = CampCards.For(Run, table, player);
            var flow = Flow(player);
            var taken = Runs.CampPickTaken(player);

            <div class="table @(taken ? "locked" : "open")" data-side="@SideClass(player)">
                @* Labelled with its owner BEFORE either player chooses — a table nobody can tell the
                   owner of is a table both players think is theirs. *@
                <h3 class="table-owner">@Label(player)</h3>

                @if (seat is null || cards.Count == 0)
                {
                    <p class="empty">
                        @Label(player) was dealt nothing — their ducks are carrying everything this
                        camp could offer them.
                    </p>
                }
                else if (taken)
                {
                    @* Resolved, not absent. The cards stay up so the other player can still read what
                       this table held; the one that was taken is marked and nothing is pickable. *@
                    <p class="confirmed" role="status">Picked — @TakenName(player, cards).</p>

                    <ol class="offers">
                        @foreach (var card in cards)
                        {
                            var offer = card;
                            <li data-side="@SideClass(player)">
                                <OfferCard Index="offer.Index"
                                           Name="@offer.Name"
                                           Rule="@offer.Summary"
                                           Category="@offer.CategoryName"
                                           Tone="@CampCards.Class(offer.Category)"
                                           Glyph="@offer.Glyph"
                                           Bound="@offer.Bound"
                                           Kind="offer.Kind"
                                           Picked="TakenIndex(player) == offer.Index"
                                           Disabled="true"
                                           OnPick="() => { }" />
                            </li>
                        }
                    </ol>
                }
                else
                {
                    <ol class="offers">
                        @foreach (var card in cards)
                        {
                            var offer = card;
                            <li data-side="@SideClass(player)">
                                @* A mod names the spender it bolts onto; a technique names the
                                   ability that hosts it; an unlock names the duck it changes. *@
                                <OfferCard Index="offer.Index"
                                           Name="@offer.Name"
                                           Rule="@offer.Summary"
                                           Category="@offer.CategoryName"
                                           Tone="@CampCards.Class(offer.Category)"
                                           Glyph="@offer.Glyph"
                                           Bound="@offer.Bound"
                                           Kind="offer.Kind"
                                           Picked="flow.Selected == offer.Index"
                                           Disabled="flow.Confirmed"
                                           OnPick="() => Select(player, offer.Index)" />
                            </li>
                        }
                    </ol>

                    @* One confirm per table, and no third button beside it. *@
                    <button type="button"
                            class="action confirm"
                            disabled="@(flow.Selected is null)"
                            @onclick="() => Confirm(player)">
                        @(flow.Selected is null
                            ? "Pick a card"
                            : "Take " + NameOfPick(player, cards))
                    </button>
                }

                @* Which ducks are eligible for this table, and why one of them has nothing on it.
                   Both figures are read off the loadout — a full spender offers no mods, a full
                   pocket offers no one-shots — and neither is worked out here. *@
                <ul class="ducks side-@SideClass(player)">
                    @foreach (var duck in CampCards.DucksFor(Run, player))
                    {
                        <li class="@(duck.Offers == 0 ? "spent" : string.Empty)">
                            <span class="duck-name">@duck.Name</span>
                            @if (duck.Reason.Length > 0)
                            {
                                <span class="duck-reason">@duck.Reason</span>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
    }
</section>
}

@code {
    private readonly CampFlow _a = new();
    private readonly CampFlow _b = new();

    /// <summary>
    /// Player A's picking ceremony, when the host wants to own it. Left unset the panel keeps its
    /// own — which is what the app does. A parameter for the same reason the vote's is: a harness has
    /// to be able to take a pick without a mouse.
    /// </summary>
    [Parameter]
    public CampFlow? Ceremony { get; set; }

    /// <summary>Player B's picking ceremony. The camp runs two, one per table (D-247).</summary>
    [Parameter]
    public CampFlow? CeremonyB { get; set; }

    private RunState? Run => Runs.State;

    private static readonly Team[] Sides = { Team.PlayerA, Team.PlayerB };

    private static IReadOnlyList<Team> Players => Sides;

    private CampFlow Flow(Team player) => player == Team.PlayerA
        ? (Ceremony ?? _a)
        : (CeremonyB ?? _b);

    /// <summary>The fight this camp follows, when the session still remembers it.</summary>
    private string Won =>
        Runs.LastResolution is { Outcome: FightOutcome.Won } resolved
            ? "Cleared " + resolved.FightId + "."
            : "The fight is cleared.";

    protected override void OnInitialized()
    {
        Runs.Changed += OnRunChanged;
        Sync();
    }

    protected override void OnParametersSet() => Sync();

    public void Dispose() => Runs.Changed -= OnRunChanged;

    private void OnRunChanged()
    {
        Sync();
        StateHasChanged();
    }

    /// <summary>
    /// Opens a ceremony per unspent table, exactly while Core says there is one, and shuts them the
    /// moment Core says the camp is over. Whether a table has resolved is Core's answer
    /// (<see cref="Camp.HasPicked"/>) rather than a flag this panel keeps, so a reload lands on the
    /// same half-picked camp the player left.
    /// </summary>
    private void Sync()
    {
        if (Runs.AtCamp && Runs.Camp is { } table)
        {
            foreach (var player in Players)
            {
                if (!Runs.CampPickTaken(player) && table.SeatFor(player) is { } seat)
                {
                    Flow(player).Begin(seat);
                }
                else
                {
                    Flow(player).Close();
                }
            }

            return;
        }

        foreach (var player in Players)
        {
            Flow(player).Close();
        }
    }

    private void Select(Team player, int index)
    {
        Flow(player).Select(index);
        StateHasChanged();
    }

    /// <summary>
    /// Takes the confirmation and sends that player's pick — one <see cref="CampPickCommand"/>
    /// carrying the pick, whose table it came off, and the camp it was picked from. Core decides
    /// whether the camp is over; this sends one command and reads the phase back.
    /// </summary>
    private void Confirm(Team player)
    {
        var flow = Flow(player);
        flow.Confirm();

        if (flow.Ready)
        {
            Send(player, flow.Pick);
            return;
        }

        StateHasChanged();
    }

    private void Send(Team player, int pick) => Runs.PickCamp(player, pick);

    private static string SideClass(Team player) => player == Team.PlayerA ? "a" : "b";

    private static string Label(Team player) => player == Team.PlayerA ? "Player A" : "Player B";

    /// <summary>Which card this player took, from Core's record of the camp so far.</summary>
    private int TakenIndex(Team player)
    {
        if (Run is null)
        {
            return CampPickCommand.NoPick;
        }

        foreach (var pick in Run.CampPicks)
        {
            if (pick.Player == player)
            {
                return pick.Index;
            }
        }

        return CampPickCommand.NoPick;
    }

    private string TakenName(Team player, IReadOnlyList<CampCard> cards)
    {
        int index = TakenIndex(player);
        return index >= 0 && index < cards.Count ? cards[index].Name : string.Empty;
    }

    private string NameOfPick(Team player, IReadOnlyList<CampCard> cards)
    {
        if (Flow(player).Selected is not { } index || index >= cards.Count)
        {
            return string.Empty;
        }

        return cards[index].Name;
    }
}

@inherits PlaytestPanel

@* The legend and the view controls, in the board region's own bottom margins and never in a row of
   their own — the tiles' meanings in the bottom-LEFT corner, how the board is being looked at in the
   bottom-RIGHT. They were one stack on the left and competed there. Everything here is presentation:
   not one control submits a command or changes a rule.

   Hovering a legend item picks out every tile of that kind on the board — the fastest way to answer
   "where are the drains on this map" without counting squares.

   Fit is the state the board is in unless somebody left it: the size is computed from the region,
   so the zoom pair is an override rather than the normal way to size the board. Which of the two is
   in force is on the buttons, because a percentage that is being ignored is worse than no
   percentage at all. *@

<div class="board-controls">
    <ul class="legend" aria-label="Terrain">
        @foreach (var tile in Legend)
        {
            <li>
                <button type="button"
                        class="item @(View.HighlightedTerrain == tile ? "on" : string.Empty)"
                        title="@PlaytestText.TerrainWalk(tile) Shoved onto it: @PlaytestText.TerrainShoved(tile)"
                        @onmouseover="() => View.HighlightTerrain(tile)"
                        @onfocus="() => View.HighlightTerrain(tile)"
                        @onmouseout="() => View.HighlightTerrain(null)"
                        @onblur="() => View.HighlightTerrain(null)">
                    <i class="sw @EventText.TileClass(tile)"></i>@PlaytestText.Terrain(tile)
                </button>
            </li>
        }
        <li>
            <span class="item static" title="Where this side may place its squad before the fight starts.">
                <i class="sw deploy"></i>Deployment
            </span>
        </li>
    </ul>

    <div class="tools">
        <button type="button"
                class="tool @(View.ThreatView ? "on" : string.Empty)"
                aria-pressed="@View.ThreatView"
                title="Hatch every tile a living enemy could reach and then hit — Core's own movement and range queries, nothing guessed."
                @onclick="View.ToggleThreatView">
            Threats
        </button>

        <button type="button"
                class="tool @(View.RangePreview ? "on" : string.Empty)"
                aria-pressed="@View.RangePreview"
                title="Paint reach, the projected route and the outcome sentence while you hover."
                @onclick="View.ToggleRangePreview">
            Range preview
        </button>

        <button type="button"
                class="tool @(View.ShowThreatUnion ? "on" : string.Empty)"
                aria-pressed="@View.ShowThreatUnion"
                title="Paint the whole enemy side's reach at once. Off by default: the union covers most of a small board and says only that somewhere is dangerous (D-089)."
                @onclick="View.ToggleThreatUnion">
            Threat preview
        </button>

        <button type="button"
                class="tool @(View.GridLines ? "on" : string.Empty)"
                aria-pressed="@View.GridLines"
                title="Draw the separating line between tiles."
                @onclick="View.ToggleGridLines">
            Grid on
        </button>

        <span class="zoom @(View.Fit ? "off" : string.Empty)">
            <button type="button"
                    class="tool icon"
                    disabled="@(!View.CanZoomOut)"
                    title="Zoom out. Takes the board off its fit."
                    aria-label="Zoom out"
                    @onclick="View.ZoomOut">−</button>
            <span class="zoom-value">@(View.Fit ? "fit" : View.Zoom + "%")</span>
            <button type="button"
                    class="tool icon"
                    disabled="@(!View.CanZoomIn)"
                    title="Zoom in. Takes the board off its fit."
                    aria-label="Zoom in"
                    @onclick="View.ZoomIn">+</button>
        </span>

        @* Moved here from the header when the header stopped expanding: a switch that changes how
           the board is drawn belongs on the board's own toolbar, beside the other four. *@
        <button type="button"
                class="tool @(View.BoardOnly ? "on" : string.Empty)"
                aria-pressed="@View.BoardOnly"
                title="Hide the rail and give the whole window to the position."
                @onclick="View.ToggleBoardOnly">
            Board only
        </button>

        <button type="button"
                class="tool @(View.Fit ? "on" : string.Empty)"
                aria-pressed="@View.Fit"
                title="Fill the region with the board, and keep filling it as the window changes. The default."
                @onclick="View.FitBoard">
            Fit board
        </button>
        @* The mask: a rectangle of interest for reading one section of a board on its own. Paint and
           only paint — a dimmed tile is every bit as legal, targetable and walkable as a bright one,
           which is what keeps looking at the board from being a change to the fight. *@
        <button type="button"
                class="tool @(View.Masked ? "on" : string.Empty)"
                aria-pressed="@View.Masked"
                title="Dim everything outside a rectangle, so one section of the board can be read on its own. A view only — nothing about legality changes."
                @onclick="View.ToggleMask">
            Mask
        </button>

        @if (View.Masked)
        {
            <span class="mask-rect">
                <input type="number" min="0" max="31" title="Left edge"
                       value="@View.MaskX" @onchange="e => Move(e, 0)" />
                <input type="number" min="0" max="31" title="Top edge"
                       value="@View.MaskY" @onchange="e => Move(e, 1)" />
                <span class="by">×</span>
                <input type="number" min="1" max="31" title="Width in tiles"
                       value="@View.MaskWidth" @onchange="e => Move(e, 2)" />
                <input type="number" min="1" max="31" title="Height in tiles"
                       value="@View.MaskHeight" @onchange="e => Move(e, 3)" />
            </span>

            @foreach (var quarter in Quarters)
            {
                <button type="button" class="tool quiet"
                        title="@("Mask the " + quarter.Name.ToLowerInvariant() + " of this board")"
                        @onclick="() => Quarter(quarter.Dx, quarter.Dy)">@quarter.Name</button>
            }
        }
    </div>
</div>

@code {
    private sealed record Corner(string Name, int Dx, int Dy);

    /// <summary>
    /// One-click quarters, because "the north-west corner of this board" is what a person actually
    /// wants to look at and typing four numbers to say it is friction.
    /// </summary>
    private static readonly Corner[] Quarters =
    {
        new Corner("NW", 0, 0),
        new Corner("NE", 1, 0),
        new Corner("SW", 0, 1),
        new Corner("SE", 1, 1),
    };

    /// <summary>Reads one edited edge and leaves the other three where they were.</summary>
    private void Move(ChangeEventArgs e, int field)
    {
        if (!int.TryParse(e.Value?.ToString(), out int value))
        {
            return;
        }

        View.SetMask(
            field == 0 ? value : View.MaskX,
            field == 1 ? value : View.MaskY,
            field == 2 ? value : View.MaskWidth,
            field == 3 ? value : View.MaskHeight);
    }

    /// <summary>
    /// Masks one quarter of THIS board, rounded up so an odd board keeps its middle row and column
    /// in both halves rather than dropping them.
    /// </summary>
    private void Quarter(int dx, int dy)
    {
        int w = (State.Board.Width + 1) / 2;
        int h = (State.Board.Height + 1) / 2;

        View.SetMask(dx * (State.Board.Width - w), dy * (State.Board.Height - h), w, h);
    }

    /// <summary>
    /// The terrain kinds a legend has to explain. Cracked is deliberately absent: it is produced
    /// only at runtime by the collapse clock and no authored board fields it, so a swatch for it
    /// would document a tile a player cannot yet meet.
    ///
    /// The canal is present, unlike Cracked, because a board authors it directly with '~' as well as
    /// having a sluice raise it mid-fight — it is terrain a player meets from round 1 (D-275).
    /// </summary>
    private static readonly TileType[] Legend =
    {
        TileType.Open,
        TileType.Wall,
        TileType.Pit,
        TileType.Spikes,
        TileType.HighGround,
        TileType.Water,
    };
}

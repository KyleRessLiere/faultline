@inherits PlaytestPanel
@* The ability reference, straight off Core's descriptors. Scrolls on its own so a long list never
   pushes the turn panel off the screen. *@

<div class="pt-panel">
    <h2>
        Abilities
        <span class="count">@Descriptors.Count</span>
    </h2>

    <div class="pt-body">
        <ul class="abilities">
            @foreach (var descriptor in Descriptors)
            {
                <li>
                    <div class="head">
                        <span class="art">
                            <UnitArt Kind="descriptor.Kind" Label="@descriptor.Name" />
                        </span>
                        <strong class="name">@descriptor.Name</strong>
                        <span class="badge kind">@descriptor.Kind</span>
                        @foreach (var effect in Effects(descriptor))
                        {
                            <span class="badge effect">@effect</span>
                        }
                    </div>
                    <p class="summary">@descriptor.Summary</p>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<AbilityDescriptor> All = AbilityDescriptor.All().ToList();

    private IReadOnlyList<AbilityDescriptor> Descriptors => All;

    /// <summary>
    /// The effect line split into badges. Core writes it as one string with middots; splitting is
    /// presentation, and nothing here invents a claim the descriptor did not make.
    /// </summary>
    private static IEnumerable<string> Effects(AbilityDescriptor descriptor)
    {
        foreach (var part in descriptor.Effect.Split('·'))
        {
            var trimmed = part.Trim();
            if (trimmed.Length > 0)
            {
                yield return trimmed;
            }
        }
    }
}

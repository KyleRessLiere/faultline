@inherits PlaytestPanel
@* Who is acting, then the four ways of looking at the board. Everything here is presentation: not
   one control on this bar submits a command or changes a rule. *@

<div class="toolbar">
    <div class="who">
        @if (ShowBoard)
        {
            <span class="side team-@PlaytestText.TeamClass(State.ActiveTeam)">
                @PlaytestText.Team(State.ActiveTeam)
            </span>
            <span class="phase">@PlaytestText.Phase(State.Phase)</span>
        }
        else
        {
            <span class="phase">Between nodes</span>
        }
    </div>

    <div class="tools">
        <button type="button"
                class="tool @(View.RangePreview ? "on" : string.Empty)"
                aria-pressed="@View.RangePreview"
                title="Paint reach, the projected route and the outcome sentence while you hover."
                @onclick="View.ToggleRangePreview">
            Range preview
        </button>

        <button type="button"
                class="tool @(View.ThreatView ? "on" : string.Empty)"
                aria-pressed="@View.ThreatView"
                title="Hatch every tile a living enemy could reach and then hit — Core's own movement and range queries, nothing guessed."
                @onclick="View.ToggleThreatView">
            Threat view
        </button>

        <button type="button"
                class="tool @(View.GridLines ? "on" : string.Empty)"
                aria-pressed="@View.GridLines"
                title="Draw the separating line between tiles."
                @onclick="View.ToggleGridLines">
            Grid
        </button>

        <span class="zoom">
            <button type="button"
                    class="tool icon"
                    disabled="@(!View.CanZoomOut)"
                    title="Zoom out"
                    aria-label="Zoom out"
                    @onclick="View.ZoomOut">−</button>
            <button type="button"
                    class="tool zoom-value"
                    title="Back to the size that fits the panel"
                    @onclick="View.ResetZoom">@View.Zoom%</button>
            <button type="button"
                    class="tool icon"
                    disabled="@(!View.CanZoomIn)"
                    title="Zoom in"
                    aria-label="Zoom in"
                    @onclick="View.ZoomIn">+</button>
        </span>

        <button type="button"
                class="tool @(View.BoardOnly ? "on" : string.Empty)"
                aria-pressed="@View.BoardOnly"
                title="Give the board the whole window and hide the dashboard."
                @onclick="View.ToggleBoardOnly">
            @(View.BoardOnly ? "Exit full board" : "Full board")
        </button>
    </div>
</div>


@inherits PlaytestPanel
@inject BattleSurfaces Surfaces

@* The published activation order (D-103, MASTER_DESIGN §3), as a VERTICAL list down the left rail.

   It was a horizontal band above the board, which cost the board a row of its height and gave every
   card 62px to say who it was. Down the rail it costs the board nothing — the rail is a fixed column
   the board never had — and a row is wide enough for the portrait, the name, the pips and the badge
   on one line.

   Every scrap of order logic is Core's: StripCards reads TurnOrder.Upcoming and this draws it.

   Intent and status are ICONS, not sentences. A sentence per row would be six sentences on screen at
   once, which is a paragraph nobody reads placed where a glance was wanted; the whole sentence is on
   the hover, and the enemy's own inspector carries it in full.

   Clicking a row READS it and never gives an order. Friendly activation happens on the board.

   Expanding it OVERLAYS the board's left margin. The board never permanently resizes for a panel
   that is open for three seconds — that is the same law that keeps messages off the layout rows. *@

<div class="order @(Deploying ? "deploying" : string.Empty) @(Expanded ? "expanded" : string.Empty)">
    <div class="order-head">
        <span class="round">@RoundLabel</span>
        <span class="actor team-@PlaytestText.TeamClass(State.ActiveTeam)">@ActorLabel</span>

        <button type="button"
                class="expand"
                aria-expanded="@(Expanded ? "true" : "false")"
                title="@(Expanded ? "Fold the order back into the rail." : "Open the whole order over the board margin.")"
                @onclick="Surfaces.ToggleTurnOrder">@(Expanded ? "⌄" : "⌃")</button>
    </div>

    @if (Cards.Count == 0)
    {
        <p class="order-empty">@EmptyText</p>
    }
    else
    {
        <ol class="order-list" aria-label="Activation order">
            @foreach (var card in Cards)
            {
                @if (card.RoundSeam)
                {
                    <li class="seam" aria-label="@($"Round {card.Round} begins")">
                        <span class="seam-label">R@(card.Round)</span>
                        @if (card.ReinforcementsDue)
                        {
                            @* Waves land at round start before intents (D-037). Where an arrival
                               belongs in the order is undecided (MASTER_DESIGN §14), so this says the
                               round is not the whole story and claims nothing about position. *@
                            <span class="wave" title="A reinforcement wave lands at the start of this round. Its place in the order is not yet decided.">+wave</span>
                        }
                    </li>
                }

                <li class="slot @StripCards.Class(card.State) team-@PlaytestText.TeamClass(card.Team)">
                    <button type="button"
                            class="face"
                            disabled="@(!card.IsNamed)"
                            title="@Title(card)"
                            @onclick="() => Read(card)"
                            @onmouseover="() => Session.Telegraph(TelegraphOf(card))"
                            @onfocus="() => Session.Telegraph(TelegraphOf(card))"
                            @onmouseout="() => Session.Telegraph(null)"
                            @onblur="() => Session.Telegraph(null)">

                        <span class="seq">@card.Sequence</span>

                        @* An open slot is drawn *open* (MASTER_DESIGN §3): every un-activated duck
                           that could take it, as overlapping minis. One candidate is not a choice, so
                           it resolves to the plain portrait and no stack is drawn. *@
                        @if (StripCards.Portraits(card) is { Count: > 0 } faces)
                        {
                            <span class="art @(faces.Count > 1 ? "stack" : string.Empty)">
                                @foreach (var face in faces)
                                {
                                    <span class="mini">
                                        <UnitArt Kind="face.Kind" Label="@face.Name" />
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="art"><span class="slot-mark">?</span></span>
                        }

                        <span class="ident">
                            <span class="who">@StripCards.Ident(card)</span>

                            @if (card.Unit is { } body)
                            {
                                <span class="numbers">
                                    <span class="hp">@body.Hp/@body.MaxHp</span>

                                    @* One pip per point of the meter for a duck that holds a spender,
                                       so a spend can be seen coming without selecting anybody. *@
                                    @if (PlaytestText.MeterOf(body) is { } meter)
                                    {
                                        <span class="pips @(meter.Ready ? "ready" : string.Empty)"
                                              title="@meter.Title">
                                            @for (int v = 0; v < Verve.Cap; v++)
                                            {
                                                <i class="pip @(v < body.Verve ? "on" : string.Empty)"></i>
                                            }
                                        </span>
                                    }
                                </span>
                            }
                        </span>

                        @* One badge slot, and what fills it depends on what the row is. A gap says why
                           it is a gap; an enemy says what it means to do; a spent slot says it is
                           spent. Never all three, and never nothing. Icons, not sentences. *@
                        <span class="mark">
                            @if (card.Skip != ActivationSkip.None)
                            {
                                @* The one badge that keeps its word. A gap is a slot that does not
                                   exist, both players count on it, and a glyph alone would make the
                                   rarest and most consequential state the least readable one. *@
                                <span class="badge gap" title="@StripCards.GapLabel(card.Skip)">
                                    @GapGlyph(card.Skip) @StripCards.GapLabel(card.Skip)
                                </span>
                            }
                            else if (card.State == StripState.Defeated)
                            {
                                <span class="badge out" title="Off the board.">✕</span>
                            }
                            else if (card.State == StripState.Done)
                            {
                                <span class="badge done"
                                      title="@(Deploying ? "Placed" : "Activation spent")"
                                      aria-label="@(Deploying ? "Placed" : "Activation spent")">✓</span>
                            }
                            else if (card.Intent != IntentCategory.None)
                            {
                                <span class="badge intent @Intents.Class(card.Intent)"
                                      title="@card.IntentText"
                                      aria-label="@card.IntentText">@Intents.Glyph(card.Intent)</span>
                            }
                            else if (card.IsCurrent)
                            {
                                <span class="badge now" title="@(Deploying ? "Next to place" : "Acting now")">▶</span>
                            }
                        </span>
                    </button>
                </li>
            }
        </ol>
    }

    <p class="caption">@Caption</p>
</div>

@code {
    /// <summary>True while the squads are still being put down.</summary>
    private bool Deploying => State.Phase == Phase.Deployment;

    private bool Expanded => Surfaces.IsOpen(ContextualSurface.TurnOrder);

    private IReadOnlyList<StripCard> Cards => Deploying
        ? StripCards.Deployment(State, Session.PendingDeployUnit)
        : StripCards.Build(State);

    /// <summary>What the list is counting: a round, or the placements before the first one.</summary>
    private string RoundLabel => Deploying ? "Deployment" : "Round " + State.Round;

    private string ActorLabel => Deploying
        ? PlaytestText.Team(State.ActiveTeam).ToUpperInvariant() + " PLACES"
        : PlaytestText.Team(State.ActiveTeam).ToUpperInvariant() + " TO ACT";

    private string Caption => Deploying
        ? "Click a highlighted tile in your corner. Hover an enemy to see its round-1 reach."
        : "Clicking a row reads it. Select on the board.";

    private string EmptyText => Deploying
        ? "Nobody left to place."
        : "No activations left to publish.";

    /// <summary>
    /// Inspect always; select as well when this is a unit the active player may actually command.
    /// The two are deliberately not merged: inspection is universal and read-only, selection is gated
    /// on whose slot it is, and where a clicked row is one you may command both fire — that
    /// coincidence is not a licence to merge them (D-103).
    /// </summary>
    private void Read(StripCard card)
    {
        if (card.UnitId is not { } id)
        {
            return;
        }

        Session.Inspect(id);
        Surfaces.ShowInspector();

        if (Session.Selectable.Contains(id))
        {
            Session.Select(id);
        }
    }

    /// <summary>Which enemy's telegraph a hover singles out on the board, or none.</summary>
    private static UnitId? TelegraphOf(StripCard card) =>
        card.Unit is { Team: Team.Enemy } enemy ? enemy.Id : null;

    /// <summary>A gap's glyph. The words are on the hover; the row has one line.</summary>
    private static string GapGlyph(ActivationSkip skip) => skip switch
    {
        ActivationSkip.Bedraggled => "⧗",
        _ => "⌁",
    };

    private string Candidates(StripCard card)
    {
        var names = new List<string>();
        foreach (var unit in card.Candidates)
        {
            names.Add(unit.Name);
        }

        return names.Count == 0 ? "—" : PlaytestText.Names(names);
    }

    private string Title(StripCard card)
    {
        if (card.Unit is not { } unit)
        {
            return $"{PlaytestText.Team(card.Team)}'s slot in round {card.Round}. "
                + $"Either of {Candidates(card)} may take it — that choice is the player's, so the order cannot name one.";
        }

        // Deployment says where a duck is, not what it is about to do: there is no order yet, and a
        // row that claimed one would be publishing a fact the game does not have.
        if (Deploying)
        {
            return card.State switch
            {
                StripState.Current => $"{unit.Name} — the next placement puts this one down.",
                StripState.Done => $"{unit.Name} is placed, at {BoardCoords.Of(unit.Position)}.",
                _ => $"{unit.Name} is still to be placed.",
            };
        }

        // The whole intent sentence, not the badge's glyph: the badge says where to look and this
        // says what is coming, for how much, and to whom.
        if (card.IntentText.Length > 0)
        {
            return $"{unit.Name} — {card.IntentText}. Click to read it.";
        }

        return card.State switch
        {
            StripState.Recovering when card.Skip == ActivationSkip.Bedraggled =>
                $"{unit.Name} is bedraggled and takes no activation this round — its side has one fewer. "
                + "It is an ordinary unit otherwise: it can be hit, shoved and swept. Click to read it.",
            StripState.Recovering =>
                $"{unit.Name} is clinging and takes no activation — its side has one fewer this round. Click to read it.",
            StripState.Defeated => $"{unit.Name} is off the board. Click to read it.",
            StripState.Done => $"{unit.Name} has already activated this round. Click to read it.",
            StripState.Current => $"{unit.Name} — acting now. Click to read it.",
            _ => $"{unit.Name} — round {card.Round}. Click to read it.",
        };
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Surfaces.Changed += Redraw;
    }

    public override void Dispose()
    {
        Surfaces.Changed -= Redraw;
        base.Dispose();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);
}

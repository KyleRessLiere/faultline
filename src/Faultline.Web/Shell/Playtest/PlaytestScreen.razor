@inherits PlaytestPanel
@inject PlaytestNotes Notes
@inject BoardAnimator Animator

@* The battle screen, rebuilt (design session 2026-08-04, §7.5-v2 pending).

   THERE IS NO HEADER. The top bar was a full-width band charging the board 52px of height for five
   controls pressed two or three times a fight; it was deleted and its height went to the board. Its
   controls live in the paged dock at the foot of the rail, and every contract they carried — undo's
   stateful tooltip, restart's confirm, the amber unspent-AP confirm, the way home — went with them.

   Four regions, and each fact has exactly one home:

     LEFT RAIL   the run/fight/seed line, the objective, the activation order as a vertical list,
                 the pockets, and the paged dock in the bottom-left corner.
     BOARD       the centre, and everything the rail and the bar do not take.
     COMMAND BAR one card per action of the active duck, along the bottom. Cards and the hover
                 preview, nothing else.
     INSPECTOR   contextual, an OVERLAY pinned to the top-right of the board, absent when nothing is
                 selected. It is the SINGLE HOME for every unit's detail — HP, AP, Pluck, Footing —
                 the duck you are commanding included. There is no always-on resource display.

   Two laws hold the layout together and neither is decoration:

   NOTHING occupies a layout row that is not one of those regions. The board is handed whatever the
   fixed bands leave it, so a sentence given a row of its own is a sentence paid for in tiles.
   Anything with something to say is an overlay — the toasts, the status band — or it moves into a
   region that already exists.

   EVERY CONTEXTUAL SURFACE OVERLAYS; none of them resizes the board. The inspector, an expanded
   ability card and the expanded order all draw over the board's margins. A panel that reflowed the
   grid would make reading an enemy cost tiles, and then nobody reads one.

   This component owns the layout and the enemy-activation tick and nothing else. Every panel reads
   the session for itself, so no piece of game state is copied into a component. *@

<div class="pt-app @(View.BoardOnly ? "board-only" : string.Empty)">
    <div class="pt-main">
        <aside class="pt-rail">
            @* The line that lost its header and did not lose its home. Which run node, which board,
               which seed — one muted row at the top of a fixed column, so it costs the board
               nothing and a bug report can still name the seed. *@
            <p class="rail-context" title="@Session.Fight.Id">@ContextLine</p>

            <ObjectivePanel />
            <TurnOrderList />
            <PocketSection />

            <div class="rail-foot">
                <CommandDock OnUndo="Undo" OnRestart="Restart" />
                <DevPanel />
            </div>
        </aside>

        <section class="pt-stage">
            @* The board is the primary element and takes what is left. Everything a player decides
               with is drawn on it; every other region supports it. The status band, the system
               toasts and the inspector are drawn over it — they are not rows. *@
            <BattlefieldPanel />

            <InspectorPanel />

            <AbilityBar />
        </section>
    </div>
</div>

@code {
    /// <summary>
    /// Gap between one enemy command and the next. Short, because the beat of an enemy round is now
    /// carried by the movement animation itself; this is only the pause on the commands that show
    /// nothing, such as ending an activation.
    /// </summary>
    private const int EnemyTickMs = 200;

    private bool _resolvingEnemy;
    private bool _disposed;

    /// <summary>Where in the run, which board, which seed — the header's one surviving line.</summary>
    private string ContextLine => HeaderBar.ContextLine(Session, Runs);

    protected override void OnInitialized()
    {
        base.OnInitialized();

        // Only the end of a sequence, not every beat: the board subscribes to the beats itself, and
        // this screen redraws its whole tree. What it needs to know is when the enemy may go again.
        Animator.Finished += OnAnimationFinished;
    }

    protected override async Task OnInitializedAsync()
    {
        await Animator.ReadPreferenceAsync();

        // How the board is being looked at survives a reload. View only — not one field it restores
        // can change a rule, a legal command or a replay.
        await View.LoadAsync();
        await Runs.LoadAsync();

        // A reload lands here with a session the constructor built, not one the player chose. If a
        // run is waiting, put its fight back on the board rather than the placeholder — which, for a
        // run restored from storage, means entering its node again and starting from deployment.
        if (Session.Untouched && Runs.InProgress)
        {
            Runs.ResumeBoard();
        }

        // Picks a folder chosen in an earlier sitting back up, so the fight log goes to disk without
        // anyone having to remember to re-point at it. Never prompts. The note-taking UI is gone
        // (the dev panel replaced it); the folder logging behind it is what fight logs are written
        // through and stays.
        await Notes.Log.ResumeAsync();

        // Recording is on unless somebody turned it off, and turning it off is what you do to
        // bug-hunt — a decision that has to outlive the reload in the middle of the hunt.
        Session.RestoreRecording(await Notes.Log.RecordingWantedAsync());
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Enemy slots resolve on a short delay so the hotseat players can watch them tick past, and
        // never while the previous one is still being drawn — one activation at a time is what makes
        // a round read as a sequence instead of everything happening at once.
        if (!_resolvingEnemy && Session.AwaitingEnemy && !Animator.Busy)
        {
            _resolvingEnemy = true;
            _ = ResolveEnemyAsync();
        }
    }

    private void OnAnimationFinished() => _ = InvokeAsync(StateHasChanged);

    private async Task ResolveEnemyAsync()
    {
        await Task.Delay(EnemyTickMs);

        if (!_disposed && Session.AwaitingEnemy)
        {
            Session.ResolveEnemyActivation();
        }

        _resolvingEnemy = false;

        if (!_disposed)
        {
            StateHasChanged();
        }
    }

    private void Undo()
    {
        // The rewind replaces the position under whatever is on screen, so the animation goes with
        // it rather than finishing a move that no longer happened.
        if (Session.InRun)
        {
            Runs.Undo();
            Animator.Cancel();
            return;
        }

        Session.Undo();
        Animator.Cancel();
    }

    private void Restart()
    {
        Session.NewRun(Session.Seed + 1);
        Animator.Cancel();
    }

    public override void Dispose()
    {
        _disposed = true;
        Animator.Finished -= OnAnimationFinished;
        base.Dispose();
    }
}

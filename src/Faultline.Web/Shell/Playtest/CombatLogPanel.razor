@inherits PlaytestPanel
@inject FightFiles Files
@inject SessionLog Sink

@* The transcript, newest first. Recording is on by default and every fight is written into the
   sitting's folder as it is played — the fights worth analysing are the ones nobody expected to be
   interesting. Switching it off is the deliberate act, for bug-hunting. *@

<div class="pt-panel">
    <h2>
        Combat log
        <span class="count">@(Session.Recording ? $"{Session.RecordedLineCount} recorded" : "not recording")</span>
    </h2>

    <div class="tools">
        <label class="record"
               title="On by default. Records every event, tab-separated, and writes each fight into the sitting's folder as it is played. Turn it off to bug-hunt with nothing being written.">
            <input type="checkbox" checked="@Session.Recording" @onchange="ToggleRecording" />
            Record log
        </label>

        <button type="button"
                class="tool"
                disabled="@(Session.Log.Count == 0)"
                title="Empties the transcript on screen. A running recording is untouched."
                @onclick="ClearLog">
            Clear log
        </button>

        @if (Session.Recording)
        {
            <button type="button"
                    class="tool"
                    disabled="@(!_canSaveToDirectory || Session.RecordedLineCount == 0)"
                    title="@(_canSaveToDirectory ? "Write the .log into a folder you pick." : "This browser has no File System Access API. Use Download.")"
                    @onclick="SaveLogToFolder">
                Save
            </button>
            <button type="button"
                    class="tool"
                    disabled="@(Session.RecordedLineCount == 0)"
                    @onclick="DownloadLog">
                Download
            </button>
            <button type="button"
                    class="tool"
                    disabled="@(Session.RecordedLineCount == 0)"
                    @onclick="CopyLog">
                Copy
            </button>
        }
    </div>

    @if (Session.Recording && Sink.Active)
    {
        <p class="hint">
            Writing every fight to <strong>@Sink.Folder/@Sink.SessionPath/fights/</strong> as it is
            played@(Sink.FightLogs.Count == 0 ? "." : $" — {Sink.FightLogs.Count} so far.")
        </p>
    }
    else if (Session.Recording && Sink.Supported)
    {
        <p class="hint">
            Recording, but only in memory. Pick a folder in the notes panel and every fight is
            written into it as it is played.
        </p>
    }

    @if (!Session.Recording)
    {
        <p class="hint">
            Recording is <strong>off</strong>, so nothing is being kept and nothing is being written
            to disk. It is on by default — this is the bug-hunting setting.
        </p>
    }

    @if (Session.Recording && !Session.RecordingIsComplete)
    {
        <p class="hint">
            Recording started mid-fight — the event log is from here on and the command log will not
            replay from the seed.
        </p>
    }

    @if (_logStatus is not null)
    {
        <p class="hint status">@_logStatus</p>
    }

    <div class="pt-body tight">
        @if (Session.Log.Count == 0)
        {
            <p class="empty">Nothing has happened yet.</p>
        }
        else
        {
            <ol class="log">
                @foreach (var line in RecentLog())
                {
                    <li>@line</li>
                }
            </ol>
        }
    </div>
</div>

@code {
    // The board screen asks once whether this browser can write into a folder, so the button is
    // never offered when it could only fail.
    private bool _canSaveToDirectory;
    private bool _askedAboutDirectories;
    private bool _disposed;
    private string? _logStatus;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Sink.Changed += Redraw;
    }

    private void Redraw() => InvokeAsync(StateHasChanged);

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !_askedAboutDirectories)
        {
            _askedAboutDirectories = true;
            _ = DetectDirectorySupportAsync();
        }
    }

    private async Task DetectDirectorySupportAsync()
    {
        bool supported = await Files.CanSaveToDirectoryAsync();

        if (!_disposed && supported != _canSaveToDirectory)
        {
            _canSaveToDirectory = supported;
            StateHasChanged();
        }
    }

    private async Task ToggleRecording(ChangeEventArgs args)
    {
        bool on = args.Value is bool value && value;
        Session.SetRecording(on);

        // Remembered, because switching it off is what you do to bug-hunt and a bug hunt outlives
        // one page load. Switching it back on clears the key rather than storing "on".
        await Sink.SetRecordingWantedAsync(on);
        _logStatus = null;
    }

    private void ClearLog()
    {
        Session.ClearLog();
        _logStatus = null;
    }

    private async Task SaveLogToFolder()
    {
        var outcome = await Files.SaveToDirectoryAsync(
            Session.LogFileName, Session.RenderCombatLog(), ".log", "Faultline combat log");

        // A cancelled picker is a normal outcome, not a failure: say nothing and change nothing.
        _logStatus = outcome switch
        {
            "cancelled" => null,
            "unsupported" => "This browser cannot open a save dialog. Use Download instead.",
            _ when outcome.StartsWith("saved:", StringComparison.Ordinal) =>
                $"Saved {outcome.Substring(6)} — {Session.RecordedLineCount} event lines.",
            _ => "Save failed: " + outcome,
        };
    }

    private async Task DownloadLog()
    {
        var outcome = await Files.DownloadAsync(Session.LogFileName, Session.RenderCombatLog());

        _logStatus = outcome.StartsWith("downloaded:", StringComparison.Ordinal)
            ? $"Downloaded {outcome.Substring(11)} — {Session.RecordedLineCount} event lines."
            : "Download failed: " + outcome;
    }

    private async Task CopyLog()
    {
        var outcome = await Files.CopyAsync(Session.RenderCombatLog());

        _logStatus = outcome == "copied"
            ? $"Copied {Session.RecordedLineCount} event lines to the clipboard."
            : "Copy failed: " + outcome;
    }

    private IEnumerable<string> RecentLog()
    {
        var log = Session.Log;
        int take = log.Count < 80 ? log.Count : 80;
        for (int i = log.Count - 1; i >= log.Count - take; i--)
        {
            yield return log[i];
        }
    }

    public override void Dispose()
    {
        Sink.Changed -= Redraw;
        _disposed = true;
        base.Dispose();
    }
}

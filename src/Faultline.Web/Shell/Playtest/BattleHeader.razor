@inherits PlaytestPanel
@inject DevPanelState Dev
@inject NavigationManager Nav

@* One bar and one bar only: who we are, which board this is, the four things that are not part of
   playing the battle — and the one that is, END TURN. Everything that answers a question about the
   *position* — round, side, phase, objective — was taken out of here on purpose. A header that also
   reports the game is a second place to read the game, and two places disagree eventually.

   It is 24 pixels tall and it stays 24 pixels tall. The board is height-limited, not width-limited:
   a 54px band of chrome across the top was 54px taken off the only region anybody looks at. So the
   bar collapses to a strip carrying the context line, Undo and END TURN, and the full row — wordmark,
   Restart, Dev, Settings — arrives on hover or on a click as an overlay *over* the board rather than
   above it. Expanding costs the board nothing, which is the whole point; the collapsed strip is the
   only height the layout ever reserves.

   The dev panel already worked this way (a strip until somebody wants it), and this is deliberately
   the same gesture rather than a second one. It does not share the dev panel's state object, though:
   that object is gated on DevBuild and refuses every mutation on a release build, which is exactly
   right for the dev panel and would silently weld this bar shut. *@

<header class="hdr @(Open ? "open" : string.Empty)"
        tabindex="-1"
        @ref="_root"
        @onkeydown="OnRootKeyDown">

    @* The collapsed strip. Hover expansion is CSS, not state: the panel below is in the markup the
       whole time and :hover on the root reveals it. A mouse-enter handler would have to guess where
       the pointer went, and the pointer leaving a fixed overlay that is nowhere near the element it
       hangs off is exactly the guess that gets it wrong. *@
    <div class="strip">
        @* The way out, on the one row of chrome the layout always reserves. It was reachable only
           by expanding the bar, and a player who does not know the bar expands is a player stuck in
           a fight with no door — which is what this is here to fix. It costs no height: the strip
           is 24px whether or not the mark is in it. *@
        <button type="button"
                class="home mini"
                title="@HomeTitle"
                aria-label="@("Leave the battle — " + HomeLabel)"
                @onclick="AskLeave">
            @DuckMark
        </button>

        <span class="context" title="@ContextTitle">@ContextLine</span>

        <span class="spacer"></span>

        <button type="button"
                class="icon"
                disabled="@(!CanUndo)"
                title="@UndoTitle"
                aria-label="Undo"
                @onclick="OnUndo">↶</button>

        <button type="button"
                class="btn primary slim"
                disabled="@(!CanEndTurn)"
                title="@EndTurnTitle"
                @onclick="EndTurn">END TURN</button>

        @* Last, not second, and that is a correctness fix rather than a taste one. The full row is
           revealed by :hover and drawn OVER this strip, so whatever the panel has at a given x is
           what a click at that x actually hits — a player reaching for a control here is hovering
           the bar open before the mousedown lands. So the two rows have to agree position by
           position: the mark is leftmost in both and goes home in both, and the expand/collapse
           handle is rightmost in both and toggles the bar in both. It sat second from the left,
           under the mark, where reaching for "show me the controls" pressed "leave the battle". *@
        <button type="button"
                class="handle"
                aria-expanded="@(Open ? "true" : "false")"
                aria-label="Show the battle controls"
                title="Everything else: Restart, Dev, Settings."
                @onclick="ToggleBar">@(Open ? "⌃" : "⌄")</button>
    </div>

    @* The full row. Fixed rather than absolute, and over the board rather than above it: the strip
       keeps its 24px in the flex column while this is open, so nothing below moves by a pixel. *@
    <div class="panel">
        @* The wordmark is the way home, because a logo in the top-left is where every player on
           earth already clicks to leave. Drawn rather than lettered so the mark survives a rename:
           the word beside it is the only place the title is spelled (MASTER_DESIGN §15). *@
        <button type="button"
                class="brand home"
                title="@HomeTitle"
                aria-label="@("Leave the battle — " + HomeLabel)"
                @onclick="AskLeave">
            @DuckMark

            <span class="titles">
                <span class="mark">PLUCK</span>
                <span class="context" title="@ContextTitle">@ContextLine</span>
            </span>
        </button>

        <div class="controls">
            <button type="button"
                    class="btn"
                    disabled="@(!CanUndo)"
                    title="@UndoTitle"
                    @onclick="OnUndo">
                Undo
            </button>

            @* Asked rather than done. Restart throws the whole battle away, and it sits one pixel from
               Undo — the two most similar-looking buttons on the screen with the least similar
               consequences. The dialog is markup, not window.confirm: no JS interop in the shell. *@
            <button type="button"
                    class="btn"
                    disabled="@Session.InRun"
                    title="@RestartTitle"
                    aria-haspopup="dialog"
                    @onclick="AskRestart">
                Restart
            </button>

            @if (DevPanelState.Available)
            {
                <button type="button"
                        class="btn @(Dev.Open ? "on" : string.Empty)"
                        aria-pressed="@(Dev.Open ? "true" : "false")"
                        title="Developer overlays and board tools. Internal builds only."
                        @onclick="Dev.Toggle">
                    Dev
                </button>
            }

            <div class="menu">
                <button type="button"
                        class="btn @(_settingsOpen ? "on" : string.Empty)"
                        aria-expanded="@(_settingsOpen ? "true" : "false")"
                        aria-haspopup="true"
                        title="How the board is drawn. None of it changes the game."
                        @onclick="ToggleSettings">
                    Settings
                </button>

                @if (_settingsOpen)
                {
                    @* Only the view switches that are not already on the board's own toolbar. Zoom and
                       the overlays stay where the thing they change is. *@
                    <div class="popover" role="group" aria-label="View settings">
                        <button type="button"
                                class="opt @(View.GridLines ? "on" : string.Empty)"
                                aria-pressed="@(View.GridLines ? "true" : "false")"
                                @onclick="View.ToggleGridLines">
                            Grid lines
                        </button>
                        <button type="button"
                                class="opt @(View.RangePreview ? "on" : string.Empty)"
                                aria-pressed="@(View.RangePreview ? "true" : "false")"
                                @onclick="View.ToggleRangePreview">
                            Hover preview
                        </button>
                        <button type="button"
                                class="opt @(View.BoardOnly ? "on" : string.Empty)"
                                aria-pressed="@(View.BoardOnly ? "true" : "false")"
                                @onclick="View.ToggleBoardOnly">
                            Board only
                        </button>

                        @* The wordmark for those who know, a menu item for those who do not. The
                           same gesture behind both, including the same confirm — one exit, one
                           sentence about what it costs. *@
                        <button type="button"
                                class="opt leave"
                                aria-haspopup="dialog"
                                title="@HomeTitle"
                                @onclick="AskLeave">
                            Leave battle
                        </button>
                    </div>
                }
            </div>

            @* Last, heaviest, and on its own side of the row. It is the most-pressed control in a
               hotseat game and it is not a sibling of Undo in anything but shape, so it does not
               borrow Undo's outline. The reason rides beside it rather than only in the tooltip —
               the same treatment the action list gives a greyed row. *@
            <div class="end">
                <button type="button"
                        class="btn primary"
                        disabled="@(!CanEndTurn)"
                        title="@EndTurnTitle"
                        @onclick="EndTurn">
                    END TURN
                </button>

                @if (EndTurnReason.Length > 0)
                {
                    <span class="reason">@EndTurnReason</span>
                }
            </div>

            <button type="button"
                    class="handle"
                    aria-expanded="true"
                    aria-label="Collapse the battle controls"
                    title="Put the bar back (Escape)"
                    @onclick="CloseBar">⌃</button>
        </div>
    </div>

    @* One dialog, one consequence, told straight. Leaving is a reload — D-050's own path — so what
       it costs is exactly what a reload costs, and the sentence says so rather than implying the
       position will be waiting. *@
    @if (_leaving)
    {
        <div class="scrim" @onclick="CancelLeave"></div>
        <div class="confirm" role="dialog" aria-modal="true" aria-labelledby="leave-ask">
            <p class="ask" id="leave-ask">Leave battle?</p>
            <p class="consequence">@LeaveConsequence</p>
            <div class="confirm-row">
                <button type="button" class="btn" @onclick="CancelLeave">Stay</button>
                <button type="button" class="btn primary" @onclick="ConfirmLeave">@("Leave — " + HomeLabel)</button>
            </div>
        </div>
    }

    @if (_confirming)
    {
        <div class="scrim" @onclick="CancelRestart"></div>
        <div class="confirm" role="dialog" aria-modal="true" aria-labelledby="restart-ask">
            <p class="ask" id="restart-ask">Restart this battle?</p>
            <p class="consequence">
                The board goes back to deployment on seed @NextSeed. Everything that has happened —
                every move, every hit, every note about how it went — is gone.
            </p>
            <div class="confirm-row">
                <button type="button" class="btn" @onclick="CancelRestart">Cancel</button>
                <button type="button" class="btn danger" @onclick="ConfirmRestart">Restart</button>
            </div>
        </div>
    }
</header>

@code {
    /// <summary>Raised when the player asks to take the last decision back.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Raised once the player has confirmed the battle should start again.</summary>
    [Parameter]
    public EventCallback OnRestart { get; set; }

    private readonly Expansion _bar = new();

    private ElementReference _root;

    // Whether the root has already been focused for the expansion it is currently in. Focusing on
    // every render would take the caret out of whatever anybody was typing.
    private bool _focused;

    private bool _confirming;
    private bool _leaving;
    private bool _settingsOpen;

    /// <summary>
    /// Whether the full row is held open. Hover is not in here on purpose — that is CSS, and a bar
    /// that redrew the whole screen on every pointer crossing would be paying a render for a hover.
    /// A popover or a dialog pins it: neither can be read through a bar that closed underneath it.
    /// </summary>
    private bool Open => _bar.Open || _settingsOpen || _confirming || _leaving;

    /// <summary>Where the wordmark goes — the act map mid-run, the picker otherwise.</summary>
    private string HomeLabel => BattleExit.HomeLabel(Runs);

    private string HomeTitle => BattleExit.HomeTitle(Session, Runs);

    private string LeaveConsequence => BattleExit.Consequence(Session, Runs);

    /// <summary>
    /// The mark. A duck, drawn in the same flat placeholder style as the units, because the game is
    /// PLUCK and the thing it is about is ducks — the fault-line glyph it replaces was the old
    /// title's, and a mark that spells the old name beside the new word is worse than no mark.
    /// </summary>
    private static RenderFragment DuckMark => @<span class="logo" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="none" focusable="false">
            <rect x="1.5" y="1.5" width="21" height="21" rx="5" class="logo-plate" />
            <path d="M6 17.5 Q5.5 11.5 11 10.5 Q14.5 10 15.5 12.5 L19 13 Q18.5 18 12.5 18.5 Z" class="logo-duck" />
            <circle cx="13.8" cy="8.2" r="3.1" class="logo-duck" />
            <path d="M16.4 7.4 L20 7.9 L16.6 9.4 Z" class="logo-bill" />
            <circle cx="14.6" cy="7.5" r=".7" class="logo-eye" />
        </svg>
    </span>;

    private bool CanUndo => HeaderBar.CanUndo(Session, Runs);

    private string UndoTitle => HeaderBar.UndoTitle(Session, Runs);

    private bool CanEndTurn => HeaderBar.CanEndTurn(Session);

    private string EndTurnReason => HeaderBar.EndTurnReason(Session);

    private string EndTurnTitle => HeaderBar.EndTurnTitle(Session);

    private string RestartTitle => HeaderBar.RestartTitle(Session);

    /// <summary>The seed the restart would land on, so the dialog can name it rather than imply it.</summary>
    private string NextSeed => HeaderBar.Number(Session.Seed + 1);

    /// <summary>The one muted line: where in the run, which board, which seed.</summary>
    private string ContextLine => HeaderBar.ContextLine(Session, Runs);

    private string ContextTitle => Session.Fight.Id;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Escape only closes the bar if the keystroke reaches the bar, and it only reaches the bar if
        // the bar has focus. Taken once per opening, given back when it closes — and never taken for
        // a hover, which has no state and needs no key to end it.
        // Anything pinned open, not just the bar: the leave dialog can be opened from the collapsed
        // strip, and a dialog whose Escape does not work because the keystroke never reached the
        // element listening for it is a dialog with no way out but the mouse.
        if (Open && !_focused)
        {
            _focused = true;
            await _root.FocusAsync();
        }
        else if (!Open)
        {
            _focused = false;
        }
    }

    /// <summary>
    /// Escape backs out of whatever is innermost: a dialog first, then the popover, then the bar.
    /// One key, one step out — a screen where Escape from a dialog also closed the bar behind it
    /// takes two decisions from one keystroke.
    /// </summary>
    /// <param name="args">The keystroke.</param>
    private void OnRootKeyDown(KeyboardEventArgs args)
    {
        if (args.Key != "Escape")
        {
            return;
        }

        if (_leaving)
        {
            _leaving = false;
            return;
        }

        if (_confirming)
        {
            _confirming = false;
            return;
        }

        if (_settingsOpen)
        {
            _settingsOpen = false;
            return;
        }

        _bar.Key(args.Key);
    }

    private void ToggleBar() => _bar.Toggle();

    private void CloseBar()
    {
        _settingsOpen = false;
        _bar.Close();
    }

    /// <summary>
    /// Ends the selected duck's activation with the command Core offered for it. The same submit path
    /// the action list's Wait row presses — one route to Core, and no second opinion about when an
    /// activation may close.
    /// </summary>
    private void EndTurn()
    {
        if (Session.EndCommand is { } end)
        {
            Session.Submit(end);
        }
    }

    private void ToggleSettings() => _settingsOpen = !_settingsOpen;

    /// <summary>
    /// Asks to leave — or leaves outright when there is nothing left to lose, which is what a
    /// resolved fight is. A dialog guarding a door that costs nothing to walk through is a dialog
    /// people learn to click past without reading, and then it is not guarding the other one either.
    /// </summary>
    private void AskLeave()
    {
        _settingsOpen = false;

        if (!BattleExit.NeedsConfirm(Session, Runs))
        {
            Leave();
            return;
        }

        _leaving = true;
    }

    private void CancelLeave() => _leaving = false;

    private void ConfirmLeave()
    {
        _leaving = false;
        Leave();
    }

    /// <summary>
    /// Goes home with a full page load, which is the whole mechanism: leaving IS a reload (D-050).
    /// The run is read back out of browser storage exactly as it would be after a refresh, and the
    /// half-played board is not, so the fight restarts from deployment. No suspend, no resume, no
    /// second idea of what a saved fight is.
    /// </summary>
    private void Leave()
    {
        _bar.Close();
        Nav.NavigateTo(BattleExit.HomeRoute(Runs), forceLoad: true);
    }

    private void AskRestart()
    {
        _settingsOpen = false;
        _confirming = true;
    }

    private void CancelRestart() => _confirming = false;

    private async Task ConfirmRestart()
    {
        _confirming = false;
        _bar.Close();
        await OnRestart.InvokeAsync();
    }

    /// <summary>
    /// Whether the bar is being held open, and what closes it. A class rather than a bool field so
    /// the gesture can be tested: this project renders no components in its tests (see
    /// <see cref="DevPanelState"/> and the note on DevPanelTests), so anything a header decides has
    /// to be decided somewhere a test can reach.
    /// </summary>
    public sealed class Expansion
    {
        /// <summary>Whether the full row is pinned open by a click.</summary>
        public bool Open { get; private set; }

        /// <summary>Pins the row open, or lets it go.</summary>
        public void Toggle() => Open = !Open;

        /// <summary>Lets the row go, whatever pinned it.</summary>
        public void Close() => Open = false;

        /// <summary>Offers a keystroke to the bar.</summary>
        /// <param name="key">The key that was pressed, as the browser names it.</param>
        /// <returns>Whether the bar took it.</returns>
        public bool Key(string key)
        {
            if (key != "Escape" || !Open)
            {
                return false;
            }

            Open = false;
            return true;
        }
    }

    /// <summary>
    /// Everything the bar says and everything it greys, as functions of the session. Nothing here
    /// decides a rule: END TURN is available exactly when Core has published the command for it, and
    /// undo is available exactly when the session that owns the command stream says so.
    /// </summary>
    public static class HeaderBar
    {
        /// <summary>Whether END TURN may be pressed.</summary>
        /// <param name="session">The board.</param>
        /// <returns>True when Core has an end-of-activation command for the selected duck.</returns>
        public static bool CanEndTurn(GameSession session) => session?.EndCommand is not null;

        /// <summary>
        /// Why END TURN is greyed, in the words shown beside it. Empty exactly when the button is
        /// live — a reason string that lingered after the block cleared would grey a working button
        /// in the reader's head.
        /// </summary>
        /// <param name="session">The board.</param>
        /// <returns>The reason, or the empty string.</returns>
        public static string EndTurnReason(GameSession session)
        {
            if (CanEndTurn(session))
            {
                return string.Empty;
            }

            return session?.SelectedUnit is null
                ? "no activation is open — select one of your ducks"
                : "this duck's activation is not open — there is nothing to end";
        }

        /// <summary>The END TURN tooltip: what it does, or why it will not.</summary>
        /// <param name="session">The board.</param>
        /// <returns>One sentence.</returns>
        public static string EndTurnTitle(GameSession session)
        {
            string reason = EndTurnReason(session);
            return reason.Length > 0
                ? reason
                : "End this activation and pass the board to the next one.";
        }

        /// <summary>Whether there is a decision to take back.</summary>
        /// <param name="session">The board.</param>
        /// <param name="runs">The run, which owns the command stream when one is being played.</param>
        /// <returns>True when undo would do something.</returns>
        public static bool CanUndo(GameSession session, RunSession runs) =>
            session.InRun ? runs.CanUndo : session.CanUndo;

        /// <summary>
        /// The undo tooltip: what the rewind would take back, or why there is nothing to take. Both
        /// halves are the owning session's own words — a header that wrote its own would be a second
        /// account of a history it does not keep.
        /// </summary>
        /// <param name="session">The board.</param>
        /// <param name="runs">The run, which owns the command stream when one is being played.</param>
        /// <returns>One sentence.</returns>
        public static string UndoTitle(GameSession session, RunSession runs)
        {
            if (CanUndo(session, runs))
            {
                return session.InRun ? runs.UndoDescription : session.UndoDescription;
            }

            return (session.InRun ? runs.UndoBlockedReason : session.UndoBlockedReason)
                ?? "Nothing to undo.";
        }

        /// <summary>Why Restart is offered, or why it is not.</summary>
        /// <param name="session">The board.</param>
        /// <returns>One sentence.</returns>
        public static string RestartTitle(GameSession session) =>
            session.InRun
                ? "A run's seed belongs to the run, not to this fight — restart from the campaign screen."
                : "Start this battle again on the next seed.";

        /// <summary>The one muted line: where in the run, which board, which seed.</summary>
        /// <param name="session">The board.</param>
        /// <param name="runs">The run, when one owns the board.</param>
        /// <returns>The line, always naming at least the fight and the seed.</returns>
        public static string ContextLine(GameSession session, RunSession runs)
        {
            var parts = new List<string>();

            if (session.InRun && runs.State is { } run)
            {
                parts.Add("Run " + Number(NodeNumber(runs)) + "/" + Number(run.Campaign.Length));
            }

            parts.Add(session.Fight.Name);
            parts.Add("Seed " + Number(session.Seed));

            return string.Join(" · ", parts);
        }

        /// <summary>Formats a number without asking the browser's culture what a digit is.</summary>
        /// <param name="value">The number.</param>
        /// <returns>Its invariant text.</returns>
        public static string Number(int value) =>
            value.ToString(System.Globalization.CultureInfo.InvariantCulture);

        private static int NodeNumber(RunSession runs)
        {
            var run = runs.State;
            if (run is null)
            {
                return 0;
            }

            return run.NodeIndex < run.Campaign.Length ? run.NodeIndex + 1 : run.Campaign.Length;
        }
    }
}

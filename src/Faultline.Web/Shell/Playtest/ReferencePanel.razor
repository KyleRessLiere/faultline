@inherits PlaytestPanel
@* One window for everything the board can be asked about: the abilities, the battle's design notes
   and the character sheet of whatever enemy was last inspected. Clicking Design notes or an enemy
   switches this panel's tab rather than opening a second panel, so the turn panel above it never
   moves. Every word inside comes from Core — this component only chooses which of them to show. *@

<div class="pt-panel">
    <div class="tabs" role="tablist" aria-label="Reference">
        <button type="button"
                role="tab"
                id="ref-tab-abilities"
                class="tab @On(ReferenceTab.Abilities)"
                aria-selected="@Selected(ReferenceTab.Abilities)"
                aria-controls="ref-tabpanel"
                tabindex="@TabIndex(ReferenceTab.Abilities)"
                title="Every class ability"
                @ref="_abilities"
                @onclick="() => Session.ShowTab(ReferenceTab.Abilities)"
                @onkeydown="OnTabKeyDown">Abilities</button>

        <button type="button"
                role="tab"
                id="ref-tab-battle"
                class="tab @On(ReferenceTab.Battle)"
                aria-selected="@Selected(ReferenceTab.Battle)"
                aria-controls="ref-tabpanel"
                tabindex="@TabIndex(ReferenceTab.Battle)"
                title="Why this board exists — the designer's notes for this battle"
                @ref="_battle"
                @onclick="() => Session.ShowTab(ReferenceTab.Battle)"
                @onkeydown="OnTabKeyDown">Battle</button>

        <button type="button"
                role="tab"
                id="ref-tab-unit"
                class="tab @On(ReferenceTab.Unit)"
                aria-selected="@Selected(ReferenceTab.Unit)"
                aria-controls="ref-tabpanel"
                tabindex="@TabIndex(ReferenceTab.Unit)"
                title="The character sheet of the enemy you last clicked"
                @ref="_unit"
                @onclick="() => Session.ShowTab(ReferenceTab.Unit)"
                @onkeydown="OnTabKeyDown">Unit</button>

        <span class="count">@Count</span>
    </div>

    <div class="pt-body"
         id="ref-tabpanel"
         role="tabpanel"
         aria-labelledby="@LabelledBy">
        @switch (Session.Tab)
        {
            case ReferenceTab.Battle:
                <FightDesign Fight="Session.Fight" />
                break;

            case ReferenceTab.Unit:
                @if (Session.InspectedBehaviour is { } behaviour)
                {
                    <UnitDossier Behaviour="behaviour"
                                 Live="Session.InspectedUnit"
                                 Board="Session.State"
                                 ShowBestiaryLink="true" />
                }
                else if (Session.InspectedUnit is { } own)
                {
                    @* A player archetype has no EnemyBehaviour and never will, so the dossier has
                       nothing to draw. Since D-103 made inspection universal this is a real state
                       rather than an impossible one, and it shows the stat block instead of the
                       prompt that used to sit here. Commanding it is still the action panel's job. *@
                    <div class="own-unit">
                        <h3>@own.Name <span class="side">@PlaytestText.Team(own.Team)</span></h3>
                        <dl class="stats">
                            <div><dt>HP</dt><dd>@own.Hp/@own.MaxHp</dd></div>
                            <div><dt>Move</dt><dd>@own.MoveRemaining/@own.Move</dd></div>
                            <div><dt>Range</dt><dd>@PlaytestText.Reach(own)</dd></div>
                            <div><dt>Footing</dt><dd>@own.Footing</dd></div>
                            <div><dt>@Naming.Meter</dt><dd>@own.Verve/@Verve.Cap</dd></div>
                        </dl>
                        <p class="note">Reading only. Select it on the board to give it orders.</p>
                    </div>
                }
                else
                {
                    <p class="empty">Click any unit to read it — on the board, in the turn order, in the unit table or in the intents list.</p>
                }
                break;

            default:
                <AbilitiesPanel />
                break;
        }
    </div>
</div>

@code {
    private static readonly ReferenceTab[] Order =
    {
        ReferenceTab.Abilities,
        ReferenceTab.Battle,
        ReferenceTab.Unit,
    };

    private ElementReference _abilities;
    private ElementReference _battle;
    private ElementReference _unit;

    private string On(ReferenceTab tab) => Session.Tab == tab ? "on" : string.Empty;

    // Spelled out rather than left to a bool: ARIA wants the lower-case literals, and a bool
    // attribute would be dropped from the markup entirely when it is false.
    private string Selected(ReferenceTab tab) => Session.Tab == tab ? "true" : "false";

    // Roving tabindex: one stop for the whole strip, and the arrow keys move within it.
    private string TabIndex(ReferenceTab tab) => Session.Tab == tab ? "0" : "-1";

    private string LabelledBy => Session.Tab switch
    {
        ReferenceTab.Battle => "ref-tab-battle",
        ReferenceTab.Unit => "ref-tab-unit",
        _ => "ref-tab-abilities",
    };

    /// <summary>What the tab strip's right-hand slot says about whatever is showing.</summary>
    private string Count => Session.Tab switch
    {
        ReferenceTab.Battle => $"#{Session.Fight.Number} {Session.Fight.Name}",
        ReferenceTab.Unit => Session.InspectedUnit?.Name ?? "—",
        _ => AbilitiesPanel.Count.ToString(System.Globalization.CultureInfo.InvariantCulture),
    };

    private async Task OnTabKeyDown(KeyboardEventArgs args)
    {
        int at = Array.IndexOf(Order, Session.Tab);
        int next = args.Key switch
        {
            "ArrowRight" or "ArrowDown" => (at + 1) % Order.Length,
            "ArrowLeft" or "ArrowUp" => (at + Order.Length - 1) % Order.Length,
            "Home" => 0,
            "End" => Order.Length - 1,
            _ => at,
        };

        if (next == at)
        {
            return;
        }

        Session.ShowTab(Order[next]);
        await FocusAsync(Order[next]);
    }

    private ValueTask FocusAsync(ReferenceTab tab) => tab switch
    {
        ReferenceTab.Battle => _battle.FocusAsync(),
        ReferenceTab.Unit => _unit.FocusAsync(),
        _ => _abilities.FocusAsync(),
    };
}

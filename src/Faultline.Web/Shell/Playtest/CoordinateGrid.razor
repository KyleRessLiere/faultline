@inherits PlaytestPanel
@inject BoardAnimator Animator
@* The board, with its column and row numbers, sized to whatever box the panel gives it. The track
   count comes off Board.Width and Board.Height, so a 7x7, a 9x7 and an 11x7 all draw correctly
   without anything here knowing which one it is.

   A unit that is mid-move is left out of its tile and drawn as the sprite at the bottom instead, so
   it can slide along the path Core reported rather than appear at the far end of it. A shoved unit
   rides the same sprite: it shudders on the tile it was standing on, then travels. Nothing here
   decides anything: the animator says which unit and which tile, the board draws it. *@

<div class="stage">
    @* The board takes the keys while two ghosts are on it: left/right and Tab flip the highlighted
       candidate, Enter commits it. Tabindex so the container can hold focus at all, and the default
       is suppressed only while the choice is open so Tab still walks the tiles the rest of the
       time. *@
    <div class="board @(View.GridLines ? "lines" : string.Empty) @(Session.AimChoiceOpen ? "choosing" : string.Empty)"
         style="--cols: @Width; --rows: @Height; --zoom: @View.ZoomFactor; --step: @(Animator.StepMs)ms; --flash: @(Animator.FlashMs)ms; --shake: @(Animator.ShakeMs)ms; --charge: @(Animator.ChargeMs)ms;"
         tabindex="0"
         @onkeydown="OnBoardKeyDown"
         @onkeydown:preventDefault="Session.AimChoiceOpen"
         @onmouseleave="() => Session.Hover(null)">
        <div class="axis corner" aria-hidden="true"></div>

        @* Columns as letters, rows as one-based numbers, always on. Core addresses tiles as
           zero-based coordinates and always will — this is the label a person reads off the edge,
           and BoardCoords is the one place that decides it. *@
        @for (int x = 0; x < Width; x++)
        {
            <div class="axis col">@BoardCoords.Column(x)</div>
        }

        @for (int y = 0; y < Height; y++)
        {
            int row = y;
            <div class="axis row">@BoardCoords.Row(row)</div>

            @for (int x = 0; x < Width; x++)
            {
                var cell = new Coord(x, row);
                var unit = Occupant(cell);

                @* The tile's own address, on the tile. It is what the axis labels already show a
                   player, and it is the only way a test can ask what the board drew *here* rather
                   than what a helper said it would draw. *@
                <button type="button"
                        data-tile="@BoardCoords.Of(cell)"
                        class="@CellClass(cell, unit)"
                        disabled="@(!IsClickable(cell, unit))"
                        title="@Tooltip(cell, unit)"
                        @onmouseover="() => Session.Hover(cell)"
                        @onfocus="() => Session.Hover(cell)"
                        @onclick="() => OnCellClick(cell, unit)">
                    @if (unit is not null)
                    {
                        @* The declared plan, above the token that holds it. Rules-critical UI, not
                           polish (CLAUDE.md): what an enemy means to do belongs on the enemy. *@
                        @if (IntentOf(unit) is { } plan)
                        {
                            <span class="token-intent @Intents.Class(Intents.CategoryOf(plan, State)) @(Session.Telegraphed == unit.Id ? "lit" : string.Empty)"
                                  title="@Intents.Sentence(State, plan)">@Intents.Glyph(Intents.CategoryOf(plan, State))</span>
                        }

                        <span class="art team-@PlaytestText.TeamClass(unit.Team)">
                            <UnitArt Kind="unit.Kind" Label="@unit.Name" />
                        </span>
                        <span class="hp">@unit.Hp/@unit.MaxHp</span>
                        @* Charges are readable without selecting anybody: one dot per point, filled
                           up to what the unit holds. Drawn for every duck that holds a spender, so
                           an empty meter still says there is something to save for — and drawn for
                           none that does not, which is a fact about the duck and not its class. *@
                        @if (PlaytestText.MeterOf(unit) is { } meter)
                        {
                            <span class="verve @(meter.Ready ? "ready" : string.Empty) @(Animator.IsCharging(unit.Id) ? "ticking" : string.Empty)"
                                  title="@meter.Title">
                                @for (int v = 0; v < Verve.Cap; v++)
                                {
                                    <i class="vp @(v < unit.Verve ? "on" : string.Empty)"></i>
                                }
                            </span>
                        }
                        @* Loud rather than a pip, and only while placement is still open: where you
                           put a duck that owes its side an activation is the decision the label is
                           for (D-080). Once the fight starts the token keeps a pip and the strip
                           carries the gap. *@
                        @if (unit.Bedraggled && State.Phase == Phase.Deployment)
                        {
                            <span class="bedraggled-tag" title="@PlaytestText.BedraggledLabel(unit)">bedraggled</span>
                        }
                        @if (unit.Clinging || unit.Staggered || unit.Guarding || unit.Bedraggled || unit.Footing == 0)
                        {
                            <span class="pips">
                                @if (unit.Clinging)
                                {
                                    <i class="pip cling" title="Clinging"></i>
                                }
                                @if (unit.Bedraggled)
                                {
                                    <i class="pip bedraggled" title="@PlaytestText.BedraggledLabel(unit)"></i>
                                }
                                @if (unit.Guarding)
                                {
                                    <i class="pip guard" title="@(PlaytestText.GuardName + " — " + PlaytestText.GuardSummary)"></i>
                                }
                                @if (unit.Staggered)
                                {
                                    <i class="pip stagger" title="Staggered — next shove goes 1 further"></i>
                                }
                                @if (unit.Footing == 0)
                                {
                                    <i class="pip nofooting" title="No Footing left"></i>
                                }
                            </span>
                        }
                    }
                    else if (State.StructureAt(cell) is { } structure)
                    {
                        <span class="art structure" title="@PlaytestText.Structure(structure)">
                            @StructureGlyph(structure)
                        </span>
                        <span class="hp">@structure.Hp/@structure.MaxHp</span>
                    }
                    else if (Session.SpotAt(cell) is SpotState.Yours or SpotState.Open)
                    {
                        @* Every published spot carries its mark, not just the one this click would
                           take: §3 forbids fog on a list the board has already published. The two
                           states are told apart by the tile's class, not by one of them vanishing. *@
                        <span class="marker">+</span>
                    }
                    else if (Session.Targets.ContainsKey(cell))
                    {
                        <span class="marker">•</span>
                    }

                    @* Every landing says what it does to whoever arrives on it, on the tile itself —
                       "drain" is the difference between a spend and a kill. *@
                    @if (Session.CastLandings.ContainsKey(cell))
                    {
                        <span class="cone" aria-hidden="true"></span>
                        <span class="cast-outcome">@PlaytestText.CastOutcome(State, cell)</span>
                    }
                    else if (Session.RescueDestinations.ContainsKey(cell))
                    {
                        <span class="cone" aria-hidden="true"></span>
                        <span class="cast-outcome">@PlaytestText.CastOutcome(State, cell)</span>
                    }

                    @* Every tile of the route carries its own price: the running Action Point total
                       on arrival, and the surcharge in brackets where the terrain charges one. A
                       climb that costs two is not something a player should have to count. *@
                    @if (ApLabel(cell) is { Length: > 0 } price)
                    {
                        <span class="ap-tile @(IsSurcharged(cell) ? "surcharge" : string.Empty)">@price</span>
                    }

                    @* Both answers to a diagonal, drawn where the body would actually come to rest.
                       A ghost is a real token, not a marker: the question is "which of these two
                       positions do I want", and that is not a question a dot can ask
                       (MASTER_DESIGN §3, locked v). *@
                    @if (AimGhostAt(cell) is { } ghost)
                    {
                        <span class="ghost aim-@ghost.Key @(ghost.Highlighted ? "lit" : string.Empty)"
                              data-ghost="@ghost.Key"
                              title="@ghost.Text">
                            <span class="art">
                                <UnitArt Kind="ghost.Kind" Label="@ghost.Name" />
                            </span>
                        </span>
                    }

                    @* The outcome, on the tile it lands on. The board carries the prediction and the
                       sidebar supports it — an aim that only reads correctly in a sentence beside the
                       board is an aim the player has to look away to understand. *@
                    @if (MarkAt(cell) is { } mark)
                    {
                        <span class="hit @mark.Class" title="@Session.PreviewText">
                            @if (mark.Icon.Length > 0)
                            {
                                <i class="hit-icon" aria-hidden="true">@mark.Icon</i>
                            }
                            @mark.Label
                            @* The half a number cannot carry: staggered, paddling, or the reason a
                               shove moved nobody. A shove reduced to nothing used to draw no chip
                               at all, which reads on the board as the ability having no effect. *@
                            @if (mark.Note.Length > 0)
                            {
                                <i class="hit-note">@mark.Note</i>
                            }
                        </span>
                    }

                    @* Debug overlays. Internal builds only, off by default, and drawn last so they
                       sit over the paint rather than under it. *@
                    @if (View.ShowTileIds)
                    {
                        <span class="debug id">@BoardCoords.Of(cell)</span>
                    }
                    @if (View.ShowPathCosts && CostLabel(cell) is { Length: > 0 } cost)
                    {
                        <span class="debug cost">@cost</span>
                    }
                </button>
            }
        }

        @if (Sliding is { } sliding)
        {
            <div class="mover @(Animator.Placing ? "placing" : string.Empty) @(Animator.IsShaking(sliding.Id) ? "shaking" : string.Empty) team-@PlaytestText.TeamClass(sliding.Team)"
                 style="--mx: @Animator.MoverTile.X; --my: @Animator.MoverTile.Y;"
                 aria-hidden="true">
                <span class="art">
                    <UnitArt Kind="sliding.Kind" Label="@sliding.Name" />
                </span>
                <span class="hp">@sliding.Hp/@sliding.MaxHp</span>
            </div>
        }
    </div>
</div>

@code {
    private int Width => State.Board.Width;

    private int Height => State.Board.Height;

    private IReadOnlyCollection<Coord> Threat => View.ThreatTiles(State);

    /// <summary>
    /// The tiles the hovered enemy alone threatens, while the squad is being placed.
    /// </summary>
    /// <summary>Units that could reach a hanging ally this activation, from Core.</summary>
    private IReadOnlyCollection<UnitId> Rescuers
    {
        get
        {
            var ids = new List<UnitId>();

            foreach (var clinging in State.Units)
            {
                if (!clinging.Clinging || !clinging.IsAlive || !clinging.Team.IsPlayer())
                {
                    continue;
                }

                foreach (var unit in State.Units)
                {
                    if (!unit.HasActivated
                        && Pits.CanReachToRescue(State, unit, clinging)
                        && !ids.Contains(unit.Id))
                    {
                        ids.Add(unit.Id);
                    }
                }
            }

            return ids;
        }
    }

    /// <summary>The plan an enemy has on record, or null. Nothing else on this board reads intents.</summary>
    private EnemyIntent? IntentOf(Unit unit) =>
        unit.Team == Team.Enemy ? Intents.For(State, unit.Id) : null;

    /// <summary>
    /// Every tile some enemy's declared plan touches, and how loudly to draw it. One entry per tile;
    /// a tile in the singled-out enemy's plan wins over one in anybody else's, so hovering a strip
    /// card lifts that plan out of the crowd rather than adding to it (D-089's lesson).
    /// </summary>
    private IReadOnlyDictionary<Coord, bool> IntentMarks
    {
        get
        {
            var marks = new Dictionary<Coord, bool>();

            foreach (var intent in State.Intents)
            {
                bool lit = Session.Telegraphed == intent.UnitId;

                foreach (var tile in Intents.Marks(intent))
                {
                    if (!marks.TryGetValue(tile, out bool already) || (lit && !already))
                    {
                        marks[tile] = lit;
                    }
                }
            }

            return marks;
        }
    }

    /// <summary>Tiles the singled-out enemy means to strike, for the target ring.</summary>
    private IReadOnlyCollection<Coord> IntentTargets
    {
        get
        {
            var tiles = new List<Coord>();

            foreach (var intent in State.Intents)
            {
                if (Intents.TargetTile(intent) is { } tile && !tiles.Contains(tile))
                {
                    tiles.Add(tile);
                }
            }

            return tiles;
        }
    }

    private IReadOnlyCollection<Coord> HoveredThreat =>
        State.Phase == Phase.Deployment && Session.Hovered is { } at
            ? View.ThreatFrom(State, State.UnitAt(at)?.Id)
            : Array.Empty<Coord>();

    /// <summary>The unit being drawn as a sliding sprite, if there is one.</summary>
    private Unit? Sliding => Animator.Mover is { } id ? State.FindUnit(id) : null;

    /// <summary>
    /// Who is standing on a tile as far as the board is concerned. A unit mid-slide is nobody's
    /// occupant: it is already at its destination in state, and drawing it there as well as on the
    /// sprite would show it twice.
    /// </summary>
    private Unit? Occupant(Coord coord)
    {
        var unit = State.UnitAt(coord);
        return unit is not null && Animator.IsSliding(unit.Id) ? null : unit;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Animator.Changed += Redraw;
    }

    public override void Dispose()
    {
        Animator.Changed -= Redraw;
        base.Dispose();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Tags a tile with which side of the acting unit it lies on, for the cone.</summary>
    private static void AddSide(List<string> classes, Direction? side)
    {
        if (side is { } direction)
        {
            classes.Add("side-" + direction.ToString().ToLowerInvariant());
        }
    }

    private void OnCellClick(Coord coord, Unit? unit)
    {
        // Clicks are ignored while a sequence plays rather than queued: the position on screen is
        // mid-story, and a click aimed at what the player can see is not necessarily aimed at what
        // the board now is. Nothing is lost — the command was never submitted.
        if (Animator.Busy)
        {
            return;
        }

        if (IsDeployTarget(coord))
        {
            Session.Submit(Session.DeployTargets[coord]);
            return;
        }

        // A ghost or its route commits that candidate, whether or not it is the highlighted one.
        // Before Session.Targets, because a candidate can come to rest on a tile that is targetable
        // in its own right and the aim in flight owns the click.
        if (Session.AimAt(coord) is { } candidate)
        {
            Session.Submit(candidate.Command);
            return;
        }

        // A rescue in flight owns the click: the ally is already chosen, only the side is left.
        if (Session.RescueDestinations.TryGetValue(coord, out var rescue))
        {
            Session.Submit(rescue);
            return;
        }

        // An Old Rope aims twice for the same reason Cast does — who first, then which side they
        // come up on — so the first click chooses rather than commits. Everything else in the
        // pocket names a tile and is committed by Session.Targets below, like any other aim.
        if (Session.AimPocketAt(coord))
        {
            return;
        }

        // Aiming a cast takes the click first, in the order it aims: pick the enemy, then the tile.
        if (Session.AimingCast)
        {
            if (Session.CastLandings.TryGetValue(coord, out var cast))
            {
                Session.Submit(cast);
                return;
            }

            if (unit is not null && Session.CastGrabTiles.Contains(coord))
            {
                Session.AimCastAt(unit.Id);
                return;
            }
        }

        if (Session.Targets.TryGetValue(coord, out var command))
        {
            // Clicking the target itself means "the one I am looking at". Session.Aimed hands back
            // the command unchanged whenever there is no choice open.
            Session.Submit(Session.Aimed(command));
            return;
        }

        if (unit is not null && Session.Selectable.Contains(unit.Id))
        {
            // Inspect as well as select. The inspector is the single home for every unit's detail
            // now (design session 2026-08-04), so clicking a duck to command it also opens its card
            // — one gesture, one card, whoever the unit belongs to.
            Session.Inspect(unit.Id);
            Session.Select(unit.Id);
            return;
        }

        // Last, and only last: a click on a unit means "inspect" exactly when it means nothing else.
        // Acting on it always wins.
        if (unit is not null)
        {
            Session.Inspect(unit.Id);
            return;
        }

        // Empty ground reads the ground. What a drain does to whoever is shoved onto it is a rule a
        // player has to be able to look up before aiming at it, and a tooltip is not somewhere you
        // can look something up.
        Session.InspectTile(coord);
    }

    private bool IsDeployTarget(Coord coord) => Session.DeployTargets.ContainsKey(coord);

    /// <summary>The candidate whose body comes to rest on this tile, if one does.</summary>
    private AimChoice? AimGhostAt(Coord coord)
    {
        foreach (var choice in Session.AimChoices)
        {
            if (choice.Stop.Equals(coord))
            {
                return choice;
            }
        }

        return null;
    }

    /// <summary>The candidate whose route crosses this tile, if one does.</summary>
    private AimChoice? AimRouteAt(Coord coord)
    {
        foreach (var choice in Session.AimChoices)
        {
            foreach (var tile in choice.Preview.Path)
            {
                if (tile.Equals(coord))
                {
                    return choice;
                }
            }
        }

        return null;
    }

    /// <summary>
    /// Left, right and Tab flip the highlighted candidate; Enter commits it. Only while two ghosts
    /// are on the board — the keys mean nothing otherwise and must not be swallowed.
    /// </summary>
    private void OnBoardKeyDown(KeyboardEventArgs args)
    {
        if (Animator.Busy || !Session.AimChoiceOpen)
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowLeft":
            case "ArrowRight":
            case "Tab":
                Session.FlipAim();
                break;

            case "Enter":
                if (Session.HighlightedAim is { } choice)
                {
                    Session.Submit(choice.Command);
                }

                break;
        }
    }

    /// <summary>
    /// What this tile costs on the route being previewed, or empty when it is not on one. Only a
    /// walk is priced per tile — an ability's projected line is a shape, not a journey.
    /// </summary>
    private string ApLabel(Coord coord)
    {
        if (!View.RangePreview
            || Session.Mode != ActionMode.Move
            || Session.SelectedUnit is not { } unit
            || !Session.ProjectedPath.Contains(coord))
        {
            return string.Empty;
        }

        return ActionPoints.TileLabel(State, unit, coord);
    }

    /// <summary>
    /// What the aimed action would do to this tile, or null. Suppressed with the rest of the hover
    /// paint when the preview is switched off — a screenshot of the position should be the position.
    /// </summary>
    private PreviewMark? MarkAt(Coord coord)
    {
        if (!View.RangePreview)
        {
            return null;
        }

        foreach (var mark in Session.PreviewMarks)
        {
            if (mark.At.Equals(coord))
            {
                return mark;
            }
        }

        return null;
    }

    private bool IsSurcharged(Coord coord) =>
        Session.SelectedUnit is { } unit && ActionPoints.IsSurcharged(State, unit, coord);

    /// <summary>
    /// The running cost to stand on a tile, for the dev overlay. Core's answer, never added up here.
    /// </summary>
    private string CostLabel(Coord coord)
    {
        if (Session.SelectedUnit is not { } unit)
        {
            return string.Empty;
        }

        int? running = ActionPoints.RunningCost(State, unit, coord);
        return running is null
            ? string.Empty
            : running.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    // Every tile is clickable now: one that does nothing else reads its own terrain, which is a
    // rule a player has to be able to look up rather than hover for.
    private bool IsClickable(Coord coord, Unit? unit) => !Animator.Busy;

    /// <summary>
    /// Whether a click on this cell would open a dossier rather than do something. Inspection is
    /// last in <see cref="OnCellClick"/>'s ladder, so a targetable enemy is never an inspect cell.
    /// </summary>
    private bool IsInspectOnly(Coord coord, Unit? unit) =>
        GameSession.CanInspect(unit)
        && !IsDeployTarget(coord)
        && !Session.Targets.ContainsKey(coord);

    /// <summary>
    /// Which slab a structure draws as. A breakable blocker gets its own so it does not read as the
    /// fight's objective, which it is not (D-114).
    /// </summary>
    private static string StructureGlyph(Structure structure) =>
        structure.IsBlocker ? "▦" : structure.Role == ObjectiveKind.Protect ? "▣" : "▩";

    private string CellClass(Coord coord, Unit? unit)
    {
        var classes = new List<string> { "cell", EventText.TileClass(State.Board.At(coord)) };

        // The hover preview is a view, so the toggle that hides it hides only the paint.
        if (View.RangePreview)
        {
            if (Session.RangeTiles.Contains(coord))
            {
                classes.Add("in-range");
            }

            if (Session.ProjectedPath.Contains(coord))
            {
                classes.Add("projected");
            }

            // Two routes on one board have to be told apart, and the one the keyboard is on has to
            // be told apart from the other.
            if (AimRouteAt(coord) is { } route)
            {
                classes.Add("candidate");
                classes.Add("candidate-" + route.Key);

                if (route.Highlighted)
                {
                    classes.Add("candidate-lit");
                }
            }

            if (AimGhostAt(coord) is { } landing)
            {
                classes.Add("candidate-stop");
                classes.Add("candidate-" + landing.Key);
            }
        }

        if (Threat.Contains(coord))
        {
            classes.Add("threat");
        }

        // One enemy at a time, on hover, and never the union (D-089). The union covered 47 of 49
        // tiles on fight 1 — a board painted almost entirely red says only "somewhere is dangerous",
        // which is not a fact anybody can place a unit with.
        if (HoveredThreat.Contains(coord))
        {
            classes.Add("threat-from");
        }

        // Every declared plan is drawn faintly; the one whose card is hovered is drawn at full
        // opacity. Same lesson as the threat union: loud everywhere is the same as silent.
        if (IntentMarks.TryGetValue(coord, out bool lit))
        {
            classes.Add(lit ? "intent lit" : "intent");
        }

        if (IntentTargets.Contains(coord))
        {
            classes.Add("intent-target");
        }

        // Hovering a legend swatch picks out every tile of that kind.
        if (View.HighlightedTerrain is { } highlighted && State.Board.At(coord) == highlighted)
        {
            classes.Add("legend-lit");
        }

        if (Session.InspectedTile == coord)
        {
            classes.Add("read");
        }

        // Cast aims twice: who to pluck, then where to put them (D-091).
        if (Session.CastGrabTiles.Contains(coord))
        {
            classes.Add("cast-grab");
        }

        // Cast and Rescue both end in "which side of me do they end up on", so both draw the same
        // cone and differ only in colour (D-093).
        if (Session.CastLandings.ContainsKey(coord))
        {
            classes.Add("cast-land");
            AddSide(classes, Session.CastLandingSide(coord));
        }

        if (Session.RescueDestinations.ContainsKey(coord))
        {
            classes.Add("rescue-land");
            AddSide(classes, Session.RescueSide(coord));
        }

        // D-083: while an ally is over the edge, the units that could actually get to it this
        // activation are marked. Reach is Core's answer, not a guess from distance.
        if (unit is not null && Rescuers.Contains(unit.Id))
        {
            classes.Add("can-rescue");
        }

        // The tiles under the unit that is moving right now, and the ones it has already crossed.
        if (Animator.Trail.Contains(coord))
        {
            classes.Add("trail");
        }

        bool targetable = Session.Targets.ContainsKey(coord);

        if (unit is not null)
        {
            classes.Add("occupied");
            classes.Add("team-" + PlaytestText.TeamClass(unit.Team));

            if (unit.Clinging)
            {
                classes.Add("clinging");
            }

            if (unit.Bedraggled)
            {
                classes.Add("bedraggled");
            }

            if (Session.Selected == unit.Id)
            {
                classes.Add("selected");
            }

            if (targetable)
            {
                classes.Add("targetable");
            }
            else if (IsInspectOnly(coord, unit))
            {
                classes.Add("inspectable");
            }

            if (Session.Inspected == unit.Id)
            {
                classes.Add("inspected");
            }

            if (Animator.IsFlashing(unit.Id))
            {
                classes.Add("flash");
            }
        }
        else if (targetable)
        {
            classes.Add("movable");
        }

        // §3: spots are BOARD facts, drawn on their tiles from before the first pick and never
        // fogged. Open / yours-to-take / taken are three distinct states, so they are three distinct
        // classes rather than one "deploy" highlight that only appeared mid-placement. Added after
        // the unit branch, because a taken spot still has to read as a spot.
        switch (Session.SpotAt(coord))
        {
            case SpotState.Open:
                classes.Add("spot");
                classes.Add("spot-open");
                break;
            case SpotState.Yours:
                classes.Add("spot");
                classes.Add("spot-yours");
                classes.Add("deploy");
                break;
            case SpotState.Taken:
                classes.Add("spot");
                classes.Add("spot-taken");
                break;
        }

        return string.Join(" ", classes);
    }

    private string Tooltip(Coord coord, Unit? unit)
    {
        // Display names, never enum names: no user-facing string may spell an internal identifier
        // (MASTER_DESIGN §15), and the tile label a person reads is BoardCoords', not Coord's.
        string terrain = PlaytestText.Terrain(State.Board.At(coord));
        string at = BoardCoords.Of(coord);

        var spot = Session.SpotAt(coord);

        if (unit is not null)
        {
            string extra = unit.Clinging ? ", clinging"
                : unit.Bedraggled ? ", " + PlaytestText.BedraggledLabel(unit)
                : unit.Staggered ? ", staggered"
                : string.Empty;
            string inspect = IsInspectOnly(coord, unit) ? " · click to inspect" : string.Empty;

            string plan = IntentOf(unit) is { } intent
                ? " · " + Intents.Sentence(State, intent)
                : string.Empty;

            // §3: a taken spot NAMES who took it and which duck stands there. Greying it out with an
            // empty reason is the failure this codebase has hit before, so the sentence is explicit.
            string taken = spot == SpotState.Taken && Session.SpotTakenBy(coord) is { } who
                ? " · spot taken by " + who
                : string.Empty;

            return $"{unit.Name} [{EventText.Side(unit.Team)}] {unit.Hp}/{unit.MaxHp}{extra} — {terrain} {at}{taken}{plan}{inspect}";
        }

        if (State.StructureAt(coord) is { } structure)
        {
            return $"{PlaytestText.Structure(structure)} — {terrain} {at}";
        }

        if (spot is SpotState.Open or SpotState.Yours)
        {
            // The whole basis of a good pick: the ground, and what can reach it before you move.
            var reaching = Session.EnemiesReaching(coord);
            string danger = reaching.Count == 0
                ? "nothing reaches it on round 1"
                : "round 1: " + string.Join(", ", reaching);

            string offer = spot == SpotState.Yours ? "yours to take" : "open spot";

            return $"Deployment spot — {offer} · {terrain} {at} · {danger}";
        }

        return $"{terrain} {at} — {PlaytestText.TerrainWalk(State.Board.At(coord))} Click to read it.";
    }
}

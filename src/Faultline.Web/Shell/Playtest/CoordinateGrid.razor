@inherits PlaytestPanel
@inject BoardAnimator Animator
@* The board, with its column and row numbers, sized to whatever box the panel gives it. The track
   count comes off Board.Width and Board.Height, so a 7x7, a 9x7 and an 11x7 all draw correctly
   without anything here knowing which one it is.

   A unit that is mid-move is left out of its tile and drawn as the sprite at the bottom instead, so
   it can slide along the path Core reported rather than appear at the far end of it. A shoved unit
   rides the same sprite: it shudders on the tile it was standing on, then travels. Nothing here
   decides anything: the animator says which unit and which tile, the board draws it. *@

<div class="stage">
    <div class="board @(View.GridLines ? "lines" : string.Empty)"
         style="--cols: @Width; --rows: @Height; --zoom: @View.ZoomFactor; --step: @(Animator.StepMs)ms; --flash: @(Animator.FlashMs)ms; --shake: @(Animator.ShakeMs)ms; --charge: @(Animator.ChargeMs)ms;"
         @onmouseleave="() => Session.Hover(null)">
        <div class="axis corner" aria-hidden="true"></div>

        @for (int x = 0; x < Width; x++)
        {
            <div class="axis col">@x</div>
        }

        @for (int y = 0; y < Height; y++)
        {
            int row = y;
            <div class="axis row">@row</div>

            @for (int x = 0; x < Width; x++)
            {
                var cell = new Coord(x, row);
                var unit = Occupant(cell);

                <button type="button"
                        class="@CellClass(cell, unit)"
                        disabled="@(!IsClickable(cell, unit))"
                        title="@Tooltip(cell, unit)"
                        @onmouseover="() => Session.Hover(cell)"
                        @onfocus="() => Session.Hover(cell)"
                        @onclick="() => OnCellClick(cell, unit)">
                    @if (unit is not null)
                    {
                        <span class="art team-@PlaytestText.TeamClass(unit.Team)">
                            <UnitArt Kind="unit.Kind" Label="@unit.Name" />
                        </span>
                        <span class="hp">@unit.Hp/@unit.MaxHp</span>
                        @* Charges are readable without selecting anybody: one dot per point, filled
                           up to what the unit holds. Drawn for every class that can earn, so an
                           empty meter still says the class has one. *@
                        @if (Verve.SpendFor(unit.Kind) is { } spender)
                        {
                            <span class="verve @(unit.Verve >= Verve.CostOf(spender) ? "ready" : string.Empty) @(Animator.IsCharging(unit.Id) ? "ticking" : string.Empty)"
                                  title="@PlaytestText.VerveTitle(unit)">
                                @for (int v = 0; v < Verve.Cap; v++)
                                {
                                    <i class="vp @(v < unit.Verve ? "on" : string.Empty)"></i>
                                }
                            </span>
                        }
                        @if (unit.Clinging || unit.Staggered || unit.Guarding || unit.Footing == 0)
                        {
                            <span class="pips">
                                @if (unit.Clinging)
                                {
                                    <i class="pip cling" title="Clinging"></i>
                                }
                                @if (unit.Guarding)
                                {
                                    <i class="pip guard" title="@(PlaytestText.GuardName + " — " + PlaytestText.GuardSummary)"></i>
                                }
                                @if (unit.Staggered)
                                {
                                    <i class="pip stagger" title="Staggered — next shove goes 1 further"></i>
                                }
                                @if (unit.Footing == 0)
                                {
                                    <i class="pip nofooting" title="No Footing left"></i>
                                }
                            </span>
                        }
                    }
                    else if (State.StructureAt(cell) is { } structure)
                    {
                        <span class="art structure" title="@PlaytestText.Structure(structure)">
                            @(structure.Role == ObjectiveKind.Protect ? "▣" : "▩")
                        </span>
                        <span class="hp">@structure.Hp/@structure.MaxHp</span>
                    }
                    else if (IsDeployTarget(cell))
                    {
                        <span class="marker">+</span>
                    }
                    else if (Session.Targets.ContainsKey(cell))
                    {
                        <span class="marker">•</span>
                    }

                    @* Every landing says what it does to whoever arrives on it, on the tile itself —
                       "drain" is the difference between a spend and a kill. *@
                    @if (Session.CastLandings.ContainsKey(cell))
                    {
                        <span class="cast-outcome">@PlaytestText.CastOutcome(State, cell)</span>
                    }
                </button>
            }
        }

        @if (Sliding is { } sliding)
        {
            <div class="mover @(Animator.Placing ? "placing" : string.Empty) @(Animator.IsShaking(sliding.Id) ? "shaking" : string.Empty) team-@PlaytestText.TeamClass(sliding.Team)"
                 style="--mx: @Animator.MoverTile.X; --my: @Animator.MoverTile.Y;"
                 aria-hidden="true">
                <span class="art">
                    <UnitArt Kind="sliding.Kind" Label="@sliding.Name" />
                </span>
                <span class="hp">@sliding.Hp/@sliding.MaxHp</span>
            </div>
        }
    </div>
</div>

@code {
    private int Width => State.Board.Width;

    private int Height => State.Board.Height;

    private IReadOnlyCollection<Coord> Threat => View.ThreatTiles(State);

    /// <summary>
    /// The tiles the hovered enemy alone threatens, while the squad is being placed.
    /// </summary>
    /// <summary>Units that could reach a hanging ally this activation, from Core.</summary>
    private IReadOnlyCollection<UnitId> Rescuers
    {
        get
        {
            var ids = new List<UnitId>();

            foreach (var clinging in State.Units)
            {
                if (!clinging.Clinging || !clinging.IsAlive || !clinging.Team.IsPlayer())
                {
                    continue;
                }

                foreach (var unit in State.Units)
                {
                    if (!unit.HasActivated
                        && Pits.CanReachToRescue(State, unit, clinging)
                        && !ids.Contains(unit.Id))
                    {
                        ids.Add(unit.Id);
                    }
                }
            }

            return ids;
        }
    }

    private IReadOnlyCollection<Coord> HoveredThreat =>
        State.Phase == Phase.Deployment && Session.Hovered is { } at
            ? View.ThreatFrom(State, State.UnitAt(at)?.Id)
            : Array.Empty<Coord>();

    /// <summary>The unit being drawn as a sliding sprite, if there is one.</summary>
    private Unit? Sliding => Animator.Mover is { } id ? State.FindUnit(id) : null;

    /// <summary>
    /// Who is standing on a tile as far as the board is concerned. A unit mid-slide is nobody's
    /// occupant: it is already at its destination in state, and drawing it there as well as on the
    /// sprite would show it twice.
    /// </summary>
    private Unit? Occupant(Coord coord)
    {
        var unit = State.UnitAt(coord);
        return unit is not null && Animator.IsSliding(unit.Id) ? null : unit;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Animator.Changed += Redraw;
    }

    public override void Dispose()
    {
        Animator.Changed -= Redraw;
        base.Dispose();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);

    private void OnCellClick(Coord coord, Unit? unit)
    {
        // Clicks are ignored while a sequence plays rather than queued: the position on screen is
        // mid-story, and a click aimed at what the player can see is not necessarily aimed at what
        // the board now is. Nothing is lost — the command was never submitted.
        if (Animator.Busy)
        {
            return;
        }

        if (IsDeployTarget(coord))
        {
            Session.Submit(Session.DeployTargets[coord]);
            return;
        }

        // Aiming a cast takes the click first, in the order it aims: pick the enemy, then the tile.
        if (Session.AimingCast)
        {
            if (Session.CastLandings.TryGetValue(coord, out var cast))
            {
                Session.Submit(cast);
                return;
            }

            if (unit is not null && Session.CastGrabTiles.Contains(coord))
            {
                Session.AimCastAt(unit.Id);
                return;
            }
        }

        if (Session.Targets.TryGetValue(coord, out var command))
        {
            Session.Submit(command);
            return;
        }

        if (unit is not null && Session.Selectable.Contains(unit.Id))
        {
            Session.Select(unit.Id);
            return;
        }

        // Last, and only last: a click on an enemy means "inspect" exactly when it means nothing
        // else. Attacking it always wins.
        if (unit is not null)
        {
            Session.Inspect(unit.Id);
        }
    }

    private bool IsDeployTarget(Coord coord) => Session.DeployTargets.ContainsKey(coord);

    private bool IsClickable(Coord coord, Unit? unit) =>
        !Animator.Busy
        && (IsDeployTarget(coord)
            || Session.Targets.ContainsKey(coord)
            || Session.CastLandings.ContainsKey(coord)
            || Session.CastGrabTiles.Contains(coord)
            || (unit is not null && Session.Selectable.Contains(unit.Id))
            || GameSession.CanInspect(unit));

    /// <summary>
    /// Whether a click on this cell would open a dossier rather than do something. Inspection is
    /// last in <see cref="OnCellClick"/>'s ladder, so a targetable enemy is never an inspect cell.
    /// </summary>
    private bool IsInspectOnly(Coord coord, Unit? unit) =>
        GameSession.CanInspect(unit)
        && !IsDeployTarget(coord)
        && !Session.Targets.ContainsKey(coord);

    private string CellClass(Coord coord, Unit? unit)
    {
        var classes = new List<string> { "cell", EventText.TileClass(State.Board.At(coord)) };

        // The hover preview is a view, so the toggle that hides it hides only the paint.
        if (View.RangePreview)
        {
            if (Session.RangeTiles.Contains(coord))
            {
                classes.Add("in-range");
            }

            if (Session.ProjectedPath.Contains(coord))
            {
                classes.Add("projected");
            }
        }

        if (Threat.Contains(coord))
        {
            classes.Add("threat");
        }

        // One enemy at a time, on hover, and never the union (D-089). The union covered 47 of 49
        // tiles on fight 1 — a board painted almost entirely red says only "somewhere is dangerous",
        // which is not a fact anybody can place a unit with.
        if (HoveredThreat.Contains(coord))
        {
            classes.Add("threat-from");
        }

        // Cast aims twice: who to pluck, then where to put them (D-091).
        if (Session.CastGrabTiles.Contains(coord))
        {
            classes.Add("cast-grab");
        }

        if (Session.CastLandings.ContainsKey(coord))
        {
            classes.Add("cast-land");
        }

        // D-083: while an ally is over the edge, the units that could actually get to it this
        // activation are marked. Reach is Core's answer, not a guess from distance.
        if (unit is not null && Rescuers.Contains(unit.Id))
        {
            classes.Add("can-rescue");
        }

        // The tiles under the unit that is moving right now, and the ones it has already crossed.
        if (Animator.Trail.Contains(coord))
        {
            classes.Add("trail");
        }

        bool targetable = Session.Targets.ContainsKey(coord);

        if (unit is not null)
        {
            classes.Add("occupied");
            classes.Add("team-" + PlaytestText.TeamClass(unit.Team));

            if (unit.Clinging)
            {
                classes.Add("clinging");
            }

            if (Session.Selected == unit.Id)
            {
                classes.Add("selected");
            }

            if (targetable)
            {
                classes.Add("targetable");
            }
            else if (IsInspectOnly(coord, unit))
            {
                classes.Add("inspectable");
            }

            if (Session.Inspected == unit.Id)
            {
                classes.Add("inspected");
            }

            if (Animator.IsFlashing(unit.Id))
            {
                classes.Add("flash");
            }
        }
        else if (IsDeployTarget(coord))
        {
            classes.Add("deploy");
        }
        else if (targetable)
        {
            classes.Add("movable");
        }

        return string.Join(" ", classes);
    }

    private string Tooltip(Coord coord, Unit? unit)
    {
        var terrain = State.Board.At(coord).ToString();

        if (unit is not null)
        {
            string extra = unit.Clinging ? ", clinging" : unit.Staggered ? ", staggered" : string.Empty;
            string inspect = IsInspectOnly(coord, unit) ? " · click to inspect" : string.Empty;
            return $"{unit.Name} [{EventText.Side(unit.Team)}] {unit.Hp}/{unit.MaxHp}{extra} — {terrain} {coord}{inspect}";
        }

        if (State.StructureAt(coord) is { } structure)
        {
            return $"{PlaytestText.Structure(structure)} — {terrain} {coord}";
        }

        return $"{terrain} {coord}";
    }
}

@inherits PlaytestPanel
@inject PlaytestNotes Notes
@inject BoardAnimator Animator

@* One bar: who we are on the left, the state of the fight as pills in the middle, and the three
   things a player reaches for on the right. End Turn is Core's EndActivationCommand and nothing
   else — it is disabled exactly when Core offers no such command. *@

<header class="pt-header">
    <div class="brand">
        <h1 class="mark">Faultline</h1>
        <span class="sub">M3 — enemy AI</span>
    </div>

    <nav class="pills" aria-label="Fight status">
        <a class="pill link" href="battles">Battles</a>
        <a class="pill link" href="notes" title="Every playtest note, across every battle">
            Notes@(Notes.All.Count == 0 ? string.Empty : " " + Notes.All.Count)
        </a>

        @if (Session.InRun && Runs.State is { } run)
        {
            <a class="pill link run" href="campaign"
               title="The campaign run — a win advances, a loss ends it">
                Run @RunNodeNumber / @run.Campaign.Length
            </a>
        }

        <span class="pill fight" title="@Session.Fight.Id">
            #@Session.Fight.Number @Session.Fight.Name
        </span>

        @* A view, never a command: this switches the reference panel to its Battle tab and touches
           nothing Core can see, so it is offered in every phase and with an action already armed. *@
        <button type="button"
                class="pill toggle @(Session.DesignOpen ? "on" : string.Empty)"
                aria-pressed="@(Session.DesignOpen ? "true" : "false")"
                title="Why this board exists — the designer's notes for this battle"
                @onclick="Session.ToggleDesign">
            Design notes
        </button>

        @if (ShowBoard)
        {
            <span class="pill">@PlaytestText.Phase(State.Phase)</span>
            <span class="pill">Round @State.Round</span>
            <span class="pill team-@PlaytestText.TeamClass(State.ActiveTeam)">
                @PlaytestText.Team(State.ActiveTeam)
            </span>
            <span class="pill" title="Momentum, out of 6">Momentum @State.Momentum/6</span>
        }

        <span class="pill">Seed @Session.Seed</span>
    </nav>

    <div class="controls">
        <button type="button"
                class="btn"
                disabled="@(!CanUndo)"
                title="@(UndoTitle)"
                @onclick="OnUndo">
            Undo
        </button>

        <button type="button"
                class="btn"
                disabled="@Session.InRun"
                title="@(Session.InRun
                    ? "A run's seed belongs to the run, not to this fight — restart from the campaign screen."
                    : "Start this battle again on the next seed.")"
                @onclick="OnRestart">
            Restart
        </button>

        @* Disabled while the board is playing a sequence, for the same reason the tiles are: the
           position on screen is mid-story and no command leaves the screen until it has caught up. *@
        <button type="button"
                class="btn primary"
                disabled="@(Session.EndCommand is null || Animator.Busy)"
                title="@(Animator.Busy
                    ? "Wait for the board to finish showing what just happened."
                    : Session.EndCommand is null
                        ? "Nothing is activated, so there is no activation to end."
                        : "End this unit's activation.")"
                @onclick="OnEndTurn">
            End Turn
        </button>
    </div>
</header>

@code {
    /// <summary>Raised when the player asks to take the last decision back.</summary>
    [Parameter]
    public EventCallback OnUndo { get; set; }

    /// <summary>Raised when the player asks to restart the battle on the next seed.</summary>
    [Parameter]
    public EventCallback OnRestart { get; set; }

    /// <summary>Raised when the player ends the current activation.</summary>
    [Parameter]
    public EventCallback OnEndTurn { get; set; }

    private bool CanUndo => Session.InRun ? Runs.CanUndo : Session.CanUndo;

    private string UndoTitle
    {
        get
        {
            if (CanUndo)
            {
                return "Take back the last thing you did — the fight replays from its seed without it.";
            }

            if (Session.InRun)
            {
                return Runs.UndoBlockedReason ?? "There is nothing to undo yet.";
            }

            return "There is nothing to undo yet.";
        }
    }

    private int RunNodeNumber
    {
        get
        {
            var run = Runs.State;
            if (run is null)
            {
                return 0;
            }

            return run.NodeIndex < run.Campaign.Length ? run.NodeIndex + 1 : run.Campaign.Length;
        }
    }
}

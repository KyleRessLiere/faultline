@inherits PlaytestPanel

@* The meter, what fills it, and the one named thing it buys. Drawn only for a duck the player is
   commanding — an enemy holds no meter and never will.

   There is deliberately no generic "activate your charge" control. A meter with an anonymous button
   on it is a meter nobody can plan around: the whole point of the spender is that it is a named,
   priced move with a sentence attached, and that sentence is Core's. *@

@if (Unit is { } unit && Verve.SpendFor(unit.Kind) is { } spend)
{
    <div class="pt-panel pluck">
        <h2>
            @Naming.Meter
            <span class="count">@unit.Verve/@Verve.Cap</span>
        </h2>

        <div class="pt-body">
            <div class="meter @(unit.Verve >= Verve.CostOf(spend) ? "ready" : string.Empty)"
                 title="@PlaytestText.VerveTitle(unit)"
                 role="meter"
                 aria-valuenow="@unit.Verve"
                 aria-valuemin="0"
                 aria-valuemax="@Verve.Cap"
                 aria-label="@Naming.Meter">
                @for (int v = 0; v < Verve.Cap; v++)
                {
                    <i class="seg @(v < unit.Verve ? "on" : string.Empty) @(v == unit.Verve - 1 && Gained ? "gained" : string.Empty)"></i>
                }
            </div>

            @* A resource whose earning condition is not written down is a resource nobody aims for.
               Core's own words, short on the panel and whole in the tooltip. *@
            <p class="earns" title="@Verve.ConditionFor(unit.Kind)">
                Earns from @Verve.ConditionFor(unit.Kind).
            </p>

            @* The spender, as an action row with a feather badge — never an AP badge. It costs
               neither the move nor the action, and a badge that looked like the others would be a
               lie about which budget it empties.

               Built from the same ActionRows the action list is built from, so the row here and the
               rows below cannot disagree about what it is called, what it costs or why it is greyed.
               The action list skips this one kind precisely because it is drawn here. *@
            @if (Row is { } row)
            {
                <button type="button"
                        class="spender @(row.Armed ? "armed" : string.Empty) @(row.Available ? string.Empty : "short")"
                        disabled="@(!row.Available)"
                        title="@row.Effect"
                        @onclick="() => Press(spend)">
                    <span class="spender-head">
                        <span class="spender-name">@row.Name.ToUpperInvariant()</span>
                        <span class="feather" title="@row.Badge">
                            <i class="quill" aria-hidden="true">✦</i>@row.Badge
                        </span>
                    </span>
                    <span class="spender-effect">@row.Effect</span>
                    @if (row.Reason.Length > 0)
                    {
                        <span class="reason" title="@row.Hint">@row.Reason</span>
                    }
                </button>
            }

            @if (Armed(unit, spend))
            {
                <div class="armed-note" role="status">
                    <span class="armed-tag">Armed</span>
                    <span class="armed-text">@ArmedText(spend)</span>
                    <button type="button" class="cancel" @onclick="() => Cancel(spend)">Cancel</button>
                </div>
            }

            @if (Session.AimingCast)
            {
                <p class="aiming">
                    @(Session.CastTarget is null
                        ? "Click an enemy within " + Throw.GrabRange + " tiles to pluck it."
                        : "Pick a side to set them down on. Each says what the ground does.")
                </p>
            }
        </div>
    </div>
}

@code {
    /// <summary>How full the meter was last time it was drawn. -1 until the first draw.</summary>
    private int _lastVerve = -1;
    private bool _gained;

    /// <summary>Only a duck the player is commanding gets a meter panel.</summary>
    private Unit? Unit => Session.SelectedUnit is { } unit && unit.Team.IsPlayer() ? unit : null;

    /// <summary>Whether the newest segment should pulse — one redraw's worth, then it stops.</summary>
    private bool Gained => _gained;

    /// <summary>The class's one spender, as the action list models it.</summary>
    private ActionRow? Row
    {
        get
        {
            foreach (var row in ActionRows.For(Session))
            {
                if (row.Kind == ActionKind.Spend)
                {
                    return row;
                }
            }

            return null;
        }
    }

    /// <summary>
    /// Whether the spend is standing armed and waiting for the action it modifies. Read off Core's
    /// own unit flag for Wrecking Weight, and off the shell's aiming state for Cast, which aims
    /// twice.
    /// </summary>
    private bool Armed(Unit unit, VerveSpend spend) => spend switch
    {
        VerveSpend.Cast => Session.AimingCast,
        VerveSpend.WreckingWeight => unit.WreckingWeightArmed,
        _ => false,
    };

    private string ArmedText(VerveSpend spend) => spend switch
    {
        VerveSpend.Cast => "Pick the enemy, then the side you set them down on.",
        VerveSpend.WreckingWeight =>
            "Your next push carries it. Compatible actions are outlined below, and the board preview "
            + "already includes the bonus.",
        _ => "Waiting on the action it modifies.",
    };

    private void Press(VerveSpend spend)
    {
        // Cast aims — at an enemy, then at a tile — so its button arms rather than fires, like an
        // ability. Every other spend commits on the press.
        if (spend == VerveSpend.Cast)
        {
            Session.ToggleCast();
            return;
        }

        Session.SpendVerve();
    }

    private void Cancel(VerveSpend spend)
    {
        // Only an aiming state can be taken back. Wrecking Weight has already been paid for by the
        // time Core reports it armed, and the shell must not offer a refund the rules do not have.
        if (spend == VerveSpend.Cast)
        {
            Session.ToggleCast();
        }
    }

    /// <summary>
    /// A gain pulses the newest segment once and then stops. Deliberately a brief flash rather than
    /// a persistent glow: a meter that keeps announcing itself stops being read.
    /// </summary>
    protected override void OnAfterRender(bool firstRender)
    {
        int now = Unit?.Verve ?? 0;

        // The first draw establishes the baseline. Pulsing on arrival would flash the meter of every
        // duck the player merely clicked on.
        if (_lastVerve < 0 || now <= _lastVerve)
        {
            _lastVerve = now;
            return;
        }

        _lastVerve = now;
        _ = PulseAsync();
    }

    private async Task PulseAsync()
    {
        _gained = true;
        StateHasChanged();

        await Task.Delay(PulseMs);

        _gained = false;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>How long the gain pulse lasts, matched to the CSS animation.</summary>
    private const int PulseMs = 420;
}

@inherits PlaytestPanel

@* What is in the duck's one pocket, drawn beside the meter because it is the other thing this duck
   is holding that the activation's Action Point pool does not own.

   0 AP, free timing inside its own activation, one-shot (MASTER_DESIGN §8.5). The zero is on the
   badge rather than suppressed — "costs nothing" is the whole reason a player reaches for it — and
   the badge is an AP badge because that genuinely is the budget it does not empty.

   Nothing here decides whether it may be used: the row comes from ActionRows, which reads
   Consumables.Legal through the session's legal list, and pressing it submits a command Core handed
   over. An item with more than one use is *aimed on the board* — the same surface an ability, a
   cast and a rescue are aimed with. It used to be a column of coordinate buttons here, and pressing
   the item itself did nothing at all (D-136). *@

@if (Unit is { } unit && unit.Loadout.Pocket is { } item && Row is { } row)
{
    <div class="pocket">
        <p class="section-head">
            Pocket
            <span class="section-note">one-shot</span>
        </p>

        <button type="button"
                class="item @(row.Available ? string.Empty : "short") @(Session.AimingPocket ? "armed" : string.Empty)"
                disabled="@(!row.Available)"
                title="@row.Name — @row.Effect"
                @onclick="Use">
            <span class="item-head">
                <span class="item-name">@row.Name</span>
                <span class="badge ap" title="@row.Hint">@row.Badge</span>
            </span>
            <span class="item-effect">@row.Effect</span>
            @if (row.Reason.Length > 0)
            {
                <span class="reason" title="@row.Hint">@row.Reason</span>
            }
        </button>

        @* The board carries the choice; this line only says what the highlighted tiles mean. There
           is deliberately no second list of coordinates beside it — one surface for aiming, so the
           board and the sidebar can never disagree about what is on offer. *@
        @if (Session.AimingPocket)
        {
            <p class="aim">@AimText(item)</p>
            <button type="button" class="cancel" @onclick="Use">Cancel</button>
        }
    </div>
}

@code {
    /// <summary>
    /// The duck the inspector is about, when a player owns it — the same subject the meter and the
    /// action list use, so all three can never end up describing different ducks.
    /// </summary>
    private Unit? Unit =>
        ActionRows.Subject(Session) is { } unit && unit.Team.IsPlayer() ? unit : null;

    /// <summary>The pocket as the action list models it, so the row here and the rows below agree.</summary>
    private ActionRow? Row
    {
        get
        {
            foreach (var row in ActionRows.For(Session))
            {
                if (row.Kind == ActionKind.Pocket)
                {
                    return row;
                }
            }

            return null;
        }
    }

    /// <summary>
    /// Presses the item. Never a no-op: one legal use fires, several arm the board, and pressing it
    /// again while armed puts it away. <see cref="GameSession.UsePocket"/> owns all three.
    /// </summary>
    private void Use() => Session.UsePocket();

    /// <summary>What the highlighted tiles are asking for, at whichever stage the aim is at.</summary>
    private string AimText(Consumable item)
    {
        if (Session.PocketPicksWho)
        {
            return "Click whoever to haul out — they are lit on the board.";
        }

        return item switch
        {
            Consumable.OldRope => "Click the side to set them down on — lit on the board.",
            _ => "Click a lit tile on the board to place it.",
        };
    }
}

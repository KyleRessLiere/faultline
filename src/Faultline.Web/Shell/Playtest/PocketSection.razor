@inherits PlaytestPanel
@inject BattleSurfaces Surfaces

@* The pockets, at the foot of the rail. What is in one got there from a camp pick or an event
   earlier in the run (MASTER_DESIGN §8.5) — this is not a battle inventory, it is what the run
   handed this duck. An empty rail on a fresh fight is the correct picture.

   The SLOT COUNT COMES FROM DATA. A mockup drew three; three is art. PocketSlots asks the loadout
   how many pockets exist, which is one today and two the day Deep Pockets ships in Core — and this
   component grows the second slot for free rather than being edited again.

   0 AP, free timing inside its own activation, one-shot. The zero is on the badge rather than
   suppressed — "costs nothing" is the whole reason a player reaches for it.

   Nothing here decides whether an item may be used, and nothing here picks a target. Pressing an
   item ARMS it and lights its legal tiles on the board, through the same Targets map abilities,
   Cast and rescue commit through (D-136). The card below is the affordance that armed it and the
   place Cancel lives; it is deliberately not a second picker. *@

<div class="pocket">
    <p class="section-head">
        Pocket
        <span class="section-note">@SlotNote</span>
    </p>

    @if (Slots.Count == 0)
    {
        <p class="none">@NoDuckLine</p>
    }
    else
    {
        <ul class="slots">
            @foreach (var slot in Slots)
            {
                <li class="slot">
                    @if (slot.Item is { } item)
                    {
                        <button type="button"
                                class="item @StateClass(slot)"
                                disabled="@(!slot.Pressable)"
                                title="@(slot.Name + " — " + slot.Summary)"
                                @onclick="() => Press(slot)">
                            <span class="item-head">
                                <span class="item-name">@slot.Name</span>
                                <span class="badge ap" title="Free timing. It does not end the activation.">0 @ActionPoints.Label</span>
                            </span>
                            <span class="item-effect">@slot.Summary</span>
                            @if (slot.Reason.Length > 0)
                            {
                                <span class="reason" title="@slot.Hint">@slot.Reason</span>
                            }
                        </button>

                        @* The compact targeting card. It wraps the board-aiming mode rather than
                           replacing it: the board carries the choice, this says what the highlighted
                           tiles mean and offers the way out. *@
                        @if (slot.State == PocketState.Selected)
                        {
                            <div class="aim-card" role="group" aria-label="@(slot.Name + " targeting")">
                                <p class="aim">@PocketSlots.AimText(Session, item)</p>
                                <button type="button" class="cancel" @onclick="() => Press(slot)">Cancel</button>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="item empty" title="@slot.Hint">
                            <span class="item-head"><span class="item-name">Empty</span></span>
                            <span class="item-effect">@slot.Hint</span>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>
    /// The duck the rail is about: the one being commanded, or — when nothing is — the friendly duck
    /// being read. The same subject the command bar uses, so the two can never end up describing
    /// different ducks, and an ally's one-shot stays readable while somebody plans around it.
    /// </summary>
    private Unit? Duck => ActionRows.Subject(Session) is { } unit && unit.Team.IsPlayer()
        ? unit
        : null;

    private IReadOnlyList<PocketSlot> Slots => PocketSlots.For(Session, Duck);

    private string SlotNote => Slots.Count == 1
        ? "one-shot · 1 slot"
        : "one-shot · " + Slots.Count + " slots";

    private string NoDuckLine => State.Phase == Phase.Deployment
        ? "Whatever the run has given a duck rides here once it is placed."
        : "No activation open.";

    /// <summary>
    /// Presses the item. Never a no-op: one legal use fires, several arm the board, and pressing it
    /// again while armed puts it away. <see cref="GameSession.UsePocket"/> owns all three.
    /// </summary>
    private void Press(PocketSlot slot)
    {
        // Arming a one-shot is a contextual surface like any other, so it collapses the ability bar
        // and closes the inspector — one surface at a time.
        Surfaces.ShowConsumable();
        Session.UsePocket();

        if (!Session.AimingPocket)
        {
            Surfaces.Close();
        }
    }

    private static string StateClass(PocketSlot slot) => slot.State switch
    {
        PocketState.Selected => "armed",
        PocketState.Equipped => "ready",
        PocketState.NoValidTarget => "short",
        PocketState.Disabled => "short",
        _ => "empty",
    };

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Surfaces.Changed += Redraw;
    }

    public override void Dispose()
    {
        Surfaces.Changed -= Redraw;
        base.Dispose();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);
}

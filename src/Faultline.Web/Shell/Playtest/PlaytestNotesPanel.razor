@inherits PlaytestPanel
@inject PlaytestNotes Notes
@inject FightFiles Files
@implements IDisposable

@* Notes about the fight, captured with the situation they were written in. No <form> anywhere
   here: a form would make Enter submit, and a stray Enter on the board screen must never do
   anything. The keystroke handlers stop the events travelling further for the same reason. *@

<div class="pt-panel">
    <h2>
        Playtest notes
        <span class="count">@NotesForThisFight.Count on this battle</span>
    </h2>

    <div class="compose">
        <textarea class="box"
                  rows="2"
                  placeholder="What just happened? Ctrl+Enter adds it."
                  title="Ctrl+Enter (or Cmd+Enter) adds the note."
                  value="@_noteText"
                  @oninput="OnNoteInput"
                  @onkeydown="OnNoteKeyDown"
                  @onkeydown:stopPropagation="true"
                  @onkeypress:stopPropagation="true"
                  @onkeyup:stopPropagation="true"></textarea>

        <div class="tags">
            @foreach (var tag in PlaytestNotes.KnownTags)
            {
                var name = tag;
                <button type="button"
                        class="tag tag-@name @(_noteTags.Contains(name) ? "on" : string.Empty)"
                        aria-pressed="@_noteTags.Contains(name)"
                        @onclick="() => ToggleTag(name)">@name</button>
            }
        </div>

        <div class="row">
            <button type="button"
                    class="tool primary"
                    disabled="@(_noteText.Trim().Length == 0)"
                    title="Ctrl+Enter in the box does the same thing."
                    @onclick="AddNote">
                Add note
            </button>
            <a class="tool" href="notes">Review notes@(Notes.All.Count == 0 ? string.Empty : " (" + Notes.All.Count + ")")</a>
            <button type="button"
                    class="tool"
                    disabled="@(NotesForThisFight.Count == 0)"
                    title="Download this battle's notes as Markdown."
                    @onclick="ExportNotes">
                Export
            </button>
        </div>

        <p class="meta">
            @Session.Fight.Name (@Session.Fight.Id) · seed @Session.Seed · round @Session.State.Round
            · @PlaytestText.Phase(Session.State.Phase)
            · @PlaytestText.Team(Session.State.ActiveTeam) active@(Session.Recording
                ? $" · log line {Session.RecordedLineCount}"
                : string.Empty)
        </p>

        @* Where the notes are actually landing. The warning below only applies while nothing is
           logging them to disk, so it is the alternative to this row rather than a companion. *@
        <div class="row logrow">
            @if (Log.Active)
            {
                <span class="chip logging" title="@Log.Status">— logging to @Log.Folder</span>
                <button type="button" class="tool" title="Stop writing notes to that folder."
                        @onclick="StopLogging">Stop</button>
            }
            else if (Log.Supported)
            {
                <button type="button" class="tool primary" title="Pick a folder once. Every note lands in it as you write it."
                        @onclick="ChooseFolder">Log notes to a folder—</button>
            }
        </div>

        @if (Log.Active)
        {
            <p class="meta status">@Log.Status</p>
        }
        else if (Log.Supported)
        {
            <p class="meta warn">
                Notes live in this browser's localStorage and nothing is stored on a server. Pick a
                folder above and every note is written to disk as you add it.
            </p>
        }
        else
        {
            <p class="meta warn">
                Notes live in this browser's localStorage. Clearing site data deletes them, and this
                browser cannot be given a folder to write them into — <a href="notes">export them</a>
                to keep them.
            </p>
        }

        @if (_noteStatus is not null)
        {
            <p class="meta status">@_noteStatus</p>
        }
    </div>

    <div class="pt-body tight">
        @if (!Notes.Loaded)
        {
            <p class="empty">Reading browser storage…</p>
        }
        else if (NotesForThisFight.Count == 0)
        {
            <p class="empty">No notes on this battle yet.</p>
        }
        else
        {
            <ol class="notes">
                @foreach (var note in NotesForThisFight)
                {
                    var id = note.Id;
                    <li>
                        <div class="note-head">
                            <span class="context">@PlaytestNotes.Context(note)</span>
                            @foreach (var tag in note.Tags)
                            {
                                <span class="chip tag-@tag">@tag</span>
                            }
                            <button type="button"
                                    class="delete"
                                    title="Delete this note"
                                    @onclick="() => DeleteNote(id)">×</button>
                        </div>
                        <p class="text">@note.Text</p>
                    </li>
                }
            </ol>
        }
    </div>
</div>

@code {
    // The note being typed, and the tags ticked for it. Both live on the panel rather than in the
    // store: nothing is written until the playtester says so.
    private string _noteText = string.Empty;
    private readonly List<string> _noteTags = new();
    private string? _noteStatus;

    private SessionLog Log => Notes.Log;

    private IReadOnlyList<PlaytestNote> NotesForThisFight => Notes.For(Session.Fight.Id);

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Log.Changed += OnLogChanged;
    }

    /// <inheritdoc/>
    void IDisposable.Dispose()
    {
        Log.Changed -= OnLogChanged;
        Dispose();
    }

    private void OnLogChanged() => InvokeAsync(StateHasChanged);

    private Task ChooseFolder() => Log.ChooseAsync();

    private Task StopLogging() => Log.ForgetAsync();

    private void OnNoteInput(ChangeEventArgs args)
    {
        _noteText = args.Value?.ToString() ?? string.Empty;
        _noteStatus = null;
    }

    private async Task OnNoteKeyDown(KeyboardEventArgs args)
    {
        // Ctrl+Enter files the note; a bare Enter keeps writing, because a playtester mid-thought
        // types in paragraphs.
        if (args.Key == "Enter" && (args.CtrlKey || args.MetaKey))
        {
            await AddNote();
        }
    }

    private void ToggleTag(string tag)
    {
        if (!_noteTags.Remove(tag))
        {
            _noteTags.Add(tag);
        }
    }

    private async Task AddNote()
    {
        var note = await Notes.AddAsync(Session, _noteText, _noteTags);
        if (note is null)
        {
            return;
        }

        _noteText = string.Empty;
        _noteTags.Clear();

        // The note is already on disk by the time this line runs, so it says so rather than
        // suggesting there is still something to export.
        _noteStatus = Log.Active
            ? $"Logged to {Log.Folder}/{Log.LastPath} · round {note.Round} of {note.FightName}."
            : $"Saved with round {note.Round} of {note.FightName}.";
    }

    private async Task DeleteNote(string id)
    {
        await Notes.DeleteAsync(id);
        _noteStatus = null;
    }

    private async Task ExportNotes()
    {
        var outcome = await Files.DownloadAsync(
            PlaytestNotes.FileName(".md"), PlaytestNotes.RenderMarkdown(NotesForThisFight));

        _noteStatus = outcome.StartsWith("downloaded:", StringComparison.Ordinal)
            ? $"Exported {NotesForThisFight.Count} notes as {outcome.Substring(11)}."
            : "Export failed: " + outcome;
    }
}

@inherits PlaytestPanel
@* The unit under the cursor of the game, and the actions it can aim. Every action offered here is
   one Core listed as legal — IsAvailable asks the session, which asks StepResult.LegalNext. *@

<div class="pt-panel">
    <h2>Selected unit</h2>

    <div class="pt-body">
        @if (Session.SelectedUnit is { } unit)
        {
            <div class="head">
                <span class="art team-@PlaytestText.TeamClass(unit.Team)">
                    <UnitArt Kind="unit.Kind" Label="@unit.Name" />
                </span>
                <span class="ident">
                    <strong class="name">@unit.Name</strong>
                    <span class="side team-@PlaytestText.TeamClass(unit.Team)">
                        @PlaytestText.Team(unit.Team)
                    </span>
                </span>
            </div>

            <dl class="stats">
                <div><dt>HP</dt><dd>@PlaytestText.Hp(unit)</dd></div>
                <div><dt>Move</dt><dd>@unit.Move</dd></div>
                <div><dt>Range</dt><dd>@PlaytestText.Reach(unit)</dd></div>
                <div><dt>Footing</dt><dd>@unit.Footing</dd></div>
            </dl>

            <ul class="halves">
                <li class="@(unit.HasMoved ? "spent" : string.Empty)">Move</li>
                <li class="@(unit.HasActed ? "spent" : string.Empty)">Action</li>
            </ul>

            @* The meter, and — in Core's own words, never retyped here — what fills it. A resource
               whose earning condition is not written down is a resource nobody aims for. *@
            @if (Verve.SpendFor(unit.Kind) is { } spender)
            {
                <div class="verve-row" title="@PlaytestText.VerveTitle(unit)">
                    <span class="verve-label">Verve</span>
                    <span class="verve @(unit.Verve >= Verve.CostOf(spender) ? "ready" : string.Empty)">
                        @for (int v = 0; v < Verve.Cap; v++)
                        {
                            <i class="vp @(v < unit.Verve ? "on" : string.Empty)"></i>
                        }
                    </span>
                    <span class="verve-count">@unit.Verve/@Verve.Cap</span>
                </div>
                <p class="verve-earn">Earns from @Verve.ConditionFor(unit.Kind).</p>
            }

            @if (PlaytestText.Flags(unit) is { Length: > 0 } flags)
            {
                <p class="status">@flags</p>
            }

            @* A spend costs neither half of the activation, so it sits apart from the action row
               rather than inside it. Offered only when Core lists it: the button cannot exist for a
               spend the rules would refuse. *@
            @if (Verve.SpendFor(unit.Kind) is { } spend)
            {
                <button type="button"
                        class="spend"
                        disabled="@(!Session.CanSpendVerve)"
                        title="@Verve.DescriptionOf(spend)"
                        @onclick="Session.SpendVerve">
                    <span class="spend-name">@Verve.NameOf(spend)</span>
                    <span class="cost @(unit.Verve >= Verve.CostOf(spend) ? "afford" : string.Empty)">
                        @Verve.CostOf(spend)
                    </span>
                    <span class="spend-effect">@Verve.DescriptionOf(spend)</span>
                </button>
            }

            <div class="actions">
                @foreach (var option in ActionOptions())
                {
                    <button type="button"
                            class="mode @(IsOn(option) ? "on" : string.Empty)"
                            disabled="@(!option.Available)"
                            @onclick="() => Arm(option)">
                        <span class="mode-name">@option.Name</span>
                        <span class="mode-effect">@option.Effect</span>
                    </button>
                }
            </div>

            @if (Session.Mode == ActionMode.Ability && Session.ArmedDescriptor is { } armed)
            {
                <p class="rules">@armed.Summary</p>

                @* A stance aims at nothing, so there is no tile to click. It gets its own confirm
                   button rather than firing off the arming click, so choosing it and spending it stay
                   two separate decisions like every other action here. *@
                @if (Session.SelfAbilityCommand is { } stance)
                {
                    <button type="button" class="commit" @onclick="() => Session.Submit(stance)">
                        Use @armed.Name
                    </button>
                }
            }

            <p class="preview @(PreviewText is null ? "idle" : string.Empty)">
                @(PreviewText ?? IdleText)
            </p>
        }
        else
        {
            <p class="empty">Select a unit to inspect it.</p>
        }
    </div>
</div>

@code {
    /// <summary>
    /// One button in the action row. <paramref name="Ability"/> is set only for an ability, because a
    /// unit may bring several and the mode alone no longer says which one a button arms.
    /// </summary>
    private sealed record ActionOption(
        ActionMode Mode, string Name, string Effect, bool Available, Ability? Ability = null);

    private bool IsOn(ActionOption option) =>
        Session.Mode == option.Mode && Session.ArmedAbility == option.Ability;

    private void Arm(ActionOption option)
    {
        if (option.Ability is { } ability)
        {
            Session.SetAbility(ability);
            return;
        }

        Session.SetMode(option.Mode);
    }

    /// <summary>The outcome sentence, or nothing when the preview is switched off.</summary>
    private string? PreviewText => View.RangePreview ? Session.PreviewText : null;

    private string IdleText => View.RangePreview
        ? "Hover a highlighted tile to see what it does."
        : "Range preview is off — turn it back on under the board.";

    private IEnumerable<ActionOption> ActionOptions()
    {
        var unit = Session.SelectedUnit;
        if (unit is null)
        {
            yield break;
        }

        yield return new ActionOption(
            ActionMode.Move, "Move", $"up to {unit.Move} MP", Session.IsAvailable(ActionMode.Move));

        var template = unit.Template;
        if (template.Attack != AttackKind.None)
        {
            string reach = template.Attack == AttackKind.Melee ? "melee" : $"range {template.Range}";
            string effect = $"{reach} · {template.Damage} dmg";
            if (template.AttackPush > 0)
            {
                effect += $" · push {template.AttackPush}";
            }

            yield return new ActionOption(
                ActionMode.Attack, "Attack", effect, Session.IsAvailable(ActionMode.Attack));
        }

        if (template.CanPullWithBasic)
        {
            yield return new ActionOption(
                ActionMode.Pull,
                "Pull",
                $"range {template.Range} · pull {template.BasicPull}",
                Session.IsAvailable(ActionMode.Pull));
        }

        // One button per ability the archetype brings, not one button called "the ability": the
        // Wardbearer has two and the player has to be able to say which of them is being aimed.
        foreach (var ability in Session.SelectedAbilities)
        {
            bool usable = ability.Targeting != AbilityTargeting.Passive
                && Session.IsAbilityAvailable(ability.Ability);

            yield return new ActionOption(
                ActionMode.Ability, ability.Name, ability.Effect, usable, ability.Ability);
        }

        if (Session.IsAvailable(ActionMode.Rescue))
        {
            yield return new ActionOption(ActionMode.Rescue, "Rescue", "whole activation", true);
        }

        if (Session.IsAvailable(ActionMode.Finish))
        {
            yield return new ActionOption(ActionMode.Finish, "Finish", "free action", true);
        }
    }
}

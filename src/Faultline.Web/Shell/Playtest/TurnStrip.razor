@inherits PlaytestPanel

@* The activation order, published (D-103), as a row of portrait cards above the board. Intents have
   always said *what* each enemy will do and nothing has ever said *when* — and "does the Anchor
   swing before or after my Wardbearer?" is the most decision-relevant fact on the board.

   Every scrap of order logic is Core's: StripCards reads TurnOrder.Upcoming and this draws it.

   One band, the same height, in both phases. Deployment shows the squad instead of the order and
   carries its one instruction line inside the band — the alternative was two stacked text panels
   above the board saying between them what one muted line says, paid for out of the board's height.

   Three rows per card and no more — portrait, "who · side", then the numbers and the badge on one
   line. The band is the board's neighbour and the board is height-limited, so a fourth row is a row
   taken off the only thing on the screen anybody is looking at.

   Clicking a card *reads* it and never gives an order. Friendly activation happens by clicking the
   duck on the board, and the caption below says so — a control that changes meaning depending on
   whose card it is would be the opposite of a tutorial. *@

<div class="strip-bar @(Deploying ? "deploying" : string.Empty)">
    <div class="now team-@PlaytestText.TeamClass(State.ActiveTeam)">
        <span class="round">@RoundLabel</span>
        <span class="actor">@ActorLabel</span>
    </div>

    @if (Cards.Count == 0)
    {
        <p class="strip-empty">@EmptyText</p>
    }
    else
    {
        <ol class="strip" aria-label="Activation order">
            @foreach (var card in Cards)
            {
                @if (card.RoundSeam)
                {
                    <li class="seam" aria-label="@($"Round {card.Round} begins")">
                        <span class="seam-label">R@(card.Round)</span>
                        @if (card.ReinforcementsDue)
                        {
                            @* Waves land at round start before intents (D-037). Where an arrival
                               belongs in the order is undecided (MASTER_DESIGN §14), so this says the
                               round is not the whole story and claims nothing about position. *@
                            <span class="wave" title="A reinforcement wave lands at the start of this round. Its place in the order is not yet decided.">+wave</span>
                        }
                    </li>
                }

                <li class="card @StripCards.Class(card.State) team-@PlaytestText.TeamClass(card.Team)">
                    <button type="button"
                            class="face"
                            disabled="@(!card.IsNamed)"
                            title="@Title(card)"
                            @onclick="() => Read(card)"
                            @onmouseover="() => Session.Telegraph(TelegraphOf(card))"
                            @onfocus="() => Session.Telegraph(TelegraphOf(card))"
                            @onmouseout="() => Session.Telegraph(null)"
                            @onblur="() => Session.Telegraph(null)">
                        <span class="seq">@card.Sequence</span>

                        @* An open slot is drawn *open* (MASTER_DESIGN §3): every un-activated duck
                           that could take it, as overlapping minis. Prose was the wrong instrument —
                           "Wardbearer or A…" is the two facts a portrait carries for free, clipped
                           down to neither of them. One candidate is not a choice, so it resolves to
                           the plain portrait and no stack is drawn. The names stay on the hover. *@
                        @if (Portraits(card) is { Count: > 0 } faces)
                        {
                            <span class="art @(faces.Count > 1 ? "stack" : string.Empty)">
                                @foreach (var face in faces)
                                {
                                    <span class="mini">
                                        <UnitArt Kind="face.Kind" Label="@face.Name" />
                                    </span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="art">
                                <span class="slot-mark">?</span>
                            </span>
                        }

                        <span class="who">@Ident(card)</span>

                        @* Numbers and badge share the last line. They are each two or three
                           characters wide and the band has width to spare and none to spare
                           vertically. *@
                        <span class="meta">
                            @if (card.Unit is { } body)
                            {
                                <span class="hp">@body.Hp/@body.MaxHp</span>

                                @* Resource pips: one per point of the meter for a class that holds
                                   one, so a reader can see a spender coming without selecting
                                   anybody. *@
                                @if (Verve.SpendFor(body.Kind) is { } spender)
                                {
                                    <span class="pips @(body.Verve >= Verve.CostOf(spender) ? "ready" : string.Empty)"
                                          title="@PlaytestText.VerveTitle(body)">
                                        @for (int v = 0; v < Verve.Cap; v++)
                                        {
                                            <i class="pip @(v < body.Verve ? "on" : string.Empty)"></i>
                                        }
                                    </span>
                                }
                            }

                            @* One badge slot, and what fills it depends on what the card is. A gap
                               says why it is a gap; an enemy says what it means to do; a spent slot
                               says it is spent. Never all three, and never nothing. *@
                            @if (card.Skip != ActivationSkip.None)
                            {
                                <span class="badge gap">@StripCards.GapLabel(card.Skip)</span>
                            }
                            else if (card.State == StripState.Defeated)
                            {
                                <span class="badge out">out</span>
                            }
                            else if (card.State == StripState.Done)
                            {
                                <span class="badge done" aria-label="@(Deploying ? "Placed" : "Activation spent")">✓</span>
                            }
                            else if (card.Intent != IntentCategory.None)
                            {
                                <span class="badge intent @Intents.Class(card.Intent)"
                                      aria-label="@card.IntentText">@Intents.Glyph(card.Intent)</span>
                            }
                            else if (card.IsCurrent)
                            {
                                <span class="badge now">@(Deploying ? "next" : "now")</span>
                            }
                        </span>
                    </button>
                </li>
            }
        </ol>
    }

    <p class="caption">@Caption</p>
</div>

@code {
    /// <summary>True while the squads are still being put down.</summary>
    private bool Deploying => State.Phase == Phase.Deployment;

    private IReadOnlyList<StripCard> Cards => Deploying
        ? StripCards.Deployment(State, Session.PendingDeployUnit)
        : StripCards.Build(State);

    /// <summary>
    /// The portraits a card draws: the one unit it names, or — for a slot the player has not filled
    /// yet — every un-activated duck that could take it. A slot down to a single candidate has
    /// resolved itself and draws exactly one, which is why nothing here counts candidates.
    /// </summary>
    /// <param name="card">Card to draw.</param>
    /// <returns>The units to draw, in order. Empty only when the slot has no candidate at all.</returns>
    public static IReadOnlyList<Unit> Portraits(StripCard card) =>
        card.Unit is { } unit ? new[] { unit } : card.Candidates;

    /// <summary>
    /// The card's one identity line: who, then which side, on a single row. Two rows said the same
    /// thing and cost the board one row of height on every card in the band.
    /// </summary>
    /// <param name="card">Card to label.</param>
    /// <returns>Something of the shape <c>Vanguard · A</c>, or <c>A slot</c> for an open one.</returns>
    public static string Ident(StripCard card) =>
        card.Unit is { } unit ? unit.Name + " · " + Owner(card.Team) : Owner(card.Team) + " slot";

    /// <summary>
    /// The side, at card width. The full "Player A" is what the hover and every panel with room for
    /// it says; a 62px card says the letter and lets its border colour carry the rest.
    /// </summary>
    private static string Owner(Team team) => team switch
    {
        Team.PlayerA => "A",
        Team.PlayerB => "B",
        _ => "Enemy",
    };

    /// <summary>What the band is counting: a round, or the placements before the first one.</summary>
    private string RoundLabel => Deploying ? "Deployment" : "Round " + State.Round;

    private string ActorLabel => Deploying
        ? PlaytestText.Team(State.ActiveTeam).ToUpperInvariant() + " PLACES"
        : PlaytestText.Team(State.ActiveTeam).ToUpperInvariant() + " TO ACT";

    /// <summary>
    /// The one instruction line, inside the band. During deployment it is what to click and what the
    /// hover is for — the two things a player needs before the first placement, and the reason
    /// neither needs a panel of its own above the board.
    /// </summary>
    private string Caption => Deploying
        ? "Click a highlighted deployment tile in your corner. Hover an enemy to see everywhere it could reach on round 1."
        : "Clicking a card reads it. It never gives an order — select on the board.";

    private string EmptyText => Deploying
        ? "Nobody left to place."
        : "No activations left to publish.";

    /// <summary>
    /// Inspect always; select as well when this is a unit the active player may actually command.
    /// The two are deliberately not merged: inspection is universal and read-only, selection is
    /// gated on whose slot it is, and where a clicked card is one you may command both fire — that
    /// coincidence is not a licence to merge them (D-103).
    /// </summary>
    private void Read(StripCard card)
    {
        if (card.UnitId is not { } id)
        {
            return;
        }

        Session.Inspect(id);

        if (Session.Selectable.Contains(id))
        {
            Session.Select(id);
        }
    }

    /// <summary>Which enemy's telegraph a hover singles out on the board, or none.</summary>
    private static UnitId? TelegraphOf(StripCard card) =>
        card.Unit is { Team: Team.Enemy } enemy ? enemy.Id : null;

    private string Candidates(StripCard card)
    {
        var names = new List<string>();
        foreach (var unit in card.Candidates)
        {
            names.Add(unit.Name);
        }

        return names.Count == 0 ? "—" : PlaytestText.Names(names);
    }

    private string Title(StripCard card)
    {
        if (card.Unit is not { } unit)
        {
            return $"{PlaytestText.Team(card.Team)}'s slot in round {card.Round}. "
                + $"Either of {Candidates(card)} may take it — that choice is the player's, so the order cannot name one.";
        }

        // Deployment says where a duck is, not what it is about to do: there is no order yet, and a
        // card that claimed one would be publishing a fact the game does not have.
        if (Deploying)
        {
            return card.State switch
            {
                StripState.Current => $"{unit.Name} — the next placement puts this one down.",
                StripState.Done => $"{unit.Name} is placed, at {BoardCoords.Of(unit.Position)}.",
                _ => $"{unit.Name} is still to be placed.",
            };
        }

        // The whole intent sentence, not the badge's glyph: the badge says where to look and this
        // says what is coming, for how much, and to whom.
        if (card.IntentText.Length > 0)
        {
            return $"{unit.Name} — {card.IntentText}. Click to read it.";
        }

        return card.State switch
        {
            StripState.Recovering when card.Skip == ActivationSkip.Bedraggled =>
                $"{unit.Name} is bedraggled and takes no activation this round — its side has one fewer. "
                + "It is an ordinary unit otherwise: it can be hit, shoved and swept. Click to read it.",
            StripState.Recovering =>
                $"{unit.Name} is clinging and takes no activation — its side has one fewer this round. Click to read it.",
            StripState.Defeated => $"{unit.Name} is off the board. Click to read it.",
            StripState.Done => $"{unit.Name} has already activated this round. Click to read it.",
            StripState.Current => $"{unit.Name} — acting now. Click to read it.",
            _ => $"{unit.Name} — round {card.Round}. Click to read it.",
        };
    }
}

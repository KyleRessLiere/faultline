@inherits PlaytestPanel
@inject ActionSpotlight Spotlight
@inject BoardAnimator Animator
@inject BattleSurfaces Surfaces

@* The command bar: one card per action of the active duck, along the bottom of the screen.

   Every card comes from AbilityCards, which comes from ActionRows, which reads Core's legal list and
   Core's cost table. Nothing here decides what is legal or what anything costs.

   Cards show FINAL values — the price this duck actually pays with its mods fitted, not the price
   the design printed. The base is in the tooltip, because "why is this 2" is a question a player asks
   once and needs answered.

   Nothing is filtered out for being unhelpful. A Bull Rush down an empty lane is a legal three-tile
   reposition and it keeps its card: the game does not decide what is useful.

   Clicking a card expands exactly ONE card upward and compresses its neighbours. It never resizes
   the board — the bar has a fixed default height and the expanded card grows into the bar's own
   allowance. A card that pushed the board up would be a card that cost the position tiles. *@

<div class="bar @(Expanded is null ? string.Empty : "has-expanded")">
    @if (Cards.Count == 0)
    {
        <p class="bar-idle">@IdleLine</p>
    }
    else
    {
        @if (Locked)
        {
            <p class="locked" role="status">@LockedText</p>
        }

        <div class="cards">
            @foreach (var card in Cards)
            {
                var row = card.Row;
                var open = IsExpanded(card);

                <div class="card @CardClass(card) @(open ? "open" : string.Empty)">
                    <button type="button"
                            class="face"
                            disabled="@(!row.Available || Locked)"
                            title="@Title(card)"
                            @onclick="() => Press(card)"
                            @onmouseover="() => Spotlight.Highlight(HoverCost(row))"
                            @onfocus="() => Spotlight.Highlight(HoverCost(row))"
                            @onmouseout="Spotlight.Clear"
                            @onblur="Spotlight.Clear">

                        <span class="card-head">
                            <i class="icon" aria-hidden="true">@card.Icon</i>
                            <span class="card-name">@row.Name</span>

                            @* AP blue, Pluck a purple feather, and never both on one card: a Pluck
                               spender has no Action Point price and a badge implying one would be a
                               lie about which budget it empties (§7.5's cost-badge law). *@
                            @if (row.CostKind != CostKind.None)
                            {
                                <span class="badge @row.BadgeClass" title="@BadgeTitle(card)">
                                    @if (row.CostKind == CostKind.Pluck)
                                    {
                                        <i class="quill" aria-hidden="true">✦</i>
                                    }
                                    @row.Badge
                                </span>
                            }
                        </span>

                        <span class="card-effect">@card.Effect</span>

                        @if (row.Reason.Length > 0)
                        {
                            <span class="reason">@row.Reason</span>
                        }

                        @* Three sockets, two fillable, the third drawn locked. Rendered on the face so
                           a player can see what a spender is carrying without opening anything. *@
                        @if (card.HasSockets)
                        {
                            <span class="sockets">
                                @foreach (var socket in card.Sockets)
                                {
                                    <span class="socket @(socket.Locked ? "locked" : string.Empty) @(socket.Fitted is null ? "empty" : "filled")"
                                          title="@SocketTitle(socket)">
                                        @(socket.Locked ? "🔒" : socket.Fitted is null ? "＋" : socket.Name)
                                    </span>
                                }
                            </span>
                        }
                    </button>

                </div>
            }
        </div>

        @* The expanded half, drawn UPWARD and OUT OF FLOW: it hangs above the bar over the board's
           bottom margin rather than growing the bar into the position. It cost the board 106px when
           it grew the bar, and a card nobody dares open because opening it shrinks the board is a
           card that may as well not expand. *@
        @if (Opened is { } detail)
        {
            <div class="detail" role="group" aria-label="@(detail.Row.Name + " detail")">
                <p class="detail-head">
                    <span class="detail-name">@detail.Row.Name</span>
                    @if (detail.Row.CostKind != CostKind.None)
                    {
                        <span class="badge @detail.Row.BadgeClass">
                            @if (detail.Row.CostKind == CostKind.Pluck)
                            {
                                <i class="quill" aria-hidden="true">✦</i>
                            }
                            @detail.Row.Badge
                        </span>
                    }
                    <button type="button" class="fold" aria-label="Fold the card back" @onclick="Surfaces.Close">✕</button>
                </p>

                @if (detail.BaseNote.Length > 0)
                {
                    <p class="base-note">@detail.BaseNote</p>
                }

                @if (detail.Row.Hint.Length > 0)
                {
                    <p class="hint-line">@detail.Row.Hint</p>
                }

                @if (detail.Row.Ability is { } ability)
                {
                    <p class="rules">@AbilityDescriptor.For(ability).Summary</p>
                }

                @if (detail.HasSockets)
                {
                    <ul class="socket-list">
                        @foreach (var socket in detail.Sockets)
                        {
                            <li class="@(socket.Locked ? "locked" : string.Empty)">
                                <span class="socket-name">
                                    @(socket.Fitted is null ? "Slot " + (socket.Index + 1) : socket.Name)
                                </span>
                                <span class="socket-text">@(socket.Fitted is null ? socket.Note : socket.Summary)</span>
                            </li>
                        }
                    </ul>
                }

                @if (Session.AimingRescue && detail.Row.Kind == ActionKind.Rescue)
                {
                    <p class="rules">Pick a side to set them down on — any open tile beside you.</p>
                }
            </div>
        }

        <div class="bar-foot">
            @* A stance aims at nothing, so there is no tile to click. It gets its own confirm button
               rather than firing off the arming click, so choosing it and spending it stay two
               separate decisions like every other action here. *@
            @if (Session.SelfAbilityCommand is { } stance && Session.ArmedDescriptor is { } armed)
            {
                <button type="button" class="commit" disabled="@Locked" @onclick="() => Session.Submit(stance)">
                    Use @armed.Name
                </button>
            }

            @* Cancel exists for every aimed action, not only the ones with a second stage: an armed
               action the player changed their mind about should not have to be un-armed by finding
               some other button to press. *@
            @if (Aiming)
            {
                <button type="button" class="cancel" @onclick="Cancel">Cancel</button>
            }

            @if (Session.Mode == ActionMode.Ability && Session.ArmedDescriptor is { } aiming)
            {
                <span class="rules">@aiming.Summary</span>
            }

            @* The hover preview stays, and it is the one line on this bar that is not chrome: it is
               where a move's per-tile Action Point cost and an ability's predicted outcome are read
               BEFORE committing, which is rules-critical UI (CLAUDE.md), not polish.

               The "3 AP left — move or pick an action" summary that used to sit beside it is gone.
               Action Points have one home now and it is the inspector; a sentence here would have
               been a second one, and two places to read a budget is two places to disagree. *@
            @if (Commandable)
            {
                <span class="preview @(PreviewText is null ? "idle" : string.Empty)">@(PreviewText ?? IdleText)</span>
            }
        </div>
    }
</div>

@code {
    /// <summary>Every card for the active duck, Move leftmost.</summary>
    private IReadOnlyList<AbilityCard> Cards => AbilityCards.For(Session);

    private Ability? Expanded =>
        Surfaces.IsOpen(ContextualSurface.Ability) ? Surfaces.ExpandedAbility : null;

    private bool IsExpanded(AbilityCard card) =>
        card.Row.Ability is { } ability && Expanded == ability;

    /// <summary>The one card whose detail is up, or null when none is.</summary>
    private AbilityCard? Opened
    {
        get
        {
            foreach (var card in Cards)
            {
                if (IsExpanded(card))
                {
                    return card;
                }
            }

            return null;
        }
    }

    /// <summary>Whether Core will take orders for the subject right now.</summary>
    private bool Commandable => ActionRows.IsCommandable(Session);

    private string IdleLine => State.Phase == Phase.Deployment
        ? "Place your squad first — a duck's actions arrive with its activation."
        : "Click one of your ducks on the board to open its activation.";

    /// <summary>
    /// Whether controls are locked. Same rule the board's tiles keep: no command leaves this screen
    /// while a sequence is playing, none leaves it once the activation has been closed, and none
    /// leaves it at all for a duck that is only being read.
    /// </summary>
    private bool Locked =>
        Animator.Busy || !Commandable || (Session.SelectedUnit is { } unit && unit.HasActed);

    /// <summary>Which lock it is, named. A greyed bar with no sentence on it teaches nothing.</summary>
    private string LockedText
    {
        get
        {
            if (Animator.Busy)
            {
                return "The board is still showing what just happened.";
            }

            if (!Commandable)
            {
                return "Not your activation — this is a read of the kit, not a hand on it.";
            }

            return "Activation spent — nothing left to give this one.";
        }
    }

    private bool Aiming =>
        Session.AimingCast || Session.AimingRescue || Session.AimingPocket
        || (Session.Mode == ActionMode.Ability && Session.ArmedAbility is not null);

    /// <summary>The outcome sentence, or nothing when the preview is switched off.</summary>
    private string? PreviewText => View.RangePreview ? Session.PreviewText : null;

    private string IdleText => View.RangePreview
        ? "Hover a highlighted tile to see what it does."
        : "Range preview is off — turn it back on under the board.";

    /// <summary>Only an Action Point price drains the pip row; a meter spend leaves it alone.</summary>
    private static int? HoverCost(ActionRow row) =>
        row.CostKind == CostKind.ActionPoints ? row.Cost : null;

    private void Press(AbilityCard card)
    {
        Spotlight.Clear();
        var row = card.Row;

        // Expanding is a contextual surface, so it closes the inspector and anything else that was
        // open. Only an ability can expand: a Move or a Wait has nothing behind its face.
        if (row.Ability is { } ability)
        {
            Surfaces.ToggleAbility(ability);
            Session.SetAbility(ability);
            return;
        }

        Surfaces.Close();

        switch (row.Kind)
        {
            case ActionKind.Wait when Session.EndCommand is { } end:
                Session.Submit(end);
                return;

            case ActionKind.Spend when row.Spend == VerveSpend.Cast:
                Session.ToggleCast();
                return;

            case ActionKind.Spend:
                Session.SpendVerve();
                return;

            // A rescue picks a side afterwards, so its button arms rather than fires — the board
            // draws the cone and the click on it commits (D-093).
            case ActionKind.Rescue when row.Clinging is { } clinging:
                Session.ToggleRescue(clinging);
                return;
        }

        Session.SetMode(row.Mode);
    }

    private void Cancel()
    {
        // Back to walking, which is where an activation starts. Nothing has been submitted, so there
        // is nothing to take back in Core — only the aim.
        if (Session.AimingCast)
        {
            Session.ToggleCast();
        }

        if (Session.RescueTarget is { } target)
        {
            Session.ToggleRescue(target);
        }

        Session.ClearPocketAim();
        Session.SetMode(ActionMode.Move);
        Surfaces.Close();
    }

    private string CardClass(AbilityCard card)
    {
        var classes = new List<string> { card.Row.Kind.ToString().ToLowerInvariant() };

        if (card.Row.Armed)
        {
            classes.Add("armed");
        }

        if (!card.Row.Available)
        {
            classes.Add("blocked");
        }

        // A push that the armed spend would carry is outlined, so "which of these does my charge
        // apply to" is answered on the cards rather than in the rules text.
        if (Carries(card.Row))
        {
            classes.Add("carried");
        }

        return string.Join(" ", classes);
    }

    /// <summary>
    /// Whether an armed Wrecking Weight would ride on this card. Read off the unit's own flag and the
    /// row's push, never re-derived: what a spend modifies is a rule and it is Core's.
    /// </summary>
    private bool Carries(ActionRow row)
    {
        if (Session.SelectedUnit is not { WreckingWeightArmed: true } unit)
        {
            return false;
        }

        if (row.Ability is { } ability)
        {
            return AbilityDescriptor.For(ability).Push > 0;
        }

        return row.Mode == ActionMode.Attack && unit.Template.AttackPush > 0;
    }

    private static string BadgeTitle(AbilityCard card) =>
        card.BaseNote.Length > 0 ? card.Row.Badge + " — " + card.BaseNote : card.Row.Badge;

    private static string SocketTitle(ModSocket socket) =>
        socket.Fitted is null
            ? socket.Note
            : socket.Name + " — " + socket.Summary;

    private string Title(AbilityCard card)
    {
        string text = card.Row.Reason.Length > 0
            ? card.Row.Name + " — " + card.Row.Reason + ". " + card.Effect
            : card.Row.Name + " — " + card.Effect;

        return card.BaseNote.Length > 0 ? text + " (" + card.BaseNote + ")" : text;
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Animator.Changed += Redraw;
        Surfaces.Changed += Redraw;
    }

    public override void Dispose()
    {
        Animator.Changed -= Redraw;
        Surfaces.Changed -= Redraw;
        base.Dispose();
    }

    private void Redraw() => _ = InvokeAsync(StateHasChanged);
}

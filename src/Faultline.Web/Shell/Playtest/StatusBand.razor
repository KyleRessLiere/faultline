@inherits PlaytestPanel

@* A slim band under the turn strip, for the two or three things that are true of the whole board
   rather than of any one unit: somebody is over the edge, somebody is coming back bedraggled, the
   fight has ended, the run wants an answer.

   It reserves no space when it has nothing to say — an always-present strip teaches a player to
   stop reading it, which is exactly the wrong habit for the one line that can cost a duck.

   It does NOT say whose turn it is, which round it is, what the acting unit has left, or who is
   being placed. Those live in the turn-order strip and the action list now (D-103); two places
   answering "who is next" is how they end up disagreeing, and during deployment the two answers were
   costing the board two stacked bands of its height. *@

@if (HasContent)
{
    <div class="band">
        @if (ShowResolution && Runs.State is { } run)
        {
            @if (Resolution is { } resolved)
            {
                <div class="block resolved">
                    <p class="outcome @(resolved.Outcome == FightOutcome.Won ? "won" : "lost")">
                        @(resolved.Outcome == FightOutcome.Won
                            ? $"Fight won on round {resolved.Round}."
                            : $"Fight lost on round {resolved.Round}.")
                    </p>

                    <h3>Carried out</h3>
                    <ul class="carried">
                        @foreach (var carried in Runs.LastEvents.OfType<UnitCarried>())
                        {
                            <li class="@(carried.Status == RunUnitStatus.Voided ? "voided" : carried.Status == RunUnitStatus.Downed ? "downed" : string.Empty)">
                                <span class="art">
                                    <UnitArt Kind="carried.Kind" Label="@Naming.Of(carried.Kind)" />
                                </span>
                                <strong>@Naming.Of(carried.Kind)</strong>
                                @if (carried.Status == RunUnitStatus.Voided)
                                {
                                    <span class="badge voided">voided — gone for the run</span>
                                }
                                else if (carried.Status == RunUnitStatus.Downed)
                                {
                                    <span class="badge downed">downed — returns bedraggled on @carried.FieldingHp/@carried.MaxHp, no round-1 slot</span>
                                }
                                else
                                {
                                    <span class="badge">@carried.Hp/@carried.MaxHp carried forward</span>
                                }
                            </li>
                        }
                    </ul>

                    @if (run.Outcome == RunOutcome.Lost)
                    {
                        <p class="instruction">@RunEnding</p>
                    }
                    else if (run.Outcome == RunOutcome.Won)
                    {
                        <p class="instruction">Run complete — @run.FightsWon fights won.</p>
                    }
                    else if (Runs.AtCamp)
                    {
                        @* A camp follows every won combat node and is not optional: the run cannot
                           move until both picks are in (MASTER_DESIGN §8.5). Naming the next fight
                           here would be naming a node the run has not been offered yet. *@
                        <p class="instruction">
                            Cleared. Camp first — one card each, dealt from your own ducks, and there
                            is no skipping it.
                        </p>
                        <div class="row"><a class="act primary" href="@RunScreens.Camp">Break out the cards</a></div>
                    }
                    else if (Runs.AtVote)
                    {
                        @* The run has left this node and owes a vote before it stands on another one.
                           There is no next fight to name yet — CurrentNode is still the board that was
                           just cleared, because the map does not move until the fork is settled — and
                           entering it again is exactly what Core refuses (D-125). *@
                        <p class="instruction">
                            Cleared. The column ahead has more than one door, and the fork is voted on
                            at the map — in front of both players, masked, once.
                        </p>
                        <div class="row"><a class="act primary" href="@RunScreens.Map">Go and vote</a></div>
                    }
                    else if (CanEnterNext && run.CurrentNode is FightNode nextFight)
                    {
                        <p class="instruction">
                            Next: <strong>@PlaytestFlow.NameOf(nextFight.FightId)</strong>
                        </p>
                        <div class="row">
                            <button type="button" class="act primary" @onclick="ContinueRun">Play the next fight</button>
                            <a class="act" href="@RunScreens.Map">Back to the map</a>
                        </div>
                    }
                    else if (run.CurrentNode is RestNode or MapRestNode)
                    {
                        <p class="instruction">Next: <strong>a rest</strong> — it restores everything that can still be fielded.</p>
                        <div class="row"><a class="act primary" href="@RunScreens.Map">Take the rest</a></div>
                    }
                    else
                    {
                        @* An event, or anything else the road grows later. The band names it and sends
                           the player to the screen that owns it rather than drawing a dead end. *@
                        <p class="instruction">Next: <strong>@(run.CurrentNode?.Describe() ?? "the road on")</strong></p>
                        <div class="row"><a class="act primary" href="@RunScreens.RouteFor(Runs)">Back to the run</a></div>
                    }
                </div>
            }
            else
            {
                <div class="block resolved">
                    <p class="instruction">This run is standing between fights.</p>
                    <div class="row"><a class="act primary" href="@RunScreens.RouteFor(Runs)">Back to the run</a></div>
                </div>
            }
        }
        else if (ShowOutcome)
        {
            <div class="block resolved">
                <p class="outcome @(State.Outcome == FightOutcome.Won ? "won" : "lost")">
                    @(State.Outcome == FightOutcome.Won ? "Fight won." : "Fight lost.")
                </p>
                <p class="instruction">Restart in the header to play it again on the next seed.</p>
            </div>
        }
        else
        {
            @* Persistent, not a toast: while somebody is over the edge it is the most important fact
               on the screen, and it names the deadline rather than implying one (D-083). The units
               that could still get there are listed, because "somebody is dying" without "and you
               can reach them" is only half of what a player needs. *@
            @if (Paddling.Count > 0)
            {
                <div class="block urgent-banner" role="status">
                    @foreach (var line in Paddling)
                    {
                        <p class="urgent-line">@line</p>
                    }

                    <p class="urgent-help">@RescuersLine</p>
                </div>
            }

            @* Said once, in round 1, because that is the only round the state exists in. The strip
               shows the same fact as a gap; this is the sentence version, and between them neither
               player can reach their second activation wondering where the first one went. *@
            @if (Recovering.Count > 0)
            {
                <div class="block bedraggled-banner" role="status">
                    @foreach (var line in Recovering)
                    {
                        <p class="bedraggled-line">@line</p>
                    }
                </div>
            }

            @if (Deploying)
            {
                @* Loud, and before the tile is clicked. A duck that owes its side an activation is a
                   duck you place differently, and agency before injury (D-080) means that cost
                   belongs on screen at the moment of the choice — against the threat overlay, not
                   after it. *@
                @if (BedraggledOnDeck is { Count: > 0 } waiting)
                {
                    <div class="block bedraggled-banner" role="status">
                        @foreach (var unit in waiting)
                        {
                            <p class="bedraggled-line">
                                <strong>@unit.Name</strong> — @PlaytestText.BedraggledLabel(unit)
                            </p>
                        }
                        <p class="bedraggled-help">
                            It is an ordinary unit otherwise: it can be hit, shoved, swept and rescued while it waits.
                        </p>
                    </div>
                }
            }
        }
    </div>
}

@code {
    /// <summary>True when a run owns the board and its fight has already resolved.</summary>
    private bool ShowResolution => Session.InRun && FightIsOver;

    /// <summary>True when a one-off fight has ended and nothing but a restart follows.</summary>
    private bool ShowOutcome =>
        !ShowResolution && ShowBoard && State.Outcome != FightOutcome.InProgress;

    /// <summary>True when there is a live board to say anything about.</summary>
    private bool InPlay => !ShowResolution && !ShowOutcome && ShowBoard;

    private bool Deploying => InPlay && State.Phase == Phase.Deployment;

    private IReadOnlyList<string> Paddling =>
        InPlay ? PlaytestText.ClingingLines(State) : System.Array.Empty<string>();

    private IReadOnlyList<string> Recovering =>
        InPlay ? PlaytestText.BedraggledLines(State) : System.Array.Empty<string>();

    /// <summary>
    /// Whether the band has anything worth a strip of screen. False renders nothing at all — no
    /// wrapper, no padding, no reserved row.
    /// </summary>
    private bool HasContent =>
        ShowResolution
        || ShowOutcome
        || Paddling.Count > 0
        || Recovering.Count > 0
        || (Deploying && BedraggledOnDeck.Count > 0);

    /// <summary>Who could still get to a hanging ally this activation, in Core's own reckoning.</summary>
    private string RescuersLine
    {
        get
        {
            var names = new List<string>();

            foreach (var clinging in State.Units)
            {
                if (!clinging.Clinging || !clinging.IsAlive || !clinging.Team.IsPlayer())
                {
                    continue;
                }

                foreach (var unit in State.Units)
                {
                    if (unit.Team.IsPlayer()
                        && !unit.HasActivated
                        && Pits.CanReachToRescue(State, unit, clinging)
                        && !names.Contains(unit.Name))
                    {
                        names.Add(unit.Name);
                    }
                }
            }

            return names.Count == 0
                ? "Nobody can reach them this round."
                : PlaytestText.Names(names) + " can reach them — highlighted on the board.";
        }
    }

    /// <summary>Every Bedraggled duck still waiting to be placed, so both placements are informed.</summary>
    private IReadOnlyList<Unit> BedraggledOnDeck =>
        State.Units.Where(u => u.Bedraggled && u.IsAlive && u.Team.IsPlayer()).ToList();

    private FightResolved? Resolution => PlaytestFlow.Resolution(Runs);

    /// <summary>
    /// Whether Core would take an <see cref="EnterNodeCommand"/> right now. Read off its own legal
    /// list rather than inferred from the node, because on an act map a cleared node is still
    /// <see cref="RunState.CurrentNode"/> until the fork behind it is voted on — so "there is a fight
    /// node here" and "you may enter it" are different questions, and this band used to ask the wrong
    /// one (D-125).
    /// </summary>
    private bool CanEnterNext => Runs.Legal.Any(c => c is EnterNodeCommand);

    private string RunEnding =>
        Runs.LastEvents.OfType<RunLost>().FirstOrDefault()?.Reason ?? "The run ends here.";

    private void ContinueRun() => Runs.Enter();
}

{
    // Committed on purpose, like .claude/hooks — these are the project's tasks, not one machine's.
    // Everything runs in the integrated terminal, so build output and the server's own logs land
    // where you can read and click them. See README.md "Running it from VS Code" for keybindings.
    "version": "2.0.0",

    // Windows PowerShell, named rather than inherited: the default integrated shell varies per
    // machine, and these all call .ps1 scripts.
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
            }
        }
    },

    "tasks": [
        {
            // The one to bind a key to. play.ps1 finds its own free port, so running this while an
            // old server is still up gives you a second working server rather than an error.
            // Ctrl-C in its terminal stops it.
            "label": "Faultline: run",
            "detail": "Start the app on the first free port and open a browser at it",
            "type": "shell",
            "command": "./play.ps1",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "revealProblems": "onProblem",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        },
        {
            "label": "Faultline: run with hot reload",
            "detail": "dotnet watch on port 5199 — edits to .razor reload without a restart",
            "type": "shell",
            "command": "./run.ps1 -Watch -Open",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        },
        {
            // Ctrl-Shift-B.
            "label": "Faultline: build",
            "detail": "dotnet build — warnings are errors in Core",
            "type": "shell",
            "command": "dotnet build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        },
        {
            "label": "Faultline: test",
            "detail": "dotnet test — the whole suite, Core and Web",
            "type": "shell",
            "command": "dotnet test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        },
        {
            "label": "Faultline: test Core only",
            "detail": "dotnet test on Faultline.Core.Tests — the fast one",
            "type": "shell",
            "command": "dotnet test tests/Faultline.Core.Tests",
            "group": "test",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        },
        {
            // The fix for README's "unhandled error on a page that worked a minute ago": an orphaned
            // server still serving its own old build.
            //
            // IT MUST COVER 5137. That is the port launchSettings.json names, so it is the port F5
            // and Ctrl-F5 use — and this task swept only 5199-5210, the range play.ps1 walks. The
            // one server a player is most likely to leave running was the one server this could not
            // stop, while launch.json's own comment sent them here to stop it. That failure looks
            // exactly like a code bug: the browser holds a boot manifest naming fingerprinted assets
            // ("dotnet.<hash>.js") that the newer build no longer has, and every one of them 404s.
            "label": "Faultline: stop servers",
            "detail": "Stop anything left listening on 5137 (F5) or 5199-5210 (play.ps1)",
            "type": "shell",
            "command": "@(5137) + 5199..5210 | ForEach-Object { ./run.ps1 -Stop -Port $_ }",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "faultline",
                "clear": true,
                "focus": false,
                "showReuseMessage": false
            }
        }
    ]
}

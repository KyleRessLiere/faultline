<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The double-clickable half of a shareable build. Published self-contained and single-file, so the
    folder it lands in needs nothing installed: the .NET runtime the game needs travels inside the
    executable. See tools/make-shareable.cmd, which is what actually builds a copy to hand somebody.

    Deliberately a plain console app over HttpListener rather than an ASP.NET host. A Blazor
    WebAssembly app is static files that need any web server at all, and the base runtime already
    has one — pulling in ASP.NET would triple the download to serve a folder.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Faultline</AssemblyName>
    <RootNamespace>Faultline.Launcher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>

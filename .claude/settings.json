{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/check-gameplay-doc.sh ] && bash .claude/hooks/check-gameplay-doc.sh || true",
            "timeout": 15,
            "statusMessage": "Checking GAMEPLAY.md is in sync with the rules..."
          }
        ]
      }
    ]
  }
}

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/guard-branch.sh ] && bash .claude/hooks/guard-branch.sh || true",
            "timeout": 15,
            "statusMessage": "Checking branch..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f .claude/hooks/check-gameplay-doc.sh ] && bash .claude/hooks/check-gameplay-doc.sh || true",
            "timeout": 15,
            "statusMessage": "Checking GAMEPLAY.md is in sync with the rules..."
          },
          {
            "type": "command",
            "command": "[ -f .claude/hooks/check-unpushed.sh ] && bash .claude/hooks/check-unpushed.sh || true",
            "timeout": 15,
            "statusMessage": "Checking for unpushed commits..."
          }
        ]
      }
    ]
  }
}

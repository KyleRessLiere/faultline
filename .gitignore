# Build results
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
artifacts/
publish/

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code — personal settings stay out, the project's tasks are committed like .claude/hooks.
# The directory itself is not excluded: git cannot re-include a file inside an excluded directory,
# so the contents are ignored instead and tasks.json is named back in.
.vscode/*
!.vscode/tasks.json
!.vscode/launch.json

# Test results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coverlet.json
coverage*.json
coverage*.xml
coverage*.info
TestResults/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# Blazor WASM / web build output
wwwroot/dist/
node_modules/

# MSBuild / misc
*.binlog
*.pidb
*.svclog
*.scc
*.tlog
*.log

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Run recordings are not build logs. A command log plus its seed replays a whole campaign, and a
# hand-played one is authored decisions that nothing can regenerate, so they outrank the *.log rule.
!docs/playtest/logs/*.log

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faultline.Core\Faultline.Core.csproj" />
  </ItemGroup>

  <!-- The text harness's renderer, compiled in rather than referenced. It is the surface a reader
       actually decides from, and three of its annotations were found contradicting resolution in the
       field, so its claims need pinning like any other rule text. The harness is an Exe with no other
       dependency in this file, so linking it tests exactly the code a session reads. -->
  <ItemGroup>
    <Compile Include="..\..\tools\Faultline.Playtest\View.cs" Link="Linked\View.cs" />
  </ItemGroup>

</Project>
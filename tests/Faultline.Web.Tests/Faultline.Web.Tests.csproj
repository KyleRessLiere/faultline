<Project Sdk="Microsoft.NET.Sdk">

  <!-- The run's rules live in Core and are tested there. What is left in the shell is a save format
       and the picker's grouping, and both need the same treatment as a rule: a named test per claim.
       Referencing the Blazor project is enough; nothing here touches a component or a real browser
       — localStorage is faked at the IJSRuntime boundary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faultline.Web\Faultline.Web.csproj" />
  </ItemGroup>

  <!-- The session-log endpoint, compiled in rather than referenced. It lives in the launcher, which
       is a self-contained single-file executable and is not in the solution; a ProjectReference would
       drag those publish properties into this test build for one static class. The file has no
       dependency beyond System.IO, so linking it tests exactly the code the launcher runs. -->
  <ItemGroup>
    <Compile Include="..\..\tools\Faultline.Launcher\PlaytestLogEndpoint.cs"
             Link="Linked\PlaytestLogEndpoint.cs" />
  </ItemGroup>

</Project>

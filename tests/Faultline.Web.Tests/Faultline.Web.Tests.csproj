<Project Sdk="Microsoft.NET.Sdk">

  <!-- The shell has one piece of real logic — carrying a campaign run's dead between fights — and
       it needs the same treatment as a rule: a named test per claim. Referencing the Blazor project
       is enough; nothing here touches a component or the browser. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faultline.Web\Faultline.Web.csproj" />
  </ItemGroup>

</Project>

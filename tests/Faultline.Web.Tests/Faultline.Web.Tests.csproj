<Project Sdk="Microsoft.NET.Sdk">

  <!-- The run's rules live in Core and are tested there. What is left in the shell is a save format
       and the picker's grouping, and both need the same treatment as a rule: a named test per claim.
       Referencing the Blazor project is enough; nothing here touches a component or a real browser
       — localStorage is faked at the IJSRuntime boundary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Faultline.Web\Faultline.Web.csproj" />
  </ItemGroup>

</Project>

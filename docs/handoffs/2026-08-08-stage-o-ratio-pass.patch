+    /// <summary>
+    /// <b>§6's double-kill teach: a bare collision ends a Husk outright.</b> This is the reason unit
+    /// collision moved from 4 to 6 in the Ratio Pass — enemy HP went to 1.5x and a Husk reached 6,
+    /// so a 4 would have quietly killed the teach that makes the board read as an answer rather than
+    /// a slower sword. Pinned from the two rules, never from the literals, so the next time either
+    /// number moves this fails instead of going stale.
+    /// </summary>
+    [Fact]
+    public void ABareCollision_StillEndsAHuskOutright_WhichIsWhyCollisionMovedWithEnemyHp()
+    {
+        int husk = UnitTemplate.For(UnitKind.Husk).MaxHp;
+
+        Assert.True(
+            Displacement.CollisionDamage >= husk,
+            $"collision {Displacement.CollisionDamage} no longer ends a Husk at {husk} - "
+            + "the double-kill teach is dead");
+
+        // And the gap the Ratio Pass widened on purpose: the board is worth 3x the sword, not 2x.
+        Assert.Equal(2, UnitTemplate.For(UnitKind.Vanguard).Damage);
+        Assert.Equal(3, Displacement.CollisionDamage / UnitTemplate.For(UnitKind.Vanguard).Damage);
+    }
+
+    /// <summary>
+    /// <b>The 24-vs-42 spread is deliberate and must not be flattened.</b> A flat pool was considered
+    /// and rejected: the spread is what makes the Archer's minimum range a real tax and the
+    /// Wardbearer a rock in the stream (§3, locked ab).
+    /// </summary>
+    [Fact]
+    public void ThePlayerHpSpread_IsThreeToOneAgainstTheSquishies_NotAFlatPool()
+    {
+        Assert.Equal(24, UnitTemplate.For(UnitKind.Archer).MaxHp);
+        Assert.Equal(24, UnitTemplate.For(UnitKind.Threadcaster).MaxHp);
+        Assert.Equal(42, UnitTemplate.For(UnitKind.Vanguard).MaxHp);
+        Assert.Equal(42, UnitTemplate.For(UnitKind.Wardbearer).MaxHp);
+
+        // An Archer survives three collisions and dies to the fourth; at 8 she died to two.
+        Assert.True(24 > Displacement.CollisionDamage * 3);
+        Assert.True(24 <= Displacement.CollisionDamage * 4);
+    }
